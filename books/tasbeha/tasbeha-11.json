","cop_lat":"je Pesheeri aleethos:","en":"for truly your Son,","ar":"لأن إبنك بالحقيقة،"}},{"id":"t817-43","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲁϥⲧⲱⲛϥ.","cop_lat":"Ieesous Pi-ekhristos aftonf.","en":"Jesus Christ rose.","ar":"يسوع المسيح قام."}},{"id":"t817-44","text":{"cop":"+ Ⲙⲁⲣⲉⲛⲑⲉⲗⲏⲗ ⲙ̀ⲫⲟⲟⲩ:","cop_lat":"+ Marentheleel emfoou:","en":"+ Today let us rejoice,","ar":"+ فلنتهلل اليوم،"}},{"id":"t817-45","text":{"cop":"ⲟⲩⲟϩ ⲛ̀ⲧⲉⲛⲟⲩⲛⲟϥ:","cop_lat":"o-woh entenounof:","en":"and be glad,","ar":"ونفرح،"}},{"id":"t817-46","text":{"cop":"ϫⲉ Ⲡ̀ⲟⲩⲣⲟ ⲛ̀ⲧⲉ ⲛⲓⲟⲩⲣⲱⲟⲩ:","cop_lat":"je Epouro ente niouroou:","en":"because the King of kings,","ar":"لأن ملك الملوك،"}},{"id":"t817-47","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲁϥⲧⲱⲛϥ.","cop_lat":"Ieesous Pi-ekhristos aftonf.","en":"Jesus Christ rose.","ar":"يسوع المسيح قام."}},{"id":"t817-48","text":{"cop":"Ⲛⲉⲙ Ⲗⲟⲩⲕⲁⲥ ⲡⲓⲥⲟⲫⲟⲥ:","cop_lat":"Nem Loukas pisofos:","en":"Luke the wise,","ar":"لوقا الحكيم،"}},{"id":"t817-49","text":{"cop":"ⲛⲉⲙ Ⲓⲱⲁⲛⲛⲏⲥ ⲡⲉϥⲙⲉⲛⲣⲓⲧ:","cop_lat":"nem Yoannees pefmenrit:","en":"and John His beloved,","ar":"ويوحنا حبيبه،"}},{"id":"t817-50","text":{"cop":"ⲁⲩϩⲓⲱⲓϣ ⲛ̀ⲕⲁⲗⲱⲥ:","cop_lat":"avhioish enkalos:","en":"truly have preached,","ar":"يبشرون جيداً،"}},{"id":"t817-51","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲁϥⲧⲱⲛϥ.","cop_lat":"Ieesous Pi-ekhristos aftonf.","en":"Jesus Christ rose.","ar":"يسوع المسيح قام."}},{"id":"t817-52","text":{"cop":"Ⲝⲙⲁⲣⲱⲟⲩⲧ ⲱ̀ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ:","cop_lat":"Ksmaroout o Pi-ekhristos:","en":"Blessed are You O Christ,","ar":"مبارك أنت أيها المسيح،"}},{"id":"t817-53","text":{"cop":"Ⲡⲓⲟⲩⲱⲓⲛⲓ ⲛ̀ⲁⲧϣ̀ϧⲉⲧϧⲱⲧϥ:","cop_lat":"Piowoini enateshkhetkhotf:","en":"the unquenchable Light,","ar":"النور غير المفحوص،"}},{"id":"t817-54","text":{"cop":"ⲁ̀ⲙⲱⲓⲛⲓ ⲙⲁⲣⲉⲛϩⲱⲥ ⲉ̀ⲣⲟϥ:","cop_lat":"amoini marenhos erof:","en":"come let us praise Him,","ar":"هلموا فلنُسبحه،"}},{"id":"t817-55","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲁϥⲧⲱⲛϥ.","cop_lat":"Ieesous Pi-ekhristos aftonf.","en":"Jesus Christ rose.","ar":"يسوع المسيح قام."}},{"id":"t817-56","text":{"cop":"+ Ⲟⲩⲟϩ ⲁϥⲥⲱϯ ⲙ̀ⲡⲉϥⲗⲁⲟⲥ:","cop_lat":"+ O-woh afsoti empeflaos:","en":"+ He has saved His people,","ar":"+ وخلَّص شعبه،"}},{"id":"t817-57","text":{"cop":"ⲛ̀ϩ̀ⲣⲏⲓ ϧⲉⲛ ⲡⲉϥϣⲱⲃϣ:","cop_lat":"enehree khen pefshovsh:","en":"with His arm,","ar":"من إبليس،"}},{"id":"t817-58","text":{"cop":"ⲉ̀ⲃⲟⲗ ϧⲉⲛ Ⲡⲓⲇⲓⲁⲃⲟⲗⲟⲥ:","cop_lat":"evol khen Pithiavolos:","en":"from the Devil,","ar":"بذراعه،"}},{"id":"t817-59","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲁϥⲧⲱⲛϥ.","cop_lat":"Ieesous Pi-ekhristos aftonf.","en":"Jesus Christ rose.","ar":"يسوع المسيح قام."}},{"id":"t817-60","text":{"cop":"+ Ⲡⲓϩⲓⲏⲃ ⲙ̀ⲙⲏⲓ:","cop_lat":"+ Pihieeb emmee:","en":"+ The true Lamb,","ar":"+ بالحقيقة نسبح،"}},{"id":"t817-61","text":{"cop":"ⲙⲁⲣⲉⲛϩⲱⲥ ⲉ̀ⲣⲟϥ:","cop_lat":"marenhos erof:","en":"let us praise Him,","ar":"إلهنا،"}},{"id":"t817-62","text":{"cop":"Ⲡⲉⲛⲛⲟⲩϯ ⲛ̀ⲧⲁⲫ̀ⲙⲏⲓ:","cop_lat":"Pennoti enta-efmee:","en":"our true God,","ar":"الحمل الحقيقي،"}},{"id":"t817-63","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲁϥⲧⲱⲛϥ.","cop_lat":"Ieesous Pi-ekhristos aftonf.","en":"Jesus Christ rose.","ar":"يسوع المسيح قام."}},{"id":"t817-64","text":{"cop":"Ⲣⲱⲓⲥ ⲉ̀ⲣⲟⲛ ⲱ̀ Ⲡⲉⲛⲛⲟⲩϯ:","cop_lat":"Rois eron o Pennoti:","en":"Guard us O our God,","ar":"إحرسنا يا إلهنا،"}},{"id":"t817-65","text":{"cop":"ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲡⲓⲭ̀ⲣⲟϥ:","cop_lat":"evol khen pi-ekrof:","en":"from malice,","ar":"من الغش،"}},{"id":"t817-66","text":{"cop":"Ⲡⲉⲛⲛⲏⲃ Ⲡ̀ϣⲏⲣⲓ ⲙ̀Ⲫ̀ⲛⲟⲩϯ:","cop_lat":"Penneeb Epsheeri emefnoti:","en":"O our Master the Son of God,","ar":"يا سيدنا إبن الله،"}},{"id":"t817-67","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲁϥⲧⲱⲛϥ.","cop_lat":"Ieesous Pi-ekhristos aftonf.","en":"Jesus Christ rose.","ar":"يسوع المسيح قام."}},{"id":"t817-68","text":{"cop":"Ⲥⲓⲱⲛ ⲛⲉⲙ Ⲓⲉⲣⲟⲥⲁⲗⲏⲙ:","cop_lat":"Sion nem Yerosaleem:","en":"Zion and Jerusalem,","ar":"صهيون وأورُشَليم،"}},{"id":"t817-69","text":{"cop":"ⲙ̀ⲫⲟⲟⲩ ⲉⲩⲉ̀ⲟⲩⲛⲟϥ:","cop_lat":"emfoou eveounof:","en":"rejoice today,","ar":"اليوم تفرحان،"}},{"id":"t817-70","text":{"cop":"ⲛⲉⲙ ⲡ̀ⲕⲁϩⲓ ⲛ̀Ⲉⲫⲑⲁⲗⲓⲙ:","cop_lat":"nem epkahi enefthalim:","en":"with the land of Naphtali,","ar":"مع أرض نفتاليم،"}},{"id":"t817-71","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲁϥⲧⲱⲛϥ.","cop_lat":"Ieesous Pi-ekhristos aftonf.","en":"Jesus Christ rose.","ar":"يسوع المسيح قام."}},{"id":"t817-72","text":{"cop":"+ Ⲧⲉⲛϩⲱⲥ ⲧⲉⲛⲥ̀ⲙⲟⲩ ⲉ̀ⲣⲟϥ:","cop_lat":"+ Tenhos tenesmou erof:","en":"+ We praise and bless Him,","ar":"+ نُسبحه ونُباركه،"}},{"id":"t817-73","text":{"cop":"ⲧⲉⲛϣⲉⲙϣⲓ ⲙ̀ⲙⲟϥ:","cop_lat":"tenshemshi emmof:","en":"and serve Him,","ar":"ونخدمه،"}},{"id":"t817-74","text":{"cop":"ⲟⲩⲟϩ ⲧⲉⲛⲟⲩⲱϣⲧ ⲙ̀ⲙⲟϥ:","cop_lat":"o-woh tenowosht emmof:","en":"and worship Him,","ar":"ونسجد له،"}},{"id":"t817-75","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲁϥⲧⲱⲛϥ.","cop_lat":"Ieesous Pi-ekhristos aftonf.","en":"Jesus Christ rose.","ar":"يسوع المسيح قام."}},{"id":"t817-76","text":{"cop":"+ Ⲩ̀ⲓⲟⲥ Ⲑⲉⲟⲥ Ⲡⲉⲛⲟⲩⲣⲟ:","cop_lat":"+ I-ios Theos Penouro:","en":"+ The Son of God our King,","ar":"+ إبن الله ملكنا،"}},{"id":"t817-77","text":{"cop":"ⲁϥⲙⲟⲩ ⲟⲩⲟϩ ⲁⲩⲕⲟⲥϥ:","cop_lat":"afmou o-woh avkosf:","en":"died and was buried,","ar":"مات ودُفن،"}},{"id":"t817-78","text":{"cop":"ⲙⲉⲛⲉⲛⲥⲁ ϣⲟⲙⲧ ⲛ̀ⲉ̀ϩⲟⲟⲩ:","cop_lat":"menensa shomt enehoou:","en":"and after three days,","ar":"وبعد ثلاثة أيام،"}},{"id":"t817-79","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲁϥⲧⲱⲛϥ.","cop_lat":"Ieesous Pi-ekhristos aftonf.","en":"Jesus Christ rose.","ar":"يسوع المسيح قام."}},{"id":"t817-80","text":{"cop":"Ⲫⲁⲓ ⲡⲉ ⲡⲓⲉ̀ϩⲟⲟⲩ:","cop_lat":"Fai pe pi-ehoou:","en":"This is the day,","ar":"هذا هو اليوم،"}},{"id":"t817-81","text":{"cop":"ⲉ̀ⲧⲁ Ⲡ̀ϭⲟⲓⲥ ⲑⲁⲙⲓⲟϥ:","cop_lat":"eta Epshois thamiof:","en":"the Lord has made,","ar":"الذي صنعه الرب،"}},{"id":"t817-82","text":{"cop":"ⲙⲁⲣⲉⲛⲑⲉⲗⲏⲗ ⲙ̀ⲫⲟⲟⲩ:","cop_lat":"marentheleel emfoou:","en":"let us rejoice today,","ar":"فلنتهلل اليوم،"}},{"id":"t817-83","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲁϥⲧⲱⲛϥ.","cop_lat":"Ieesous Pi-ekhristos aftonf.","en":"Jesus Christ rose.","ar":"يسوع المسيح قام."}},{"id":"t817-84","text":{"cop":"Ⲭⲉⲣⲉ Ϯⲁ̀ⲛⲁⲥⲧⲁⲥⲓⲥ:","cop_lat":"Shere Ti-anastasis:","en":"Hail to the Resurrection,","ar":"السلام للقيامة،"}},{"id":"t817-85","text":{"cop":"ⲛⲉⲙ ⲡⲓⲙ̀ϩⲁⲩ ⲛⲉⲙ ⲡⲓⲥ̀ⲛⲟϥ:","cop_lat":"nem pi-emhav nem pi-esnof:","en":"and the tomb and the blood,","ar":"والقبر والدم،"}},{"id":"t817-86","text":{"cop":"ⲉ̀ⲧⲁϥⲫⲟⲛϥ ⲛ̀ϫⲉ ⲡⲓⲙⲟⲛⲟⲅⲉⲛⲏⲥ:","cop_lat":"etaffonf enje pimonogenees:","en":"which the only-begotten shed,","ar":"الذي سفكه الوحيد،"}},{"id":"t817-87","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲁϥⲧⲱⲛϥ.","cop_lat":"Ieesous Pi-ekhristos aftonf.","en":"Jesus Christ rose.","ar":"يسوع المسيح قام."}},{"id":"t817-88","text":{"cop":"+ Ⲯⲩⲭⲏ ⲙⲁⲙ̀ⲧⲟⲛ ⲛⲱⲟⲩ:","cop_lat":"+ Psishee ma-emton noou:","en":"+ Repose all the souls,","ar":"+ النفوس نيحها،"}},{"id":"t817-89","text":{"cop":"ϧⲉⲛ ⲫ̀ⲙⲁ ⲛ̀ϣⲱⲡⲓ ⲛ̀ⲧⲉ ⲡ̀ⲟⲩⲛⲟϥ:","cop_lat":"khen efma enshopi ente epounof:","en":"in the dwelling of joy,","ar":"في مسكن الفرح،"}},{"id":"t817-90","text":{"cop":"ⲉⲑⲃⲉ Ⲧⲉⲕⲙⲁⲩ ϯⲟⲩⲣⲱ:","cop_lat":"ethve Tekmav tiouro:","en":"for the sake of Your Mother the Queen,","ar":"من أجل امك الملكة،"}},{"id":"t817-91","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲁϥⲧⲱⲛϥ.","cop_lat":"Ieesous Pi-ekhristos aftonf.","en":"Jesus Christ rose.","ar":"يسوع المسيح قام."}},{"id":"t817-92","text":{"cop":"+ Ⲱ̀ ⲫⲏⲉ̀ⲧⲁϥϭⲓⲙ̀ⲕⲁϩ:","cop_lat":"+ O fee-etafchi-emkah:","en":"+ O who has suffered,","ar":"+ يا مَنْ تألم،"}},{"id":"t817-93","text":{"cop":"ⲟⲩⲟϩ ⲡⲓⲙⲟⲩ ⲁϥⲕⲟⲣϥ:","cop_lat":"o-woh pimou afkorf:","en":"and trampled death have mercy,","ar":"وأبطل الموت،"}},{"id":"t817-94","text":{"cop":"ⲛⲁⲓ ⲛⲁⲛ ⲱ̀ Ⲡⲓⲟⲩⲣⲟ ⲛ̀ⲉ̀ⲛⲉϩ:","cop_lat":"nai nan o Piouro eneneh:","en":"upon us O King of the ages,","ar":"إرحمنا يا ملك الدهور،"}},{"id":"t817-95","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲁϥⲧⲱⲛϥ.","cop_lat":"Ieesous Pi-ekhristos aftonf.","en":"Jesus Christ rose.","ar":"يسوع المسيح قام."}}]}