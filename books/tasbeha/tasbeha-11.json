sali, Ⲁ̀ⲣⲓⲯⲁⲗⲓⲛ ⲙ̀ⲫⲟⲟⲩ","path":"Feasts › Festive Days › Resurrection Day to the 39th Day › Midnight Praises"}},{"id":"t817-1","text":{"cop":"ϧⲉⲛ ⲟⲩⲥ̀ⲙⲏ ⲛ̀ⲟⲩⲛⲟϥ:","cop_lat":"khen ou-esmee enounof:","en":"with a voice of joy,","ar":"بصوت الفرح،"}},{"id":"t817-2","text":{"cop":"ϫⲉ Ⲡ̀ⲟⲩⲣⲟ ⲛ̀ⲧⲉ ⲡ̀ⲱ̀ⲟⲩ:","cop_lat":"je Epouro ente epoou:","en":"for the King of glory,","ar":"لأن ملك المجد،"}},{"id":"t817-3","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲁϥⲧⲱⲛϥ.","cop_lat":"Ieesous Pi-ekhristos aftonf.","en":"Jesus Christ rose.","ar":"يسوع المسيح قام."}},{"id":"t817-4","text":{"cop":"Ⲃⲟⲛ ⲛⲓⲃⲉⲛ ⲥⲉϩⲱⲥ:","cop_lat":"Von niven sehos:","en":"Everyone praises,","ar":"كُل واحد يُسبح،"}},{"id":"t817-5","text":{"cop":"ϧⲉⲛ ⲟⲩⲥ̀ⲙⲏ ⲛ̀ⲁⲧⲭⲁⲣⲱⲥ:","cop_lat":"khen ou-esmee enatkaros:","en":"with an incessant voice,","ar":"بصوت غير ساكت،"}},{"id":"t817-6","text":{"cop":"ϫⲉ Ⲫ̀ⲛⲟⲩϯ Ⲡⲓⲗⲟⲅⲟⲥ:","cop_lat":"je Efnoti Piloghos:","en":"for God the Word,","ar":"لأن الله الكلمة،"}},{"id":"t817-7","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲁϥⲧⲱⲛϥ.","cop_lat":"Ieesous Pi-ekhristos aftonf.","en":"Jesus Christ rose.","ar":"يسوع المسيح قام."}},{"id":"t817-8","text":{"cop":"+ Ⲅⲉ ⲅⲁⲣ ⲛ̀ⲑⲟϥ ⲡⲉ Ⲡⲉⲛⲛⲟⲩϯ:","cop_lat":"+ Ge ghar enthof pe Pennoti:","en":"+ For He is our God,","ar":"+ لأنه هو إلهنا،"}},{"id":"t817-9","text":{"cop":"ⲁ̀ⲙⲱⲓⲛⲓ ⲙⲁⲣⲉⲛⲟⲩⲱϣⲧ ⲙ̀ⲙⲟϥ:","cop_lat":"amoini marenowosht emmof:","en":"come let us worship Him,","ar":"حمل الله،"}},{"id":"t817-10","text":{"cop":"Ⲡⲓϩⲓⲏⲃ ⲛ̀ⲧⲉ Ⲫ̀ⲛⲟⲩϯ:","cop_lat":"Pihieeb ente Efnoti:","en":"the Lamb of God,","ar":"هلموا نسجد له لأن،"}},{"id":"t817-11","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲁϥⲧⲱⲛϥ.","cop_lat":"Ieesous Pi-ekhristos aftonf.","en":"Jesus Christ rose.","ar":"يسوع المسيح قام."}},{"id":"t817-12","text":{"cop":"+ Ⲇⲉⲥⲡⲟⲧⲁ ⲁϥⲙⲟⲩ:","cop_lat":"+ Thespota afmou:","en":"+ The Master died in the flesh,","ar":"+ السيد مات،"}},{"id":"t817-13","text":{"cop":"ϧⲉⲛ ⲧ̀ⲥⲁⲣⲝ ⲟⲩⲟϩ ⲁⲩⲕⲟⲥϥ:","cop_lat":"khen etsarks o-woh avkosf:","en":"and was buried,","ar":"بالجسد ودُفن،"}},{"id":"t817-14","text":{"cop":"ϧⲉⲛ ⲡⲓⲙⲁϩϣⲟⲙⲧ ⲛ̀ⲉ̀ϩⲟⲟⲩ:",