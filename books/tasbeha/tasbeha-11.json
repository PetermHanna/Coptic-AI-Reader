{"title":"Feasts › Festive Days","source":"tasbeha.org hymn library","languages":{"en":"English","cop":"Ⲙⲉⲧⲣⲉⲙⲛ̀ⲭⲏⲙⲓ","cop_lat":"Coptic (Latin letters)","ar":"عربي"},"roles":{"priest":{"en":"Priest","de":"Priester","ar":"الكاهن","cop":"Ⲡⲓⲟⲩⲏⲃ"},"deacon":{"en":"Deacon","de":"Diakon","ar":"الشماس","cop":"Ⲡⲓⲇⲓⲁⲕⲱⲛ"},"people":{"en":"People","de":"Gemeinde","ar":"الشعب","cop":"Ⲡⲓⲗⲁⲟⲥ"}},"paragraphs":[{"id":"t181-0","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲡ̀ϣⲏⲣⲓ ⲙ̀Ⲫϯ :","cop_lat":"Ieesous Pi-ekhristos epsheeri emefnoti :","en":"(Rotated through"},"section":{"en":"Psalm 150 Refrains, Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅","path":"Feasts › Festive Days › 29th of Every Coptic Month"}},{"id":"t181-1","text":{"cop":"ⲁϥϭⲓⲥⲁⲣⲝ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ϯⲡⲁⲣⲑⲉⲛⲟⲥ.","cop_lat":"afchisarks evol khen tiparthenos.","en":"each verse):"}},{"id":"t181-2","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲡ̀ϣⲏⲣⲓ ⲙ̀Ⲫϯ ⲫⲏⲉⲧⲁⲩⲙⲁⲥϥ ϧⲉⲛ Ⲃⲏⲉⲑⲗⲉⲉⲙ.","cop_lat":"Ieesous Pi-ekhristos epsheeri emefnoti fee-etavmasf khen Vee-ethle-em.","en":"Jesus Christ, the Son of God, was incarnate of the Virgin."}},{"id":"t181-3","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ ⲡ̀ⲟⲩⲣⲟ ⲛ̀ⲧⲉ ⲡ̀ⲱ̀ⲟⲩ ⲁϥⲧⲱⲛϥ ⲉ̀ⲃⲟⲗϧⲉⲛ ⲛⲏⲉⲑⲙⲱⲟⲩⲧ.","cop_lat":"Ieesous Pi-ekhristos epouro ente epoou aftonf evolkhen nee-ethmoout.","en":"Jesus Christ, the Son of God, was born in Bethlehem."}},{"id":"t833-0","text":{"cop":"Ⲁ̀ⲣⲓⲯⲁⲗⲓⲛ ⲕⲁⲗⲱⲥ:","cop_lat":"Aripsalin kalos:","en":"Sing justly,","ar":"رتلوا حسناً،"},"section":{"en":"Adam Psali, Ⲁ̀ⲣⲓⲯⲁⲗⲓⲛ ⲕⲁⲗⲱⲥ","path":"Feasts › Festive Days › Days between the Feasts of the Ascension and Pentecost"}},{"id":"t833-1","text":{"cop":"ϧⲉⲛ ϩⲁⲛⲇⲟⲝⲟⲗⲟⲅⲓⲁ:","cop_lat":"khen hanthoksologia:","en":"with doxologies,","ar":"بتماجيد،"}},{"id":"t833-2","text":{"cop":"ⲛ̀Ⲓⲏⲥⲟⲩⲥ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ:","cop_lat":"enieesous Pi-ekhristos:","en":"to Jesus Christ,","ar":"ليسوع المسيح،"}},{"id":"t833-3","text":{"cop":"ⲫⲁ ϯⲉⲝⲟⲩⲥⲓⲁ.","cop_lat":"fa tieksousia.","en":"who is of authority.","ar":"ذي السلطان."}},{"id":"t833-4","text":{"cop":"Ⲃⲟⲛ ⲛⲓⲃⲉⲛ ⲥⲉ ϩⲱⲥ:","cop_lat":"Von niven se hos:","en":"Everyone praises,","ar":"الجميع يسبحون،"}},{"id":"t833-5","text":{"cop":"ⲉ̀Ⲡⲓⲁⲧϣ̀ⲧⲁϩⲟϥ:","cop_lat":"epiateshtahof:","en":"the Incomprehensible,","ar":"الغير المُدرَك،"}},{"id":"t833-6","text":{"cop":"Ⲡⲉⲛⲥⲱⲧⲏⲣ Ⲓⲏⲥⲟⲩⲥ:","cop_lat":"Pensoteer Ieesous:","en":"and the Invisible,","ar":"مخلِّصنا يسوع،"}},{"id":"t833-7","text":{"cop":"Ⲡⲓⲁⲑⲛⲁⲩ ⲉ̀ⲣⲟϥ.","cop_lat":"Piathnav erof.","en":"our Savior Jesus.","ar":"الغير المرئي."}},{"id":"t833-8","text":{"cop":"+ Ⲅⲉ ⲅⲁⲣ ⲇⲓⲕⲉⲟⲛ:","cop_lat":"+ Ge ghar thikeon:","en":"+ For truly indeed,","ar":"+ لأنه حقاً،"}},{"id":"t833-9","text":{"cop":"ⲙ̀ⲫ̀ⲣⲏϯ ⲙ̀ⲡⲁⲓⲉ̀ϩⲟⲟⲩ:","cop_lat":"emefreeti empai-ehoou:","en":"on this day,","ar":"في مِثل هذا اليوم،"}},{"id":"t833-10","text":{"cop":"ⲁϥϣⲉⲛⲁϥ ⲉ̀ⲟⲩⲣⲁⲛⲟⲥ:","cop_lat":"afshenaf eouranos:","en":"the King of glory,","ar":"صعد إلى السماء،"}},{"id":"t833-11","text":{"cop":"ⲛ̀ϫⲉ Ⲡ̀ⲟⲩⲣⲟ ⲛ̀ⲧⲉ ⲡ̀ⲱ̀ⲟⲩ.","cop_lat":"enje Epouro ente epoou.","en":"ascended into the heavens.","ar":"ملك المجد."}},{"id":"t833-12","text":{"cop":"+ Ⲇⲁⲩⲓⲇ ⲅⲁⲣ ⲁϥϫⲟⲥ:","cop_lat":"+ David ghar afgos:","en":"+ For David has said,","ar":"+ قال داود،"}},{"id":"t833-13","text":{"cop":"ϧⲉⲛ ⲟⲩⲥ̀ⲙⲏ ⲛ̀ⲥⲁⲗⲡⲓⲅⲅⲟⲥ:","cop_lat":"khen ou-esmee ensalpinghos:","en":"with the voice of the trumpet,","ar":"بصوت البوق،"}},{"id":"t833-14","text":{"cop":"ⲁ̀ⲣⲓⲯⲁⲗⲓⲛ ⲉ̀Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ:","cop_lat":"aripsalin epi-ekhristos:","en":"“Sing to Christ,","ar":"\"رتلوا للمسيح،"}},{"id":"t833-15","text":{"cop":"ϧⲉⲛ ϩⲁⲛϩⲩⲙⲛⲟⲥ.","cop_lat":"khen hanhimnos.","en":"with hymns.”","ar":"بتسابيح.\""}},{"id":"t833-16","text":{"cop":"Ⲉⲑⲃⲉ ⲛⲓⲙⲩⲥⲧⲏⲣⲓⲟⲛ:","cop_lat":"Ethve nimisteerion:","en":"Because of the mysteries,","ar":"من أجل الأسرار،"}},{"id":"t833-17","text":{"cop":"ⲉ̀ⲧⲁϥⲓ̀ⲣⲓ ⲙ̀ⲙⲱⲟⲩ:","cop_lat":"etafiri emmoou:","en":"the King of the ages,","ar":"التي صنعها،"}},{"id":"t833-18","text":{"cop":"ⲛ̀ϫⲉ Ⲡ̀ⲟⲩⲣⲟ ⲛ̀ⲛⲓⲉ̀ⲱⲛ:","cop_lat":"enje Epouro enni-eon:","en":"has performed,","ar":"ملك الدهور،"}},{"id":"t833-19","text":{"cop":"ⲁϥⲥⲁϫⲓ ⲛⲉⲙⲱⲟⲩ.","cop_lat":"afsaji nemoou.","en":"He also spoke to them.","ar":"تكلم أيضاً معهم."}},{"id":"t833-20","text":{"cop":"Ⲍⲉⲱϣ ⲡⲓⲙⲟⲛⲟⲅⲉⲛⲏⲥ:","cop_lat":"Zeosh pimonogenees:","en":"The Only-Begotten,","ar":"كثيراً ما تكلم،"}},{"id":"t833-21","text":{"cop":"ⲁϥⲥⲁϫⲓ ⲛⲉⲙ ⲛⲉϥⲁ̀ⲡⲟⲥⲧⲟⲗⲟⲥ:","cop_lat":"afsaji nem nefapostolos:","en":"said many things,","ar":"الإبن الوحيد الجنس،"}},{"id":"t833-22","text":{"cop":"ⲙⲉⲛⲉⲛⲥⲁ Ϯⲁ̀ⲛⲁⲥⲧⲁⲥⲓⲥ:","cop_lat":"menensa Ti-anastasis:","en":"to His Apostles,","ar":"مع رسله،"}},{"id":"t833-23","text":{"cop":"ⲉϥϫⲱ ⲙ̀ⲙⲟⲥ.","cop_lat":"efgo emmos.","en":"after the Resurrection.","ar":"بعد القيامة قائلاً."}},{"id":"t833-24","text":{"cop":"+ Ⲏⲡⲡⲉ ϫⲉ ⲟⲩⲟⲛ:","cop_lat":"+ Eeppe je o-on:","en":"+ Behold “Do you have,","ar":"+ \"هل يوجد عندكم،"}},{"id":"t833-25","text":{"cop":"ⲧⲉⲧⲉⲛ ⲉⲛⲭⲁⲓ ⲛ̀ⲟⲩⲱⲙ:","cop_lat":"teten enkai enowom:","en":"anything to eat,”","ar":"شئ يؤكل،\""}},{"id":"t833-26","text":{"cop":"ⲁⲩϯ ⲛⲁϥ ⲇⲉ ⲟⲛ:","cop_lat":"avti naf the on:","en":"they gave to Him,","ar":"فأعطوه أيضاً،"}},{"id":"t833-27","text":{"cop":"ⲟⲩⲟϩ ⲁϥϭⲓ ⲁϥⲟⲩⲱⲙ.","cop_lat":"o-woh afchi afowom.","en":"and He took and ate.","ar":"وأخذ وأكل."}},{"id":"t833-28","text":{"cop":"+ Ⲑⲱⲟⲩϯ ⲁⲩϯ ⲛⲁϥ:","cop_lat":"+ Thoouti avti naf:","en":"+ They gathered and gave Him,","ar":"+ إجتمعوا وأعطوه،"}},{"id":"t833-29","text":{"cop":"ⲛ̀ⲟⲩⲧⲉⲃⲧ ⲉϥϫⲉϥϫⲱϥ:","cop_lat":"enoutevt efjefgof:","en":"broiled fish,","ar":"سمكاً مشوياً،"}},{"id":"t833-30","text":{"cop":"ⲛⲉⲙ ⲟⲩⲛⲏⲛⲓ:","cop_lat":"nem ouneeni:","en":"and honeycomb,","ar":"وشهداً،"}},{"id":"t833-31","text":{"cop":"ⲉ̀ⲧⲁϥϭⲓ ⲁϥⲟⲩⲱⲙ.","cop_lat":"etafchi afowom.","en":"and He took and ate.","ar":"فأخذ وأكل."}},{"id":"t833-32","text":{"cop":"Ⲓⲏⲥⲟⲩⲥ ϧⲉⲛ ⲡⲉϥⲉⲣϣⲓϣⲓ:","cop_lat":"Ieesous khen pefershishi:","en":"Jesus with His authority,","ar":"يسوع بسلطانه،"}},{"id":"t833-33","text":{"cop":"ⲁϥⲥ̀ⲙⲟⲩ ⲉ̀ⲛⲉϥⲁ̀ⲡⲟⲥⲧⲟⲗⲟⲥ:","cop_lat":"afesmou enefapostolos:","en":"blessed His Apostles,","ar":"بارك رسله،"}},{"id":"t833-34","text":{"cop":"ⲁⲥϣⲟⲡϥ ⲛ̀ϫⲉ ⲟⲩϭⲏⲡⲓ:","cop_lat":"asshopf enje oucheepi:","en":"and was taken by a cloud,","ar":"وأخذته سحابة،"}},{"id":"t833-35","text":{"cop":"ⲁϥϣⲉⲛⲁϥ ⲉ̀ⲟⲩⲣⲁⲛⲟⲥ.","cop_lat":"afshenaf eouranos.","en":"and ascended into the heavens.","ar":"وصعد إلى السموات."}},{"id":"t833-36","text":{"cop":"Ⲕⲩⲣⲓⲟⲥ Ⲓⲏⲥⲟⲩⲥ ⲙ̀ⲙⲏⲓ:","cop_lat":"Kirios Ieesous emmee:","en":"Jesus the true Lord,","ar":"الرب يسوع الحقيقي،"}},{"id":"t833-37","text":{"cop":"Ⲡ̀ⲟⲩⲣⲟ ⲛ̀ⲧⲉ ⲧ̀ⲫⲉ:","cop_lat":"Epouro ente etfe:","en":"the King of heaven,","ar":"ملك السماء،"}},{"id":"t833-38","text":{"cop":"Ⲡⲓⲟⲩⲱⲓⲛⲓ ⲛ̀ⲧⲁⲫ̀ⲙⲏⲓ:","cop_lat":"Piowoini enta-efmee:","en":"the true Light,","ar":"النور الحقيقي،"}},{"id":"t833-39","text":{"cop":"ⲁϥϣⲉⲛⲁϥ ⲉ̀ⲧ̀ⲫⲉ.","cop_lat":"afshenaf e-etfe.","en":"ascended to heaven.","ar":"صعد إلى السماء."}},{"id":"t833-40","text":{"cop":"+ Ⲗⲟⲩⲕⲁⲥ ⲁϥϫⲟⲥ:","cop_lat":"+ Loukas afgos:","en":"+ Luke has said,","ar":"+ قال لوقا،"}},{"id":"t833-41","text":{"cop":"ϧⲉⲛ ⲡⲓⲉⲩⲁⲅⲅⲉⲗⲓⲟⲛ:","cop_lat":"khen pievangelion:","en":"in the gospel,","ar":"في الإنجيل،"}},{"id":"t833-42","text":{"cop":"ⲛⲉⲙ Ⲙⲁⲧⲑⲉⲟⲥ ⲁϥϫⲟⲥ:","cop_lat":"nem Mattheos afgos:","en":"and Matthew has said,","ar":"مع متَّى،"}},{"id":"t833-43","text":{"cop":"ⲛⲉⲙ Ⲙⲁⲣⲕⲟⲥ ⲇⲉ ⲟⲛ.","cop_lat":"nem Markos the on.","en":"with Mark also.","ar":"ومرقس أيضاً."}},{"id":"t833-44","text":{"cop":"+ Ⲙ̀ⲡⲉ ϩ̀ⲗⲓ ϣⲉⲛⲁϥ:","cop_lat":"+ Empe ehli shenaf:","en":"+ “No one has ascended,","ar":"+ \"ليس أحد،"}},{"id":"t833-45","text":{"cop":"ⲉ̀ⲡ̀ϣⲱⲓ ⲉ̀ⲧ̀ⲫⲉ:","cop_lat":"e-epshoi e-etfe:","en":"up into heaven,","ar":"صعد إلى السماء،"}},{"id":"t833-46","text":{"cop":"ⲉ̀ⲃⲏⲗ ⲉ̀ⲫⲏⲉ̀ⲧⲁϥⲓ̀ ⲉ̀ⲡⲉⲥⲏⲧ:","cop_lat":"eveel efee-etafi epeseet:","en":"except the One who came,","ar":"إلا الذي نزل،"}},{"id":"t833-47","text":{"cop":"ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲧ̀ⲫⲉ.","cop_lat":"evol khen etfe.","en":"down from heaven.”","ar":"من السماء.\""}},{"id":"t833-48","text":{"cop":"Ⲛ̀ϫⲉ Ⲡ̀ϣⲏⲣⲓ ⲙ̀Ⲫ̀ⲣⲱⲙⲓ:","cop_lat":"Enje Epsheeri emefromi:","en":"“That is the Son of Man,","ar":"\"إبن البشر،"}},{"id":"t833-49","text":{"cop":"ⲫⲏⲉⲧϣⲟⲡ ϧⲉⲛ ⲧ̀ⲫⲉ:","cop_lat":"fee-etshop khen etfe:","en":"who dwells in heaven,","ar":"الساكن في السماء،"}},{"id":"t833-50","text":{"cop":"Ⲓⲏⲥⲟⲩⲥ Ⲡⲓⲣⲉϥⲉⲣϩⲉⲙⲓ:","cop_lat":"Ieesous Pireferhemi:","en":"Jesus the Governor,”","ar":"يسوع المُدبر،\""}},{"id":"t833-51","text":{"cop":"Ⲓⲱⲁⲛⲛⲏⲥ ⲁϥⲉⲣⲙⲉⲑⲣⲉ.","cop_lat":"Yoannees afermethre.","en":"John has witnessed.","ar":"وشهد يوحنا."}},{"id":"t833-52","text":{"cop":"Ⲝⲙⲁⲣⲱⲟⲩⲧ ⲁ̀ⲗⲏⲑⲱⲥ:","cop_lat":"Ksmaroout aleethos:","en":"Blessed are You indeed,","ar":"مبارك أنت بالحقيقة،"}},{"id":"t833-53","text":{"cop":"ⲱ̀ Ⲡⲉⲛⲛⲏⲃ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ:","cop_lat":"o Penneeb Pi-ekhristos:","en":"O Christ our Master,","ar":"أيها السيد المسيح،"}},{"id":"t833-54","text":{"cop":"ϩⲓϫⲉⲛ ⲡⲓⲑ̀ⲣⲟⲛⲟⲥ:","cop_lat":"hijen pi-ethronos:","en":"upon the throne,","ar":"على كرسي،"}},{"id":"t833-55","text":{"cop":"ⲛ̀ⲧⲉ ⲡⲉⲕⲱ̀ⲟⲩ ⲕⲁⲗⲱⲥ.","cop_lat":"ente pekoou kalos.","en":"of Your glory justly.","ar":"مجدك حسناً."}},{"id":"t833-56","text":{"cop":"+ Ⲟⲩⲟϩ ⲁϥⲧ̀ⲥⲁⲃⲱⲟⲩ:","cop_lat":"+ O-woh afetsavoou:","en":"+ And He has taught,","ar":"+ وعلَّم،"}},{"id":"t833-57","text":{"cop":"ϣⲁ ⲡⲓⲉ̀ϩⲟⲟⲩ:","cop_lat":"sha pi-ehoou:","en":"His Apostles,","ar":"رسله،"}},{"id":"t833-58","text":{"cop":"ⲉ̀ⲧⲁϥϩⲟⲛϩⲉⲛ ⲉ̀ⲧⲟⲧⲟⲩ:","cop_lat":"etafhonhen etotou:","en":"until the day,","ar":"إلى اليوم،"}},{"id":"t833-59","text":{"cop":"ⲛ̀ⲛⲉϥⲁ̀ⲡⲟⲥⲧⲟⲗⲟⲥ.","cop_lat":"ennefapostolos.","en":"wherein He ordered them.","ar":"الذي أمرهم فيه."}},{"id":"t833-60","text":{"cop":"+ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ Ⲡⲉⲛⲟⲩⲣⲟ:","cop_lat":"+ Pi-ekhristos Penouro:","en":"+ Christ our King,","ar":"+ المسيح ملكنا،"}},{"id":"t833-61","text":{"cop":"ⲙⲉⲛⲉⲛⲥⲁ Ⲧⲉϥⲁ̀ⲛⲁⲥⲧⲁⲥⲓⲥ:","cop_lat":"menensa Tefanastasis:","en":"after His Resurrection,","ar":"بعد قيامته،"}},{"id":"t833-62","text":{"cop":"ⲁϥⲟⲩⲟⲛϩϥ ⲉ̀ⲣⲱⲟⲩ:","cop_lat":"afowonhf eroou:","en":"appeared to them,","ar":"ظهر لهم،"}},{"id":"t833-63","text":{"cop":"ⲟⲩⲟϩ ⲁϥⲟⲩⲱⲙ ⲛⲉⲙⲱⲟⲩ.","cop_lat":"o-woh afowom nemoou.","en":"and He ate with them.","ar":"وأكل معهم."}},{"id":"t833-64","text":{"cop":"Ⲣⲁϣⲓ ⲱ̀ ⲛⲓⲡⲓⲥⲧⲟⲥ:","cop_lat":"Rashi o nipistos:","en":"Rejoice O believers,","ar":"إفرحوا أيها المؤمنون،"}},{"id":"t833-65","text":{"cop":"ϧⲉⲛ ⲡ̀ϣⲁⲓ ⲙ̀ⲡⲓⲙⲟⲛⲟⲅⲉⲛⲏⲥ:","cop_lat":"khen epshai empimonogenees:","en":"in the feast of the Only-Begotten,","ar":"في عيد الوحيد الجنس،"}},{"id":"t833-66","text":{"cop":"ⲉ̀ⲧⲁϥⲑⲁⲙⲓⲟ ⲛ̀ⲟⲩⲣⲁⲛⲟⲥ:","cop_lat":"etafthamio enouranos:","en":"who created the heavens,","ar":"الذي خلق،"}},{"id":"t833-67","text":{"cop":"ⲛⲉⲙ ⲛⲟⲩⲇⲩⲛⲁⲙⲓⲥ.","cop_lat":"nem nouthinamis.","en":"and all their hosts.","ar":"السموات وجندها."}},{"id":"t833-68","text":{"cop":"Ⲥ̀ⲙⲟⲩ ⲉ̀Ⲡⲓⲙⲁⲓⲣⲱⲙⲓ:","cop_lat":"Esmou epimairomi:","en":"Praise the Lover of Man,","ar":"سبحوا محب البشر،"}},{"id":"t833-69","text":{"cop":"Ⲡ̀ⲟⲩⲣⲟ ⲛ̀ⲛⲓⲉ̀ⲱⲛ:","cop_lat":"Epouro enni-eon:","en":"the King of the ages,","ar":"ملك الدهور،"}},{"id":"t833-70","text":{"cop":"ⲁϥⲑⲁⲙⲓⲟ ⲙ̀ⲡⲓⲣⲱⲙⲓ:","cop_lat":"afthamio empiromi:","en":"who created man,","ar":"الذي خلق،"}},{"id":"t833-71","text":{"cop":"ⲕⲁⲧⲁ ⲧⲉϥϩⲩⲕⲱⲛ.","cop_lat":"kata tefhikon.","en":"in His likeness.","ar":"الإنسان كصورته."}},{"id":"t833-72","text":{"cop":"+ Ⲧⲉⲛⲧⲱⲃϩ ⲙ̀ⲙⲟⲕ:","cop_lat":"+ Tentovh emmok:","en":"+ We pray to You,","ar":"+ نطلب منك،"}},{"id":"t833-73","text":{"cop":"ϧⲉⲛ ⲟⲩϩⲏⲧ ⲉϥⲥⲟⲩⲧⲱⲛ:","cop_lat":"khen ouheet efsouton:","en":"with an upright heart,","ar":"بقلب مستقيم،"}},{"id":"t833-74","text":{"cop":"ⲧⲉⲛⲟⲩⲱⲣⲡ ⲛⲁⲕ:","cop_lat":"tenoworp nak:","en":"and ascribe unto You,","ar":"ونرسل إليك،"}},{"id":"t833-75","text":{"cop":"ⲛ̀ϩⲱⲥ ⲙ̀ⲡ̀ⲛⲉⲩⲙⲁⲧⲓⲕⲟⲛ.","cop_lat":"enhos emepnevmatikon.","en":"spiritual praise.","ar":"تسابيح روحية."}},{"id":"t833-76","text":{"cop":"+ Ⲩ̀ⲓⲟⲥ Ⲑⲉⲟⲥ ⲁ̀ⲣⲉϩ ⲉ̀ⲣⲟⲛ:","cop_lat":"+ I-ios Theos areh eron:","en":"+ O Son of God,","ar":"+ يا إبن الله،"}},{"id":"t833-77","text":{"cop":"ⲉ̀ⲃⲟⲗ ϩⲁ ⲛⲓϩ̀ⲃⲱⲛ:","cop_lat":"evol ha ni-ehvon:","en":"guard us from inflation,","ar":"أحفظنا من الغلاء،"}},{"id":"t833-78","text":{"cop":"ⲛⲉⲙ ⲟⲩⲙⲟⲩ ⲛⲉⲙ ⲟⲩⲙⲟⲛⲙⲉⲛ:","cop_lat":"nem oumou nem oumonmen:","en":"and death and earthquakes,","ar":"والموت والزلازل،"}},{"id":"t833-79","text":{"cop":"ⲛⲉⲙ ⲛⲓⲇⲓⲱⲅⲙⲟⲥ.","cop_lat":"nem nithioghmos.","en":"and from persecutions.","ar":"والإضطهادات."}},{"id":"t833-80","text":{"cop":"Ⲫⲁⲓ ⲡⲉ ⲡⲓⲉ̀ϩⲟⲟⲩ:","cop_lat":"Fai pe pi-ehoou:","en":"This is the day,","ar":"هذا هو اليوم،"}},{"id":"t833-81","text":{"cop":"ⲉ̀ⲧⲁ Ⲡ̀ϭⲟⲓⲥ ⲑⲁⲙⲓⲟϥ:","cop_lat":"eta Epshois thamiof:","en":"the Lord has made,","ar":"الذي صنعه الرب،"}},{"id":"t833-82","text":{"cop":"ⲙⲁⲣⲉⲛⲑⲉⲗⲏⲗ ⲙ̀ⲙⲟⲛ ⲛ̀ϧⲏⲧϥ:","cop_lat":"marentheleel emmon enkheetf:","en":"let us rejoice,","ar":"فلنتهلل،"}},{"id":"t833-83","text":{"cop":"ⲟⲩⲟϩ ⲛ̀ⲧⲉⲛⲟⲩⲛⲟϥ.","cop_lat":"o-woh entenounof.","en":"and be glad therein.","ar":"ونفرح فيه."}},{"id":"t833-84","text":{"cop":"Ⲭⲉⲣⲉ Ϯⲁ̀ⲛⲁⲥⲧⲁⲥⲓⲥ:","cop_lat":"Shere Ti-anastasis:","en":"Hail to the Resurrection,","ar":"السلام للقيامة،"}},{"id":"t833-85","text":{"cop":"ⲱ̀ Ⲓⲉⲣⲟⲩⲥⲁⲗⲏⲙ ⲛⲉⲙ Ⲥⲓⲱⲛ:","cop_lat":"o Yerousaleem nem Sion:","en":"O Jerusalem and Zion,","ar":"يا أورُشَليم وصهيون،"}},{"id":"t833-86","text":{"cop":"ⲛⲉⲙ ⲡⲓⲧⲱⲟⲩ ⲛ̀ⲁ̀ⲛⲁⲗⲩⲯⲓⲥ:","cop_lat":"nem pitoou enanalipsis:","en":"and the mountain of the Ascension,","ar":"وجبل الصعود،"}},{"id":"t833-87","text":{"cop":"ⲛⲉⲙ ⲡⲓⲧⲱⲟⲩ ⲛ̀Ⲕ̀ⲣⲁⲛⲓⲟⲛ.","cop_lat":"nem pitoou enekranion.","en":"and the mountain of Kranion.","ar":"وجبل الإقرانيون."}},{"id":"t833-88","text":{"cop":"+ Ⲯⲱⲧⲏⲣ ⲙ̀ⲡⲓⲕⲟⲥⲙⲟⲥ:","cop_lat":"+ Psoteer empikosmos:","en":"+ O Savior of the world,","ar":"+ يا مخلِّص العالم،"}},{"id":"t833-89","text":{"cop":"ϧⲉⲛ Ⲧⲉⲕⲡⲁⲣⲟⲩⲥⲓⲁ:","cop_lat":"khen Tekparousia:","en":"at Your Coming,","ar":"في ظهورك،"}},{"id":"t833-90","text":{"cop":"ⲛⲟϩⲉⲙ ⲙ̀ⲡⲉⲕⲗⲁⲟⲥ:","cop_lat":"nohem empeklaos:","en":"save Your people,","ar":"خلِّص شعبك،"}},{"id":"t833-91","text":{"cop":"ⲥ̀ⲙⲟⲩ ⲉ̀ⲧⲉⲕⲕ̀ⲗⲏⲣⲟⲛⲟⲙⲓⲁ.","cop_lat":"esmou etekekleeronomia.","en":"and bless Your inheritance.","ar":"وبارك ميراثك."}},{"id":"t833-92","text":{"cop":"+ Ⲱ̀ Ⲡⲉⲛϭⲟⲓⲥ Ⲓⲏⲥⲟⲩⲥ:","cop_lat":"+ O Penshois Ieesous:","en":"+ O our Lord Jesus Christ,","ar":"+ يا ربنا يسوع ،"}},{"id":"t833-93","text":{"cop":"ϣⲉⲛϩⲏⲧ ϧⲁ ⲡⲉⲕⲗⲁⲟⲥ:","cop_lat":"shenheet kha peklaos:","en":"have compassion upon Your people,","ar":"تحنن على شعبك،"}},{"id":"t833-94","text":{"cop":"ⲁ̀ⲣⲉϩ ⲉ̀ⲣⲱⲟⲩ ⲁ̀ⲗⲏⲑⲱⲥ:","cop_lat":"areh eroou aleethos:","en":"guard them in truth,","ar":"وأحفظهم بالحقيقة،"}},{"id":"t833-95","text":{"cop":"ϧⲉⲛ Ⲡⲓⲡⲁⲣⲁⲇⲓⲥⲟⲥ.","cop_lat":"khen Piparathisos.","en":"in the Paradise.","ar":"في الفردوس."}},{"id":"t816-0","text":{"cop":"Ⲁ̀ⲗⲏⲑⲱⲥ ⲧⲉⲛⲛⲁϩϯ ⲁ̀ⲛⲟⲛ:","cop_lat":"Aleethos tennahti anon:","en":"Truly we believe,","ar":"حقاً نؤمن،"},"section":{"en":"Watos Psali, Ⲁ̀ⲗⲏⲑⲱⲥ ⲧⲉⲛⲛⲁϩϯ ⲁ̀ⲛⲟⲛ","path":"Feasts › Festive Days › Resurrection Day to the 39th Day › Midnight Praises"}},{"id":"t816-1","text":{"cop":"ⲡⲓϣ̀ⲗⲟⲗ ⲛ̀ⲟⲣⲑⲟⲇⲟⲝⲟⲛ:","cop_lat":"pi-eshlol enorthothokson:","en":"we the orthodox people,","ar":"نحن الشعب الأرثوذوكسي،"}},{"id":"t816-2","text":{"cop":"ϫⲉ Ⲡ̀ⲟⲩⲣⲟ ⲛ̀ⲧⲉ ⲛⲓⲉ̀ⲱⲛ:","cop_lat":"je Epouro ente ni-eon:","en":"that the King of the ages,","ar":"أن ملك الدهور،"}},{"id":"t816-3","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-4","text":{"cop":"Ⲃⲟⲛ ⲟⲩⲣⲁϣⲓ ⲛⲉⲙ ⲟⲩⲑⲉⲗⲏⲗ:","cop_lat":"Von ourashi nem outheleel:","en":"All joy and happiness,","ar":"فرحاً وتهليلاً،"}},{"id":"t816-5","text":{"cop":"ϫⲉ Ⲫ̀ⲛⲟⲩϯ ⲁϥⲧⲏⲓⲧⲟⲩ ⲛⲁⲛ:","cop_lat":"je Efnoti afteeitou nan:","en":"God gave unto us,","ar":"أعطاهما لنا الله،"}},{"id":"t816-6","text":{"cop":"ϫⲉ Ⲡⲉⲛⲟⲩⲣⲟ Ⲉⲙⲙⲁⲛⲟⲩⲏⲗ:","cop_lat":"je Penouro Emmanoweel:","en":"for our King Emmanuel,","ar":"لأن ملكنا عمانوئيل،"}},{"id":"t816-7","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-8","text":{"cop":"+ Ⲅⲉⲛⲟⲥ ⲛⲓⲃⲉⲛ ⲛ̀ⲧⲉ ⲛⲓⲣⲱⲙⲓ:","cop_lat":"+ Genos niven ente niromi:","en":"+ Every race in mankind,","ar":"+ كل جنس البشر،"}},{"id":"t816-9","text":{"cop":"ⲛⲟⲩⲙⲱⲓⲧ ⲧⲏⲣⲟⲩ ⲥⲉⲥⲟⲩⲧⲱⲛ:","cop_lat":"noumoit teerou sesouton:","en":"follow upright paths,","ar":"جميع طرقهم مستقيمة،"}},{"id":"t816-10","text":{"cop":"ϫⲉ Ⲡⲓⲗⲟⲅⲟⲥ ⲙ̀ⲙⲁⲓⲣⲱⲙⲓ:","cop_lat":"je Piloghos emmairomi:","en":"for the Word the Lover of Man,","ar":"لأن الكلمة مُحب البشر،"}},{"id":"t816-11","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-12","text":{"cop":"+ Ⲇⲁⲩⲓⲇ ⲡ̀ⲟⲩⲣⲟ ⲙ̀Ⲡⲓⲥⲣⲁⲏⲗ:","cop_lat":"+ David epouro empisraeel:","en":"+ David the King of Israel,","ar":"+ داود ملك إسرائيل،"}},{"id":"t816-13","text":{"cop":"ⲁϥϫⲟⲥ ϧⲉⲛ ⲡⲓⲯⲁⲗⲧⲏⲣⲓⲟⲛ:","cop_lat":"afgos khen pipsalteerion:","en":"said with the psaltery,","ar":"قال في المزمور،"}},{"id":"t816-14","text":{"cop":"ϫⲉ ⲁϥⲧⲱⲛϥ ⲛ̀ϫⲉ Ⲫ̀ⲛⲟⲩϯ ϧⲉⲛ ⲟⲩⲑⲉⲗⲏⲗ:","cop_lat":"je aftonf enje Efnoti khen outheleel:","en":"God has joyfully risen,","ar":"قد قام الله بتهليل،"}},{"id":"t816-15","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-16","text":{"cop":"Ⲉⲑⲃⲉ Ϯⲁ̀ⲛⲁⲥⲧⲁⲥⲓⲥ ⲉⲑⲟⲩⲁⲃ:","cop_lat":"Ethve Ti-anastasis ethowab:","en":"For the sake of the holy Resurrection,","ar":"من أجل القيامة المقدسة،"}},{"id":"t816-17","text":{"cop":"ϩⲱⲥ ⲑⲉⲗⲏⲗ ⲁ̀ⲣⲓⲯⲁⲗⲓⲛ:","cop_lat":"hos theleel aripsalin:","en":"sing praise and rejoice,","ar":"سبحوا وهللوا ورتلوا،"}},{"id":"t816-18","text":{"cop":"ϩⲓϣⲉⲛⲛⲟⲩϥⲓ ϧⲉⲛ ⲛⲓⲉⲑⲛⲟⲥ ⲉⲩⲥⲟⲡ:","cop_lat":"hishennoufi khen niethnos evsop:","en":"preach to the nations,","ar":"وبشروا معاً في الامم،"}},{"id":"t816-19","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"for Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-20","text":{"cop":"Ⲍ̅ (ϣⲁϣϥ) ⲛ̀ⲧⲁⲅⲙⲁ ⲛ̀ⲁⲅⲅⲉⲗⲟⲥ:","cop_lat":"shashf (shashf) entaghma enangelos:","en":"Seven angelic orders,","ar":"سبع طغمات الملائكة،"}},{"id":"t816-21","text":{"cop":"ⲥⲉϩⲱⲥ ⲉ̀ⲣⲟϥ ⲙ̀ⲡ̀ⲛⲉⲩⲙⲁⲧⲓⲕⲟⲛ:","cop_lat":"sehos erof emepnevmatikon:","en":"praise Him spiritually,","ar":"تُسبحه روحياً،"}},{"id":"t816-22","text":{"cop":"ⲉⲑⲃⲉ ⲫ̀ⲛⲟϩⲉⲙ ⲙ̀ⲡⲓⲕⲟⲥⲙⲟⲥ:","cop_lat":"ethve efnohem empikosmos:","en":"for the salvation of the world,","ar":"من أجل خلاص العالم،"}},{"id":"t816-23","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-24","text":{"cop":"+ Ⲏⲗ ⲛ̀ⲑⲟϥ ⲡⲉ Ⲩ̀ⲓⲟⲥ Ⲑⲉⲟⲥ:","cop_lat":"+ Eel enthof pe I-ios Theos:","en":"+ God is the Son of God,","ar":"+ إيل هو إبن الله،"}},{"id":"t816-25","text":{"cop":"ⲧⲉⲛϩⲱⲥ ⲉ̀ⲣⲟϥ ⲙ̀ⲙⲟⲥⲓⲕⲟⲛ:","cop_lat":"tenhos erof emmosikon:","en":"praise Him with music,","ar":"نُسبحه بالموسيقى،"}},{"id":"t816-26","text":{"cop":"ϫⲉ ⲛ̀ⲑⲟϥ ⲁϥⲥⲱϯ ⲙ̀ⲡⲉⲛⲅⲉⲛⲟⲥ:","cop_lat":"je enthof afsoti empengenos:","en":"for He has saved our race,","ar":"لأنه خلَّص جنسنا،"}},{"id":"t816-27","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-28","text":{"cop":"+ Ⲑⲉⲗⲏⲗ ⲱ̀ ⲡ̀ⲅⲉⲛⲟⲥ ⲛ̀Ⲁ̀ⲇⲁⲙ:","cop_lat":"+ Theleel o epgenos enadam:","en":"+ Rejoice O race of Adam,","ar":"+ تهلل يا جنس آدم،"}},{"id":"t816-29","text":{"cop":"ϧⲉⲛ ⲟⲩⲣⲁϣⲓ ⲙ̀ⲡ̀ⲛⲉⲩⲙⲁⲧⲓⲕⲟⲛ:","cop_lat":"khen ourashi emepnevmatikon:","en":"with spiritual joy,","ar":"بفرح روحي،"}},{"id":"t816-30","text":{"cop":"ϫⲉ Ⲡⲓⲣⲉϥⲥⲱⲛⲧ ⲛ̀Ⲁ̀ⲇⲁⲙ:","cop_lat":"je Pirefsont enadam:","en":"for the Creator of Adam,","ar":"لأن خالق آدم،"}},{"id":"t816-31","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-32","text":{"cop":"Ⲓⲥ ϯⲕ̀ⲧⲏⲥⲓⲥ ⲧⲏⲣⲥ ⲉⲩⲥⲟⲡ:","cop_lat":"Is ti-ekteesis teers evsop:","en":"All the creation together,","ar":"ها البرية تفرح معاً،"}},{"id":"t816-33","text":{"cop":"ⲣⲁϣⲓ ⲉⲑⲃⲉ ⲡⲁⲓⲙⲩⲥⲧⲏⲣⲓⲟⲛ:","cop_lat":"rashi ethve paimisteerion:","en":"rejoices in this mystery,","ar":"من أجل هذا السر،"}},{"id":"t816-34","text":{"cop":"ϫⲉ Ⲡ̀ϣⲏⲣⲓ ⲙ̀Ⲫⲏⲉⲑⲟⲩⲁⲃ:","cop_lat":"je Epsheeri emfee-ethowab:","en":"for the Son of the Holy,","ar":"لأن إبن القدوس،"}},{"id":"t816-35","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-36","text":{"cop":"Ⲕⲩⲣⲓⲟⲥ Ⲓⲏⲥⲟⲩⲥ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ:","cop_lat":"Kirios Ieesous Pi-ekhristos:","en":"Our Lord Jesus Christ,","ar":"نُسبح الرب،"}},{"id":"t816-37","text":{"cop":"Ⲡ̀ϣⲏⲣⲓ ⲙ̀Ⲫ̀ⲛⲟⲩϯ Ⲡⲓⲗⲟⲅⲟⲥ:","cop_lat":"Epsheeri emefnoti Piloghos:","en":"the Son of God the Word,","ar":"يسوع المسيح،"}},{"id":"t816-38","text":{"cop":"ⲧⲉⲛϩⲱⲥ ⲉ̀ⲣⲟϥ ⲉⲛϫⲱ ⲙ̀ⲙⲟⲥ:","cop_lat":"tenhos erof engo emmos:","en":"we praise Him saying,","ar":"إبن الله الكلمة قائلين،"}},{"id":"t816-39","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"“Christ is risen from the dead.”","ar":"\"المسيح قام من بين الأموات.\""}},{"id":"t816-40","text":{"cop":"+ Ⲗⲟⲓⲡⲟⲛ ⲁⲩⲭⲁϥ ϧⲉⲛ ⲡⲓⲙ̀ϩⲁⲩ:","cop_lat":"+ Loipon avkaf khen pi-emhav:","en":"+ Then He was placed in the tomb,","ar":"+ وُضع أيضاً في القبر،"}},{"id":"t816-41","text":{"cop":"ⲕⲁⲧⲁ ⲛⲓⲥ̀ⲙⲏ ⲙ̀ⲡ̀ⲣⲟⲫⲏⲧⲓⲕⲟⲛ:","cop_lat":"kata ni-esmee emeprofeetikon:","en":"according to the prophetic sayings,","ar":"حسب الأخبار النبوية،"}},{"id":"t816-42","text":{"cop":"ϧⲉⲛ ⲡⲓⲙⲁϩϣⲟⲙⲧ ⲛ̀ⲉ̀ϩⲟⲟⲩ:","cop_lat":"khen pimahshomt enehoou:","en":"and on the third day,","ar":"وفي اليوم الثالث،"}},{"id":"t816-43","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-44","text":{"cop":"+ Ⲙⲁⲣⲉⲛⲕⲁϯ ⲱ̀ ⲛⲓⲗⲁⲟⲥ:","cop_lat":"+ Marenkati o nilaos:","en":"+ Let us understand,","ar":"+ فلنفهم الإنجيل،"}},{"id":"t816-45","text":{"cop":"ⲉ̀ⲡⲓⲉⲩⲁⲅⲅⲉⲗⲓⲟⲛ:","cop_lat":"epievangelion:","en":"the Gospel O people,","ar":"أيها الشعوب،"}},{"id":"t816-46","text":{"cop":"ⲫⲏⲉ̀ⲧⲁϥϫⲟⲥ ϫⲉ Ⲡⲓⲁ̀ⲑⲁⲛⲁⲧⲟⲥ:","cop_lat":"fee-etafgos je Pi-athanatos:","en":"which has said “The Immortal,","ar":"الذي قال أن غير المائت،"}},{"id":"t816-47","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.”","ar":"المسيح قام من بين الأموات."}},{"id":"t816-48","text":{"cop":"Ⲛⲓⲧⲁⲅⲙⲁ ⲧⲏⲣⲟⲩ ⲛ̀ⲧⲉ ⲛⲓⲫⲏⲟⲩⲓ̀:","cop_lat":"Nitaghma teerou ente nifeeoui:","en":"All the heavenly orders,","ar":"كل الطغمات السمائية،"}},{"id":"t816-49","text":{"cop":"ⲛⲓⲫⲩⲥⲓⲥ ⲛ̀ⲛⲟⲏ̀ⲣⲟⲛ:","cop_lat":"nifisis enno-eeron:","en":"and the rational natures,","ar":"والطبائع العقلية،"}},{"id":"t816-50","text":{"cop":"ⲁⲩⲉⲣϣ̀ⲫⲏⲣⲓ ϧⲉⲛ ⲛⲉⲕϩ̀ⲃⲏⲟⲩⲓ̀:","cop_lat":"avereshfeeri khen nekehveeoui:","en":"were amazed at Your works,","ar":"تعجبت من أعمالك،"}},{"id":"t816-51","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-52","text":{"cop":"Ⲝⲉⲣⲉⲧⲱⲛ ⲛⲉ ⲛⲉⲕϩ̀ⲃⲏⲟⲩⲓ̀:","cop_lat":"Ksereton ne nekehveeoui:","en":"Exalted are Your works,","ar":"وبالأكثر أعمالك،"}},{"id":"t816-53","text":{"cop":"ⲛⲉⲕϩⲁⲡ ⲙ̀ⲡⲁⲣⲁⲇⲟⲝⲟⲛ:","cop_lat":"nekhap emparathokson:","en":"and Your mysterious judgments,","ar":"وأحكامك المعجزة،"}},{"id":"t816-54","text":{"cop":"ϫⲉ ⲛ̀ⲑⲟⲕ ⲡⲉ Ⲡ̀ⲟⲩⲣⲟ ⲛ̀ⲧⲉ ⲛⲓⲫⲏⲟⲩⲓ̀:","cop_lat":"je enthok pe Epouro ente nifeeoui:","en":"for You are the King of heaven,","ar":"لأنك أنت هو ملك السموات،"}},{"id":"t816-55","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-56","text":{"cop":"+ Ⲟⲩⲣⲁⲛ ⲛ̀ϣⲟⲩϣⲟⲩ ⲡⲉ ⲡⲉⲕⲣⲁⲛ:","cop_lat":"+ Ouran enshoushou pe pekran:","en":"+ A name of pride is Your name,","ar":"+ إسم الإفتخار هو إسمك،"}},{"id":"t816-57","text":{"cop":"Ⲩ̀ⲓⲟⲥ Ⲑⲉⲟⲥ Ⲫⲓⲗⲁⲛⲑ̀ⲣⲱⲡⲟⲛ:","cop_lat":"I-ios Theos Filanethropon:","en":"O Son of God the Lover of Man,","ar":"يا إبن الله محب البشر،"}},{"id":"t816-58","text":{"cop":"ⲧⲉⲛⲛⲁϩϯ ⲁϭⲛⲉ ⲥ̀ⲕⲁⲛⲇⲁⲗⲟⲛ:","cop_lat":"tennahti achne eskanthalon:","en":"we believe without doubt,","ar":"نؤمن بغير شك،"}},{"id":"t816-59","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-60","text":{"cop":"+ Ⲡⲓⲟⲩⲁⲓ ⲉ̀ⲃⲟⲗ ϧⲉⲛ Ϯⲧ̀ⲣⲓⲁⲥ:","cop_lat":"+ Piowai evol khen Ti-etrias:","en":"+ One from the Trinity,","ar":"+ الواحد من الثالوث،"}},{"id":"t816-61","text":{"cop":"Ⲡⲓⲗⲟⲅⲟⲥ ⲛ̀ⲁⲓⲇⲓⲟⲛ:","cop_lat":"Piloghos enaithion:","en":"the eternal Word,","ar":"الكلمة الذاتي،"}},{"id":"t816-62","text":{"cop":"Ⲡ̀ϣⲏⲣⲓ ⲙ̀Ⲫ̀ⲛⲟⲩϯ ⲁ̀ⲗⲏⲑⲱⲥ:","cop_lat":"Epsheeri emefnoti aleethos:","en":"the Son of the true God,","ar":"إبن الله الحقيقي،"}},{"id":"t816-63","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-64","text":{"cop":"Ⲣⲱⲛ ⲅⲁⲣ ⲁϥⲙⲟϩ ⲛ̀ⲣⲁϣⲓ:","cop_lat":"Ron ghar afmoh enrashi:","en":"Our mouths are filled with joy,","ar":"فمنا إمتلأ فرحاً،"}},{"id":"t816-65","text":{"cop":"ⲛⲉⲙ ⲟⲩⲟⲩⲛⲟϥ ⲛ̀ⲁⲧⲙⲉⲧⲣⲟⲛ:","cop_lat":"nem o-ounof enatmetron:","en":"and immeasurable happiness,","ar":"وسروراً لا يُقاس،"}},{"id":"t816-66","text":{"cop":"ϫⲉ Ⲡⲓⲥⲏⲓⲛⲓ ⲛ̀ⲛⲏⲉⲧϣⲱⲛⲓ:","cop_lat":"je Piseeini ennee-etshoni:","en":"for the Physician of the sick,","ar":"لأن طبيب المرضى،"}},{"id":"t816-67","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-68","text":{"cop":"Ⲥⲱⲧⲉⲙ ⲉ̀ⲣⲟⲓ ⲱ̀ ⲛⲁⲙⲉⲛⲣⲁϯ:","cop_lat":"Sotem eroi o namenrati:","en":"Hear me O my beloved,","ar":"إسمعوا يا أحبائي،"}},{"id":"t816-69","text":{"cop":"ⲛⲏⲉ̀ⲧⲁⲩϭⲓ ⲙ̀ⲡⲓⲡⲁⲣⲁⲃⲓⲟⲛ:","cop_lat":"nee-etavchi empiparavion:","en":"who have received the testament,","ar":"الذين أخذوا الوصية،"}},{"id":"t816-70","text":{"cop":"ⲉⲑⲃⲉ Ϯⲁ̀ⲛⲁⲥⲧⲁⲥⲓⲥ ⲙ̀Ⲡ̀ϣⲏⲣⲓ ⲙ̀Ⲫ̀ⲛⲟⲩϯ:","cop_lat":"ethve Ti-anastasis emepsheeri emefnoti:","en":"for the Resurrection of the Son of God,","ar":"من أجل قيامة إبن الله،"}},{"id":"t816-71","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-72","text":{"cop":"+ Ⲧⲉⲛⲛⲁϩϯ ⲁϭⲛⲉ ⲥⲁⲛⲓⲥ:","cop_lat":"+ Tennahti achne sanis:","en":"+ We believe without doubt,","ar":"+ نؤمن بغير شك،"}},{"id":"t816-73","text":{"cop":"ϧⲉⲛ ⲡⲁⲓϩⲱⲃ ⲙ̀ⲙⲩⲥⲧⲏⲣⲓⲟⲛ:","cop_lat":"khen paihob emmisteerion:","en":"of this mysterious matter,","ar":"بهذا الأمر السري،"}},{"id":"t816-74","text":{"cop":"ϫⲉ Ⲡ̀ϣⲏⲣⲓ ⲙ̀ⲙⲟⲛⲟⲅⲉⲛⲏⲥ:","cop_lat":"je Epsheeri emmonogenees:","en":"that the only-begotten Son,","ar":"أن الإبن الوحيد،"}},{"id":"t816-75","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-76","text":{"cop":"+ Ⲩⲡⲡⲉ ⲛⲓⲡ̀ⲣⲟⲫⲏⲧⲏⲥ ⲧⲏⲣⲟⲩ:","cop_lat":"+ Ippe ni-eprofeetees teerou:","en":"+ Behold all the prophets,","ar":"+ هوذا جميع الأنبياء،"}},{"id":"t816-77","text":{"cop":"ⲁⲩⲉⲣⲡ̀ⲣⲟⲫⲏⲧⲉⲩⲓⲛ ⲇⲉ ⲟⲛ:","cop_lat":"avereprofeetevin the on:","en":"prophesied also,","ar":"تنبأوا أيضاً،"}},{"id":"t816-78","text":{"cop":"ϫⲉ Ⲡ̀ⲟⲩⲣⲟ ⲛ̀ⲧⲉ ⲛⲓⲟⲩⲣⲱⲟⲩ ⲧⲏⲣⲟⲩ:","cop_lat":"je Epouro ente niouroou teerou:","en":"for the King of all kings,","ar":"أن ملك جميع الملوك،"}},{"id":"t816-79","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-80","text":{"cop":"Ⲫ̀ⲛⲟⲩϯ ⲛ̀ⲧⲉ ⲛⲓⲡ̀ⲣⲟⲫⲏⲧⲏⲥ:","cop_lat":"Efnoti ente ni-eprofeetees:","en":"God of the prophets,","ar":"إله الأنبياء،"}},{"id":"t816-81","text":{"cop":"ⲛⲉⲙ ⲛⲓⲑ̀ⲙⲏⲓ ⲛⲉⲙ ⲛⲓⲇⲓⲕⲉⲟⲛ:","cop_lat":"nem ni-ethmee nem nithikeon:","en":"and the righteous and the just,","ar":"والأبرار والصديقين،"}},{"id":"t816-82","text":{"cop":"ⲛ̀ⲑⲟϥ ⲡⲉ Ⲡⲓⲇⲉⲥⲡⲟⲧⲏⲥ:","cop_lat":"enthof pe Pithespotees:","en":"He is the Master,","ar":"هو السيد،"}},{"id":"t816-83","text":{"cop":"Ⲡⲭ̅ⲥ̅ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ.","cop_lat":"Pi-ekhristos anestee ek nekron.","en":"Christ is risen from the dead.","ar":"المسيح قام من بين الأموات."}},{"id":"t816-84","text":{"cop":"Ⲭ̀ⲟⲩⲁⲃ Ⲡ̀ϭⲟⲓⲥ ⲟⲩⲟϩ ⲭ̀ⲟⲩⲁⲃ:","cop_lat":"Ekowab Epshois o-woh ekowab:","