{"title":"Fasts › Jonah's Fast","source":"tasbeha.org hymn library","languages":{"en":"English","cop":"Ⲙⲉⲧⲣⲉⲙⲛ̀ⲭⲏⲙⲓ","cop_lat":"Coptic (Latin letters)","ar":"عربي"},"roles":{"priest":{"en":"Priest","de":"Priester","ar":"الكاهن","cop":"Ⲡⲓⲟⲩⲏⲃ"},"deacon":{"en":"Deacon","de":"Diakon","ar":"الشماس","cop":"Ⲡⲓⲇⲓⲁⲕⲱⲛ"},"people":{"en":"People","de":"Gemeinde","ar":"الشعب","cop":"Ⲡⲓⲗⲁⲟⲥ"}},"paragraphs":[{"id":"t298-0","text":{"cop":"Ⲱ̀ ⲫⲏⲉ̀ⲧⲁϥⲁ̀ⲣⲉϩ ⲉ̀Ⲓⲱⲛⲁ:","cop_lat":"O fee-etafareh eyona:","en":"O You who kept Jonah,","ar":"يا مَنْ حفظ يونان،"},"section":{"en":"Gospel Response - Monday Liturgy , Ⲱ̀ ⲫⲏⲉ̀ⲧⲁϥⲁ̀ⲣⲉϩ","path":"Fasts › Jonah's Fast"}},{"id":"t298-1","text":{"cop":"ⲉϥⲭⲏ ϧⲉⲛ ⲑ̀ⲛⲉϫⲓ ⲙ̀ⲡⲓⲕⲏⲧⲟⲥ:","cop_lat":"efkee khen ethneji empikeetos:","en":"in the belly of the whale,","ar":"في بطن الحوت،"}},{"id":"t298-2","text":{"cop":"ⲉ̀ⲧⲁⲩϩⲓⲧϥ ⲉ̀ⲡ̀ϣⲱⲕ ⲙ̀ⲫ̀ⲓⲟⲙ:","cop_lat":"etavhitf e-epshok emefiom:","en":"when he was thrown in the depth of the sea,","ar":"لما أُلقي في عمق البحر،"}},{"id":"t298-3","text":{"cop":"ⲁ̀ⲣⲉϩ ⲉ̀ⲣⲟⲛ ⲕⲁⲧⲁ ⲧⲉⲕϫⲟⲙ.","cop_lat":"areh eron kata tekgom.","en":"keep us with Your power.","ar":"إحفظنا بقوتك."}},{"id":"t300-0","text":{"cop":"Ⲁⲗⲗⲁ ⲃⲱⲗ ⲉ̀ⲃⲟⲗ ⲭⲱ ⲛⲏⲓ ⲉ̀ⲃⲟⲗ:","cop_lat":"Alla vol evol ko nee evol:","en":"But rather absolve and remit,","ar":"لكن حل وإغفر لي،"},"section":{"en":"Gospel Response - Tuesday Liturgy, Ⲁⲗⲗⲁ ⲃⲱⲗ ⲉ̀ⲃⲟⲗ","path":"Fasts › Jonah's Fast"}},{"id":"t300-1","text":{"cop":"ⲛ̀ⲛⲁⲡⲁⲣⲁⲡ̀ⲧⲱⲙⲁ ⲉⲧⲟϣ:","cop_lat":"ennapara-eptoma etosh:","en":"my many iniquities,","ar":"زلاتي الكثيرة،"}},{"id":"t300-2","text":{"cop":"ϩⲱⲥ Ⲁ̀ⲅⲁⲑⲟⲥ ⲟⲩⲟϩ ⲙ̀Ⲙⲁⲓⲣⲱⲙⲓ:","cop_lat":"hos Aghathos o-woh emmairomi:","en":"as a good One and Lover of man,","ar":"كصالح ومحب البشر،"}},{"id":"t300-3","text":{"cop":"ⲛⲁⲓ ⲛⲁⲛ ⲕⲁⲧⲁ ⲡⲉⲕⲛⲓϣϯ ⲛ̀ⲛⲁⲓ.","cop_lat":"nai nan kata peknishti ennai.","en":"have mercy upon us according to Your great mercy.","ar":"إرحمنا كعظيم رحمتك."}},{"id":"t303-0","text":{"cop":"Ⲡⲓϣⲁϣϥ (ⲍ̅) ⲛ̀ⲱⲓⲕ ⲁϥⲥ̀ⲙⲟⲩ ⲉ̀ⲣⲱⲟⲩ:","cop_lat":"Pishashf (shashf) enoik afesmou eroou:","en":"He blessed the seven loaves,","ar":"السبع خبزات باركها،"},"section":{"en":"Gospel Response - Wednesday Liturgy, Ⲡⲓϣⲁϣϥ ⲛ̀ⲱⲓⲕ","path":"Fasts › Jonah's Fast"}},{"id":"t303-1","text":{"cop":"ϥ̀ⲧⲟⲟⲩ ⲛ̀ϣⲟ ⲛ̀ⲣⲱⲙⲓ ⲁϥⲧ̀ⲥⲓⲱⲟⲩ:","cop_lat":"eftoou ensho enromi afetsioou:","en":"and filled the four thousand men,","ar":"وأشبع أربعة ألاف رجل،"}},{"id":"t303-2","text":{"cop":"ϣⲁϣϥ ⲙ̀ⲃⲓⲣ ⲁⲩⲙⲟϩ ⲙ̀ⲙⲱⲟⲩ:","cop_lat":"shashf emvir avmoh emmoou:","en":"and seven baskets were filled,","ar":"وسبع قُفف ملأها،"}},{"id":"t303-3","text":{"cop":"ϧⲉⲛ ⲛⲓⲗⲁⲕϩ ⲉ̀ⲧⲁⲩⲉⲣϩⲟⲩⲱ ⲉ̀ⲣⲱⲟⲩ.","cop_lat":"khen nilakh etaverhowo eroou.","en":"of their leftover.","ar":"مما فضل عنهم."}},{"id":"t301-0","text":{"cop":"Ⲁⲗⲗⲁ ⲡⲁⲟ̅ⲥ̅ ⲁ̀ⲣⲓⲟⲩⲓ̀ ⲛⲉⲙⲁⲛ:","cop_lat":"Alla pashois arioui neman:","en":"But deal with us O my Lord,","ar":"بل إصنع معنا يا سيدي،"},"section":{"en":"Gospel Response - Monday Matins , Ⲁⲗⲗⲁ ⲡⲁⲟ̅ⲥ̅","path":"Fasts › Jonah's Fast"}},{"id":"t301-1","text":{"cop":"ⲙ̀ⲫ̀ⲣⲏϯ ⲛ̀ⲛⲓⲣⲉⲙⲚⲓⲛⲉⲩⲏ̀:","cop_lat":"emefreeti enniremninevee:","en":"like the people of Nineveh,","ar":"مثل أهل نينوى،"}},{"id":"t301-2","text":{"cop":"ⲛⲁⲓ ⲉ̀ⲧⲁⲩⲉⲣⲙⲉⲧⲁⲛⲟⲓⲛ:","cop_lat":"nai etavermetanoin:","en":"who has repented,","ar":"هؤلاء الذين تابوا،"}},{"id":"t301-3","text":{"cop":"ⲁⲕⲭⲁ ⲛⲟⲩⲛⲟⲃⲓ ⲛⲱⲟⲩ ⲉ̀ⲃⲟⲗ.","cop_lat":"akka nounovi noou evol.","en":"and You forgave them their sins.","ar":"فغَفَرت لهم خطاياهم."}},{"id":"t299-0","text":{"cop":"Ⲙⲟⲓ ⲛⲏⲓ Ⲡ̀ⲟ̅ⲥ̅ ⲛ̀ⲟⲩⲙⲉⲧⲁⲛⲟⲓⲁ:","cop_lat":"Moi nee Epshois enoumetanoia:","en":"Grant me O Lord repentance,","ar":"أعطني يا رب توبة،"},"section":{"en":"Gospel Response - Tuesday Matins, Ⲙⲟⲓ ⲛⲏⲓ Ⲡ̀ⲟ̅ⲥ̅","path":"Fasts › Jonah's Fast"}},{"id":"t299-1","text":{"cop":"ⲉ̀ⲡ̀ϫⲓⲛⲧⲁⲉⲣⲙⲉⲧⲁⲛⲟⲓⲛ:","cop_lat":"e-epjintaermetanoin:","en":"that I may repent,","ar":"لكي أتوب،"}},{"id":"t299-2","text":{"cop":"ⲙ̀ⲡⲁⲧⲉ ⲫ̀ⲙⲟⲩ ⲙⲁϣ̀ⲑⲁⲙ ⲛ̀ⲣⲱⲓ:","cop_lat":"empate efmou ma-eshtam enroi:","en":"before death closes my mouth,","ar":"قبل أن يغلق الموت فمي،"}},{"id":"t299-3","text":{"cop":"ϧⲉⲛ ⲛⲓⲡⲩⲗⲏ ⲛ̀ⲧⲉ Ⲁ̀ⲙⲉⲛϯ.","cop_lat":"khen nipilee ente Amenti.","en":"in the gates of Hades.","ar":"في أبواب الجحيم."}},{"id":"t302-0","text":{"cop":"Ϫⲉ ⲁ̀ⲙⲱⲓⲛⲓ ϩⲁⲣⲟⲓ:","cop_lat":"Je amoini haroi:","en":"\"Come unto Me,","ar":"\"تعالوا إليَّ،"},"section":{"en":"Gospel Response - Wednesday Matins, Ϫⲉ ⲁ̀ⲙⲱⲓⲛⲓ ϩⲁⲣⲟⲓ","path":"Fasts › Jonah's Fast"}},{"id":"t302-1","text":{"cop":"ⲛⲏⲉⲧⲥ̀ⲙⲁⲣⲱⲟⲩⲧ ⲛ̀ⲧⲉ Ⲡⲁⲓⲱⲧ:","cop_lat":"nee-etesmaroout ente Paiot:","en":"O blessed of My Father,","ar":"يا مباركي أبي،"}},{"id":"t302-2","text":{"cop":"ⲁ̀ⲣⲓⲕ̀ⲗⲏⲣⲟⲛⲟⲙⲓⲛ ⲙ̀ⲡⲓⲱⲛϧ:","cop_lat":"ari-ekleeronomin empionkh:","en":"and inherit the life,","ar":"رثوا الحياة الدائمة،"}},{"id":"t302-3","text":{"cop":"ⲉⲑⲙⲏⲛ ⲉ̀ⲃⲟⲗ ϣⲁ ⲉ̀ⲛⲉϩ.","cop_lat":"ethmeen evol sha eneh.","en":"that endures forever.\"","ar":"إلى الأبد.\""}},{"id":"t2208-0","text":{"cop":"Ⲓⲱⲛⲁ ⲡⲓⲡ̀ⲣⲟⲫⲏⲧⲏⲥ:","cop_lat":"Yona pi-eprofeetees:","en":"Jonah the prophet,","ar":"يونان النبي،"},"section":{"en":"Doxology, Ⲓⲱⲛⲁ ⲡⲓⲡ̀ⲣⲟⲫⲏⲧⲏⲥ","path":"Fasts › Jonah's Fast"}},{"id":"t2208-1","text":{"cop":"ⲛⲁϥⲭⲏ ϧⲉⲛ ⲑ̀ⲛⲉϫⲓ ⲙ̀ⲡⲓⲕⲏⲧⲟⲥ:","cop_lat":"nafkee khen ethneji empikeetos:","en":"was in the belly of the whale,","ar":"كان في بطن الحوت،"}},{"id":"t2208-2","text":{"cop":"ⲛ̀ϣⲟⲙⲧ (ⲅ̅) ⲛ̀ⲉ̀ϩⲟⲟⲩ ⲛⲉⲙ ϣⲟⲙⲧ ⲛ̀ⲉ̀ϫⲱⲣϩ:","cop_lat":"enshomt (shomt) enehoou nem shomt enegorh:","en":"for three days and three nights,","ar":"ثلاثة أيام وثلاث ليال،"}},{"id":"t2208-3","text":{"cop":"ⲕⲁⲧⲁ ⲡⲓⲕⲱⲥ ⲙ̀ⲡⲉⲛⲤⲱⲧⲏⲣ.","cop_lat":"kata pikos empensoteer.","en":"like the burial of our Savior.","ar":"كدفن مخلصنا."}},{"id":"t2208-4","text":{"cop":"+ Ⲁϥⲟⲩⲱⲣⲡ ⲙ̀ⲙⲟϥ ⲛ̀ϫⲉ Ⲡ̀ⲟ̅ⲥ̅ Ⲫ̀ϯ:","cop_lat":"+ Afoworp emmof enje Epshois Efnoti:","en":"+ The Lord God sent him,","ar":"أرسله الرب الإله،"}},{"id":"t2208-5","text":{"cop":"ϣⲁ ⲛⲓⲣⲱⲙⲓ ⲛ̀ⲧⲉ Ⲛⲓⲛⲉⲩⲏ̀:","cop_lat":"sha niromi ente Ninevee:","en":"to the people of Nineveh,","ar":"إلي رجال نينوى،"}},{"id":"t2208-6","text":{"cop":"ⲁϥϩⲓⲱⲓϣ ⲛⲱⲟⲩ ⲕⲁⲧⲁ ⲡⲉϥⲥⲁϫⲓ:","cop_lat":"afhioish noou kata pefsaji:","en":"he preached to them His word,","ar":"فكرز لهم،"}},{"id":"t2208-7","text":{"cop":"ⲟⲩⲟϩ ⲁⲩⲉⲣⲙⲉⲧⲁⲛⲟⲓⲛ.","cop_lat":"o-woh avermetanoin.","en":"and they repented.","ar":"كقوله فتابوا."}},{"id":"t2208-8","text":{"cop":"Ⲛ̀ϣⲟⲙⲧ ⲛ̀ⲉ̀ϩⲟⲟⲩ ⲛⲉⲙ ϣⲟⲙⲧ ⲛ̀ⲉ̀ϫⲱⲣϩ:","cop_lat":"Enshomt enehoou nem shomt enegorh:","en":"For three days and three nights,","ar":"ثلاثة أيام وثلاث ليال،"}},{"id":"t2208-9","text":{"cop":"ϧⲉⲛ ϩⲁⲛϣ̀ⲗⲏⲗ ⲛⲉⲙ ϩⲁⲛⲛⲏⲥⲧⲓⲁ:","cop_lat":"khen haneshleel nem hanneestia:","en":"they were in prayer and fasting,","ar":"بصلوات وأصوام،"}},{"id":"t2208-10","text":{"cop":"ⲛⲉⲙ ⲛⲓⲛⲁϩⲕⲓ ⲛⲉⲙ ⲛⲓⲉⲣⲙⲱⲟⲩⲓ̀:","cop_lat":"nem ninahki nem niermooui:","en":"with pain and tears,","ar":"مع التمخض والدموع،"}},{"id":"t2208-11","text":{"cop":"ⲛⲓϩⲁⲗⲁϯ ⲛⲉⲙ ⲛⲓⲧⲉⲃⲛⲱⲟⲩⲓ̀.","cop_lat":"nihalati nem nitevnooui.","en":"with the birds and animals.","ar":"وهكذا الطيور والبهائم."}},{"id":"t2208-12","text":{"cop":"+ Ⲁϥϣⲱⲡ ⲉ̀ⲣⲟϥ ⲛ̀ⲧⲟⲩⲙⲉⲧⲁⲛⲟⲓⲁ:","cop_lat":"+ Afshop erof entoumetanoia:","en":"+ God accepted their repentance,","ar":"فقبل الله،"}},{"id":"t2208-13","text":{"cop":"ⲛ̀ϫⲉ Ⲫ̀ϯ ⲟⲩⲟϩ ⲁϥⲛⲁⲓ ⲛⲱⲟⲩ:","cop_lat":"enje Efnoti o-woh afnai noou:","en":"and had mercy upon them,","ar":"توبتهم ورحمهم،"}},{"id":"t2208-14","text":{"cop":"ⲁϥⲱ̀ⲗⲓ ⲙ̀ⲡⲉϥϫⲱⲛⲧ ⲉ̀ⲃⲟⲗ ϩⲁⲣⲱⲟⲩ:","cop_lat":"afoli empefgont evol haroou:","en":"He lifted His anger away from them,","ar":"ورفع غضبه عنهم،"}},{"id":"t2208-15","text":{"cop":"ⲁϥⲭⲁ ⲛⲟⲩⲛⲟⲃⲓ ⲛⲱⲟ̀ⲩ ⲉ̀ⲃⲟⲗ.","cop_lat":"afka nounovi no-ou evol.","en":"and forgave them their sins.","ar":"وغفر لهم خطاياهم."}},{"id":"t2208-16","text":{"cop":"Ⲧⲉⲛⲧⲱⲃϩ ⲙ̀ⲙⲟⲕ ⲱ̀ ⲡⲓⲚⲁⲏⲧ:","cop_lat":"Tentovh emmok o pinaeet:","en":"We pray to You O merciful One,","ar":"نطلب إليك أيها الرحوم،"}},{"id":"t2208-17","text":{"cop":"ⲁ̀ⲣⲓⲟⲩⲓ̀ ⲛⲉⲙⲁⲛ ϧⲁ ⲛⲓⲣⲉϥⲉⲣⲛⲟⲃⲓ:","cop_lat":"arioui neman kha nirefernovi:","en":"deal with us the sinners,","ar":"أن تصنع معنا نحن الخطاة،"}},{"id":"t2208-18","text":{"cop":"ⲙ̀ⲫ̀ⲣⲏϯ ⲛ̀ⲛⲓⲣⲉⲙⲚⲓⲛⲉⲩⲏ̀:","cop_lat":"emefreeti enniremninevee:","en":"like the people of Nineveh,","ar":"مثل أهل نينوى،"}},{"id":"t2208-19","text":{"cop":"ⲛⲁⲓ ⲛⲁⲛ ⲕⲁⲧⲁ ⲡⲉⲕⲛⲓϣϯ ⲛ̀ⲛⲁⲓ.","cop_lat":"nai nan kata peknishti ennai.","en":"have mercy upon us according to Your great mercy.","ar":"وارحمنا كعظيم رحمتك."}},{"id":"t2208-20","text":{"cop":"+ Ϫⲉ ⲛ̀ⲑⲟⲕ ⲟⲩⲚⲟⲩϯ ⲛ̀ⲛⲁⲏⲧ:","cop_lat":"+ Je enthok ounoti ennaeet:","en":"+ For You are a merciful God,","ar":"لأنك أنت إله رحوم،"}},{"id":"t2208-21","text":{"cop":"ⲡⲓⲙⲏϣ ⲛ̀ⲛⲁⲓ ⲛ̀ⲣⲉϥϣⲉⲛϩⲏⲧ:","cop_lat":"pimeesh ennai enrefshenheet:","en":"of great compassion,","ar":"كثير الرحمة،"}},{"id":"t2208-22","text":{"cop":"ⲟⲩⲟϩ ⲡⲓⲢⲉϥⲱ̀ⲟⲩⲛ̀ϩⲏⲧ:","cop_lat":"o-woh pirefoou-enheet:","en":"and full of patience,","ar":"متحنن وطويل الأناة،"}},{"id":"t2208-23","text":{"cop":"ⲡⲓⲘⲁⲓⲣⲱⲙⲓ ⲛ̀ⲁ̀ⲅⲁⲑⲟⲥ.","cop_lat":"pimairomi enaghathos.","en":"the good Lover of mankind.","ar":"محب البشر الصالح."}},{"id":"t2208-24","text":{"cop":"Ϫⲉ ⲭ̀ⲟⲩⲱϣ ⲙ̀ⲫ̀ⲙⲟⲩ ⲁⲛ ⲙ̀ⲡⲓⲣⲉϥⲉⲣⲛⲟⲃⲓ:","cop_lat":"Je ekowosh emefmou an empirefernovi:","en":"For You do not desire the death of a sinner,","ar":"لأنك لا تشاء موت الخاطئ،"}},{"id":"t2208-25","text":{"cop":"ⲙ̀ⲫ̀ⲣⲏϯ ⲛ̀ⲧⲉϥⲕⲟⲧϥ ⲟⲩⲟϩ ⲛ̀ⲧⲉϥⲱⲛϧ:","cop_lat":"emefreeti entefkotf o-woh entefonkh:","en":"rather he returns and lives,","ar":"مثل أن يرجع ويحيا،"}},{"id":"t2208-26","text":{"cop":"ϣⲟⲡⲧⲉⲛ ⲉ̀ⲣⲟⲕ ⲟⲩⲟϩ ⲛⲁⲓ ⲛⲁⲛ:","cop_lat":"shopten erok o-woh nai nan:","en":"accept us and have mercy on us,","ar":"إقبلنا إليك وإرحمنا،"}},{"id":"t2208-27","text":{"cop":"ⲭⲱ ⲛⲁⲛ ⲉ̀ⲃⲟⲗ ⲛ̀ⲛⲉⲛⲛⲟⲃⲓ.","cop_lat":"ko nan evol ennennovi.","en":"and forgive us our sins.","ar":"واغفر لنا خطايانا."}},{"id":"t2208-28","text":{"cop":"+ Ⲧⲱⲃϩ ⲙ̀Ⲡ̀ⲟ̅ⲥ̅ ⲉ̀ϩ̀ⲣⲏⲓ ⲉ̀ϫⲱⲛ:","cop_lat":"+ Tovh emepshois e-ehree egon:","en":"+ Pray to the Lord on our behalf,","ar":"أطلب من الرب عنا،"}},{"id":"t2208-29","text":{"cop":"ⲱ̀ ⲡⲓⲣⲉϥϩⲓⲱⲓϣ ⲛ̀ⲧⲉ ⲛⲓⲣⲉⲙⲚⲓⲛⲉⲩⲏ̀:","cop_lat":"o pirefhioish ente niremninevee:","en":"O preacher of the Ninevites,","ar":"أيها الكاروز لأهل نينوي،"}},{"id":"t2208-30","text":{"cop":"Ⲓⲱⲛⲁ ⲡⲓⲡ̀ⲣⲟⲫⲏⲧⲏⲥ:","cop_lat":"Yona pi-eprofeetees:","en":"Jonah the prophet,","ar":"يونان النبي،"}},{"id":"t2208-31","text":{"cop":"ⲛ̀ⲧⲉϥⲭⲁ ⲛⲉⲛⲛⲟⲃⲓ ⲛⲁⲛ ⲉ̀ⲃⲟⲗ.","cop_lat":"entefka nennovi nan evol.","en":"that He may forgive us our sins.","ar":"ليغفر لنا خطايانا."}},{"id":"t2209-0","text":{"cop":"Ⲙⲁⲧⲟⲩⲃⲟⲛ Ⲡ̀ⲟ̅ⲥ̅ ⲉ̀ⲃⲟⲗϧⲉⲛ ⲡⲓⲭ̀ⲣⲟϥ:","cop_lat":"Matouvon Epshois evolkhen pi-ekrof:","en":"Purify us O Lord from the deception,","ar":"طهرنا يا رب من المكر،"},"section":{"en":"Gospel Response - Thursday Matins, Ⲙⲁⲧⲟⲩⲃⲟⲛ Ⲡ̀ⲟ̅ⲥ̅","path":"Fasts › Jonah's Fast"}},{"id":"t2209-1","text":{"cop":"ⲛ̀ⲧⲉ ⲡⲓⲁⲧϣⲉⲙⲏⲣ ⲛ̀ⲛⲓⲥⲁⲇⲟⲕⲉⲟⲥ:","cop_lat":"ente piatshemeer ennisathokeos:","en":"of the leaven of the Sadducees,","ar":"الذي لخمير الصدوقيين،"}},{"id":"t2209-2","text":{"cop":"ϫⲉ ⲁⲛⲕⲁϯ ⲉ̀ⲛⲉⲕϣ̀ⲫⲏⲣⲓ:","cop_lat":"je ankati enekeshfeeri:","en":"for we understand Your wonders,","ar":"لأننا فهمنا عجائبك،"}},{"id":"t2209-3","text":{"cop":"ⲟⲩⲟϩ ⲁ̀ⲛⲛⲁϩϯ ⲉ̀ⲧⲉⲕⲙⲉⲧⲟ̅ⲥ̅.","cop_lat":"o-woh annahti etekmetshois.","en":"and we believe in Your lordship.","ar":"وأمنا بربوبيتك."}},{"id":"t2210-0","text":{"cop":"Ϫⲉ ⲡⲉⲛⲟ̅ⲥ̅ Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅:","cop_lat":"Je penshois Ieesous Pi-ekhristos:","en":"O our Lord Jesus Christ,","ar":"يا ربنا يسوع المسيح،"},"section":{"en":"Gospel Response - Thursday Liturgy, Ϫⲉ ⲡⲉⲛⲟ̅ⲥ̅ Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅","path":"Fasts › Jonah's Fast"}},{"id":"t2210-1","text":{"cop":"ⲙⲁⲑⲁⲙⲓⲟ ⲛⲁⲕ ⲛ̀ϧ̀ⲣⲏⲓ ⲛ̀ϧⲏⲧⲉⲛ:","cop_lat":"mathamio nak enekhree enkheeten:","en":"make in us a sanctuary,","ar":"إجعل لك فينا هيكلاً،"}},{"id":"t2210-2","text":{"cop":"ⲛ̀ⲟⲩⲉⲣⲫⲉⲓ ⲛ̀ⲧⲉ Ⲡⲉⲕⲡ̀ⲛⲉⲩⲙⲁ ⲉ̅ⲑ̅ⲩ̅:","cop_lat":"enowerfei ente Pekepnevma ethowab:","en":"for Your Holy Spirit,","ar":"لروحك القدوس،"}},{"id":"t2210-3","text":{"cop":"ⲉⲩϯⲇⲟⲝⲟⲗⲟⲅⲓⲁ ⲛⲁⲕ.","cop_lat":"evtithoksologia nak.","en":"ever-glorifying You.","ar":"يعطيك تمجيداً."}},{"id":"t2359-1","text":{"cop":"Ⲁ̀ⲙⲏⲛ:","cop_lat":"Ameen:","en":"Amen,","ar":"آمين،"},"section":{"en":"Matins Conlusion - Amen Alleluia, Ⲁ̀ⲙⲏⲛ ⲁⲗⲗⲏⲗⲟⲩⲓⲁ","path":"Fasts › Jonah's Fast"}},{"id":"t2359-2","text":{"cop":"ⲁ̅ⲗ̅.","cop_lat":"alleelouia.","en":"Alleluia.","ar":"هلليلويا."}},{"id":"t2359-3","text":{"cop":"Ⲇⲟⲝⲁ Ⲡⲁⲧⲣⲓ ⲕⲉ Ⲩ̀ⲓⲱ ⲕⲉ Ⲁ̀ⲅⲓⲱ Ⲡ̀ⲛⲉⲩⲙⲁⲧⲓ:","cop_lat":"Thoksa Patri ke I-io ke Agio Epnevmati:","en":"Glory be to the Father and the Son and the Holy Spirit,","ar":"المجد للآب والإبن والروح القدس،"}},{"id":"t2359-4","text":{"cop":"ⲕⲉ ⲛⲩⲛ ⲕⲉ ⲁ̀ⲓ̀ ⲕⲉ ⲓⲥ ⲧⲟⲩⲥ ⲉ̀ⲱ̀ⲛⲁⲥ ⲧⲱⲛ ⲉ̀ⲱ̀ⲛⲱⲛ:","cop_lat":"ke nin ke a-i ke is tous e-onas ton e-onon:","en":"now and ever and unto the age of all ages,","ar":"الآن وكل أوان وإلى دهر الدهور،"}},{"id":"t2359-5","text":{"cop":"ⲁ̀ⲙⲏⲛ.","cop_lat":"ameen.","en":"Amen.","ar":"آمين."}},{"id":"t2359-6","text":{"cop":"Ⲧⲉⲛⲱϣ ⲉ̀ⲃⲟⲗ ⲉⲛϫⲱ ⲙ̀ⲙⲟⲥ:","cop_lat":"Tenosh evol engo emmos:","en":"We proclaim saying:","ar":"نصرخ قائلين:"}},{"id":"t2359-7","text":{"cop":"ϫⲉ ⲱ̀ ⲡⲉⲛⲟ̅ⲥ̅ Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅.","cop_lat":"je o penshois Ieesous Pi-ekhristos.","en":"O our Lord Jesus Christ.","ar":"يا ربنا يسوع المسيح."}},{"id":"t2359-8","text":{"cop":"Ⲱ̀ ⲫⲏⲉ̀ⲧⲁϥⲁ̀ⲣⲉϩ ⲉ̀Ⲓⲱⲛⲁⲥ ⲉⲩⲭⲏ ϧⲉⲛ ⲑ̀ⲛⲉϫⲓ ⲙ̀ⲡⲓⲕⲓⲧⲟⲥ.","cop_lat":"O fee-etafareh eyonas evkee khen ethneji empikitos.","en":"O You who kept Jonah in the belly of the whale.","ar":"يا مَنْ حفظ يونان في بطن الحوت."}},{"id":"t2359-9","text":{"cop":"Ⲥⲱϯ ⲙ̀ⲙⲟⲛ ⲟⲩⲟϩ ⲛⲁⲓ ⲛⲁⲛ.","cop_lat":"Soti emmon o-woh nai nan.","en":"Save us and have mercy upon us.","ar":"خلصنا وإرحمنا."}},{"id":"t2359-10","text":{"cop":"Ⲕⲩⲣⲓⲉ ⲉ̀ⲗⲉⲏⲥⲟⲛ:","cop_lat":"Kirie ele-eeson:","en":"Lord have mercy,","ar":"يا رب إرحم،"}},{"id":"t2359-11","text":{"cop":"Ⲕⲩⲣⲓⲉ ⲉ̀ⲗⲉⲏⲥⲟⲛ:","cop_lat":"Kirie ele-eeson:","en":"Lord have mercy,","ar":"يا رب إرحم،"}},{"id":"t2359-12","text":{"cop":"Ⲕⲩⲣⲓⲉ ⲉⲩⲗⲟⲅⲏⲥⲟⲛ ⲁ̀ⲙⲏⲛ.","cop_lat":"Kirie evlogeeson ameen.","en":"Lord bless Amen.","ar":"يا رب بارك آمين."}},{"id":"t2359-13","text":{"cop":"Ⲥ̀ⲙⲟⲩ ⲉ̀ⲣⲟⲓ:","cop_lat":"Esmou eroi:","en":"Bless me,","ar":"باركوا عليَّ،"}},{"id":"t2359-14","text":{"cop":"ⲥ̀ⲙⲟⲩ ⲉ̀ⲣⲟⲓ:","cop_lat":"esmou eroi:","en":"bless me,","ar":"باركوا عليَّ،"}},{"id":"t2359-15","text":{"cop":"ⲓⲥ ϯⲙⲉⲧⲁⲛⲟⲓⲁ:","cop_lat":"is timetanoia:","en":"behold the repentance,","ar":"ها مطانية،"}},{"id":"t2359-16","text":{"cop":"ⲭⲱ ⲛⲏⲓ ⲉ̀ⲃⲟⲗ:","cop_lat":"ko nee evol:","en":"forgive me,","ar":"إغفروا لي،"}},{"id":"t2359-17","text":{"cop":"ϫⲱ ⲙ̀ⲡⲓⲥ̀ⲙⲟⲩ.","cop_lat":"go empi-esmou.","en":"say the blessing.","ar":"قُل البركة."}},{"id":"t2207-0","text":{"cop":"Ϩⲓⲧⲉⲛ ⲛⲓⲉⲩⲭⲏ:","cop_lat":"Hiten nievshee:","en":"Through the prayers,","ar":"بصلوات،"},"section":{"en":"Heteni, Ϩⲓⲧⲉⲛ ⲛⲓⲉⲩⲭⲏ","path":"Fasts › Jonah's Fast"}},{"id":"t2207-1","text":{"cop":"ⲛ̀ⲧⲉ ⲡⲓⲣⲉϥϩⲓⲱⲓϣ ⲛ̀ⲧⲉ ⲛⲓⲣⲉⲙⲚⲓⲛⲉⲩⲏ̀:","cop_lat":"ente pirefhioish ente niremninevee:","en":"of the preacher of the Ninevites,","ar":"الكاروز لأهل نينوي،"}},{"id":"t2207-2","text":{"cop":"Ⲓⲱⲛⲁ ⲡⲓⲡ̀ⲣⲟⲫⲏⲧⲏⲥ:","cop_lat":"Yona pi-eprofeetees:","en":"Jonah the prophet,","ar":"يونان النبي،"}},{"id":"t2207-3","text":{"cop":"Ⲡ̀ⲟ̅ⲥ̅ ⲁ̀ⲣⲓϩ̀ⲙⲟⲧ ⲛⲁⲛ ⲙ̀ⲡⲓⲭⲱ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲛⲉⲛⲛⲟⲃⲓ.","cop_lat":"Epshois ari-ehmot nan empiko evol ente nennovi.","en":"O Lord grant us the forgiveness of our sins.","ar":"يا رب أنعم علينا بمغفرة خطايانا."}},{"id":"t268-0","text":{"cop":"Ⲓⲱⲛⲁ ϧⲉⲛ ⲑ̀ⲛⲉϫⲓ ⲙ̀ⲡⲓⲕⲓⲧⲟⲥ ⲕⲁⲧⲁ ⲡ̀ⲧⲩⲡⲟⲥ:","cop_lat":"Yona khen ethneji empikitos kata eptipos:","en":"Jonah in the belly of the whale,","ar":"يونان في بطن الحوت كمثال،"},"section":{"en":"Psalm 150 Response, Ⲓⲱⲛⲁ ϧⲉⲛ ⲑ̀ⲛⲉϫⲓ","path":"Fasts › Jonah's Fast"}},{"id":"t268-1","text":{"cop":"ⲙ̀Ⲡⲭ̅ⲥ̅ ϧⲉⲛ ⲡⲓⲙ̀ϩⲁⲩ ⲛ̀ϣⲟⲙⲧ ⲛ̀ⲉ̀ϩⲟⲟⲩ. -","cop_lat":"empi-ekhristos khen pi-emhav enshomt enehoou. -","en":"likewise Christ in the tomb three days.","ar":"المسيح في القبر ثلاثة أيام."}},{"id":"t268-3","text":{"cop":"Ⲱ̀ ⲫⲏⲉ̀ⲧⲁϥⲁ̀ⲣⲉϩ ⲉ̀Ⲓⲱⲛⲁⲥ ⲉⲩⲭⲏ ϧⲉⲛ ⲑ̀ⲛⲉϫⲓ ⲙ̀ⲡⲓⲕⲓⲧⲟⲥ.","cop_lat":"O fee-etafareh eyonas evkee khen ethneji empikitos.","en":"O You who kept (preserved/guarded) Jonah in the belly of the whale.","ar":"يا مَنْ حفظ يونان في بطن الحوت."}}]}