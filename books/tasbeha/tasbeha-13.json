{"title":"Other Liturgical & Sacramental Services › Holy Matrimony - Crowning Ceremony","source":"tasbeha.org hymn library","languages":{"en":"English","cop":"Ⲙⲉⲧⲣⲉⲙⲛ̀ⲭⲏⲙⲓ","cop_lat":"Coptic (Latin letters)","ar":"عربي"},"roles":{"priest":{"en":"Priest","de":"Priester","ar":"الكاهن","cop":"Ⲡⲓⲟⲩⲏⲃ"},"deacon":{"en":"Deacon","de":"Diakon","ar":"الشماس","cop":"Ⲡⲓⲇⲓⲁⲕⲱⲛ"},"people":{"en":"People","de":"Gemeinde","ar":"الشعب","cop":"Ⲡⲓⲗⲁⲟⲥ"}},"paragraphs":[{"id":"t1452-0","text":{"cop":"Ϯⲥ̀ⲧⲟⲗⲏ ⲙ̀ⲡ̀ⲛⲉⲩⲙⲁⲧⲓⲕⲟⲛ:","cop_lat":"Ti-estolee emepnevmatikon:","en":"The spiritual garment,","ar":"الحُلة الروحانية،"},"section":{"en":"The spiritual garment (Al-hola), Ϯⲥ̀ⲧⲟⲗⲏ ⲙ̀ⲡ̀ⲛⲉⲩⲙⲁⲧⲓⲕⲟⲛ","path":"Other Liturgical & Sacramental Services › Holy Matrimony - Crowning Ceremony"}},{"id":"t1452-1","text":{"cop":"ⲁⲩϯϩⲓⲱⲧϥ ⲙ̀Ⲙⲓⲭⲁⲏⲗ:","cop_lat":"avtihiotf emmikhaeel:","en":"with which Michael is arrayed,","ar":"المُلتحف بها ميخائيل،"}},{"id":"t1452-2","text":{"cop":"ⲟⲩⲟϩ ⲡⲓϧⲱⲕ ⲙ̀ⲙⲁⲣⲅⲁⲣⲓⲧⲏⲥ:","cop_lat":"o-woh pikhok emmargharitees:","en":"and the girdle of pearls,","ar":"والمَنطَقة الجوهرية،"}},{"id":"t1452-3","text":{"cop":"ⲁⲩⲙⲏⲣ ⲙ̀Ⲙⲓⲭⲁⲏⲗ ⲙ̀ⲙⲟϥ.","cop_lat":"avmeer emmikhaeel emmof.","en":"with which Michael is adorned.","ar":"تمنطق بها ميخائيل."}},{"id":"t1452-4","text":{"cop":"Ϯⲥ̀ⲧⲟⲗⲏ ⲛ̀ⲟⲩⲥⲱⲫⲣⲟⲥⲩⲛⲏ ⲁⲩⲧⲏⲓⲥ ⲉ̀ϫⲉⲛ ⲡⲁⲓϣⲉⲗⲉⲧ:","cop_lat":"Ti-estolee enousofrosinee avteeis ejen paishelet:","en":"The garment of chastity, was given to this bridegroom,","ar":"حُلَّة العفاف، أُعطيت لهذا العريس،"}},{"id":"t1452-5","text":{"cop":"ⲟⲩⲟϩ ⲡⲓⲭ̀ⲗⲟⲙ ⲛ̀ⲧⲉ ⲡ̀ⲑⲉⲗⲏⲗ:","cop_lat":"o-woh pi-eklom ente eptheleel:","en":"and the crown of gladness,","ar":"وإكليل البهجة،"}},{"id":"t1452-6","text":{"cop":"ⲁⲩⲧⲏⲓϥ ⲉ̀ϫⲉⲛ ⲧⲉϥⲁ̀ⲫⲉ.","cop_lat":"avteeif ejen tefafe.","en":"is set upon his head.","ar":"وُضع على رأسه."}},{"id":"t1452-7","text":{"cop":"Ⲕⲁⲧⲁ ⲫ̀ⲣⲏϯ ⲉ̀ⲧⲁϥϫⲟⲥ:","cop_lat":"Kata efreeti etafgos:","en":"As David the hymnist,","ar":"مثل الذي قاله،"}},{"id":"t1452-8","text":{"cop":"ⲛ̀ϫⲉ Ⲇⲁⲩⲓⲇ ⲡⲓϩⲩⲙⲛⲟⲇⲟⲥ:","cop_lat":"enje David pihimnothos:","en":"has said,","ar":"داود المرتل،"}},{"id":"t1452-9","text":{"cop":"ϫⲉ ⲟⲩⲱ̀ⲟⲩ ⲛⲉⲙ ⲟⲩⲧⲁⲓⲟ:","cop_lat":"je o-oou nem outaio:","en":"“Glory and honor,","ar":"\"مجداً وكرامة،"}},{"id":"t1452-10","text":{"cop":"ⲁⲕⲧⲏⲓⲧⲟⲩ ⲛ̀ⲟⲩⲭ̀ⲗⲟⲙ ⲉ̀ϫⲱϥ.","cop_lat":"akteeitou enou-eklom egof.","en":"You have made a crown upon him.”","ar":"جعلتها تاجاً عليه.\""}},{"id":"t1452-11","text":{"cop":"Ⲁⲕⲉⲣϣⲟⲣⲡ ⲉ̀ⲣⲟϥ:","cop_lat":"Akershorp erof:","en":"You have overtaken him,","ar":"أدركته،"}},{"id":"t1452-12","text":{"cop":"ϧⲉⲛ ⲡⲓⲥ̀ⲙⲟⲩ ⲛ̀ⲧⲉ ⲧⲉⲕⲙⲉⲧⲭ̀ⲣⲏⲥⲧⲟⲥ:","cop_lat":"khen pi-esmou ente tekmetekhreestos:","en":"with the blessing of Your goodness,","ar":"ببركة صلاحك،"}},{"id":"t1452-13","text":{"cop":"ⲁⲕⲭⲱ ϩⲓϫⲱϥ ⲛ̀ⲟⲩⲭ̀ⲗⲟⲙ:","cop_lat":"akko higof enou-eklom:","en":"You have set upon him,","ar":"ووضعت على رأسه إكليلاً،"}},{"id":"t1452-14","text":{"cop":"ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲟⲩⲱ̀ⲛⲓ ⲉϥⲧⲁⲓⲏ̀ⲟⲩⲧ.","cop_lat":"evol khen o-oni eftai-eeout.","en":"a crown of precious stones.","ar":"من حجرٍ كريم."}},{"id":"t1452-15","text":{"cop":"Ⲁϥⲉ̀ⲣⲉⲧⲓⲛ ⲙ̀ⲙⲟⲕ ⲛ̀ⲟⲩⲱⲛϧ Ⲡ̀ϭⲟⲓⲥ:","cop_lat":"Aferetin emmok enowonkh Epshois:","en":"He asked life of You O Lord,","ar":"سألك حياة يا رب،"}},{"id":"t1452-16","text":{"cop":"ⲟⲩⲟϩ ⲁⲕⲧⲏⲓϥ ⲛⲁϥ:","cop_lat":"o-woh akteeif naf:","en":"and You have given him,","ar":"فأعطيته،"}},{"id":"t1452-17","text":{"cop":"ⲫ̀ⲟⲩⲉⲓ ⲛ̀ⲧⲉ ϩⲁⲛⲉ̀ϩⲟⲟⲩ:","cop_lat":"efowei ente hanehoou:","en":"the length of days,","ar":"طول الأيام،"}},{"id":"t1452-18","text":{"cop":"ϣⲁ ⲉ̀ⲛⲉϩ ⲛ̀ⲧⲉ ⲡⲓⲉ̀ⲛⲉϩ ⲁ̀ⲙⲏⲛ.","cop_lat":"sha eneh ente pi-eneh ameen.","en":"forever and ever amen.","ar":"إلى أبد الآبدين آمين."}},{"id":"t1445-1","text":{"cop":"Ⲡ̀ⲟⲩⲣⲟ ⲛ̀ⲧⲉ ϯϩⲓⲣⲏⲛⲏ:","cop_lat":"Epouro ente tihireenee:","en":"O King of peace,","ar":"يا ملك السلام،"},"section":{"en":"The Procession","path":"Other Liturgical & Sacramental Services › Holy Matrimony - Crowning Ceremony"}},{"id":"t1445-2","text":{"cop":"ⲙⲟⲓ ⲛⲁⲛ ⲛ̀ⲧⲉⲕϩⲓⲣⲏⲛⲏ:","cop_lat":"moi nan entekhireenee:","en":"grant us Your peace,","ar":"أعطنا سلامك،"}},{"id":"t1445-3","text":{"cop":"ⲥⲉⲙⲛⲓ ⲛⲁⲛ ⲛ̀ⲧⲉⲕϩⲓⲣⲏⲛⲏ:","cop_lat":"semni nan entekhireenee:","en":"establish for us Your peace,","ar":"قرر لنا سلامك،"}},{"id":"t1445-4","text":{"cop":"ⲭⲁ ⲛⲉⲛⲛⲟⲃⲓ ⲛⲁⲛ ⲉ̀ⲃⲟⲗ.","cop_lat":"ka nennovi nan evol.","en":"and forgive us our sins.","ar":"وإغفر لنا خطايانا."}},{"id":"t1445-5","text":{"cop":"Ϫⲱⲣ ⲉ̀ⲃⲟⲗ ⲛ̀ⲛⲓϫⲁϫⲓ:","cop_lat":"Gor evol ennigaji:","en":"Disperse the enemies,","ar":"فرِّق أعداء الكنيسة،"}},{"id":"t1445-6","text":{"cop":"ⲛ̀ⲧⲉ Ϯⲉⲕⲕⲗⲏⲥⲓⲁ:","cop_lat":"ente Tiekkleesia:","en":"of the Church,","ar":"وحصنها،"}},{"id":"t1445-7","text":{"cop":"ⲁ̀ⲣⲓⲥⲟⲃⲧ ⲉ̀ⲣⲟⲥ:","cop_lat":"arisovt eros:","en":"and fortify her that she,","ar":"فلا تتزعزع،"}},{"id":"t1445-8","text":{"cop":"ⲛ̀ⲛⲉⲥⲕⲓⲙ ϣⲁ ⲉ̀ⲛⲉϩ.","cop_lat":"enneskim sha eneh.","en":"may not be shaken forever.","ar":"إلى الأبد."}},{"id":"t1445-9","text":{"cop":"Ⲉⲙⲙⲁⲛⲟⲩⲏⲗ Ⲡⲉⲛⲛⲟⲩϯ:","cop_lat":"Emmanoweel Pennoti:","en":"Emmanuel our God,","ar":"عمانوئيل إلهنا،"}},{"id":"t1445-10","text":{"cop":"ϧⲉⲛ ⲧⲉⲛⲙⲏϯ ϯⲛⲟⲩ:","cop_lat":"khen tenmeeti tinou:","en":"is now in our midst,","ar":"في وسطنا الآن،"}},{"id":"t1445-11","text":{"cop":"ϧⲉⲛ ⲡ̀ⲱ̀ⲟⲩ ⲛ̀ⲧⲉ Ⲡⲉϥⲓⲱⲧ:","cop_lat":"khen epoou ente Pefiot:","en":"with the glory of His Father,","ar":"بمجد أبيه،"}},{"id":"t1445-12","text":{"cop":"ⲛⲉⲙ Ⲡⲓⲡ̀ⲛⲉⲩⲙⲁ Ⲉⲑⲟⲩⲁⲃ.","cop_lat":"nem Pi-epnevma Ethowab.","en":"and the Holy Spirit.","ar":"والروح القدس."}},{"id":"t1445-13","text":{"cop":"Ⲛ̀ⲧⲉϥⲥ̀ⲙⲟⲩ ⲉ̀ⲣⲟⲛ ⲧⲏⲣⲉⲛ:","cop_lat":"Entefesmou eron teeren:","en":"May He bless us all,","ar":"ليباركنا كلنا،"}},{"id":"t1445-14","text":{"cop":"ⲛ̀ⲧⲉϥⲧⲟⲩⲃⲟ ⲛ̀ⲛⲉⲛϩⲏⲧ:","cop_lat":"enteftouvo ennenheet:","en":"and purify our hearts,","ar":"ويطهر قلوبنا،"}},{"id":"t1445-15","text":{"cop":"ⲛ̀ⲧⲉϥⲧⲁⲗϭⲟ ⲛ̀ⲛⲓϣⲱⲛⲓ:","cop_lat":"enteftalcho ennishoni:","en":"and heal the sicknesses,","ar":"ويشفي أمراض،"}},{"id":"t1445-16","text":{"cop":"ⲛ̀ⲧⲉ ⲛⲉⲛⲯⲩⲭⲏ ⲛⲉⲙ ⲛⲉⲛⲥⲱⲙⲁ.","cop_lat":"ente nenpsishee nem nensoma.","en":"of our souls and bodies.","ar":"نفوسنا وأجسادنا."}},{"id":"t1445-17","text":{"cop":"Ⲧⲉⲛⲟⲩⲱϣⲧ ⲙ̀ⲙⲟⲕ ⲱ̀ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ:","cop_lat":"Tenowosht emmok o Pi-ekhristos:","en":"We worship You O Christ,","ar":"نسجد لك أيها المسيح،"}},{"id":"t1445-18","text":{"cop":"ⲛⲉⲙ Ⲡⲉⲕⲓⲱⲧ ⲛ̀ⲁ̀ⲅⲁⲑⲟⲥ:","cop_lat":"nem Pekiot enaghathos:","en":"with Your good Father,","ar":"مع إبيك الصالح،"}},{"id":"t1445-19","text":{"cop":"ⲛⲉⲙ Ⲡⲓⲡ̀ⲛⲉⲩⲙⲁ ⲉⲑⲟⲩⲁⲃ:","cop_lat":"nem Pi-epnevma ethowab:","en":"and the Holy Spirit,","ar":"والروح القدس،"}},{"id":"t1445-20","text":{"cop":"ϫⲉ (ⲁⲕⲧⲱⲛⲕ) ⲁⲕⲥⲱϯ ⲙ̀ⲙⲟⲛ. - -","cop_lat":"je (aktonk) aksoti emmon. - -","en":"for You have (risen) and saved us.","ar":"لأنك (قُمتَ) وخلصتنا."}},{"id":"t1445-23","text":{"cop":"Ⲭⲉⲣⲉ ⲛⲉ Ⲙⲁⲣⲓⲁ:","cop_lat":"Shere ne Maria:","en":"Hail to you Mary,","ar":"السلام لكِ يا مريم،"}},{"id":"t1445-24","text":{"cop":"ϯϭⲣⲟⲙⲡⲓ ⲉⲑⲛⲉⲥⲱⲥ:","cop_lat":"tichrompi ethnesos:","en":"the beautiful dove,","ar":"الحمامة الحسنة،"}},{"id":"t1445-25","text":{"cop":"ⲑⲏⲉ̀ⲧⲁⲥⲙⲓⲥⲓ ⲛⲁⲛ:","cop_lat":"thee-etasmisi nan:","en":"who gave birth to,","ar":"التي ولدِت لنا،"}},{"id":"t1445-26","text":{"cop":"ⲙ̀Ⲫ̀ⲛⲟⲩϯ Ⲡⲓⲗⲟⲅⲟⲥ.","cop_lat":"emefnoti Piloghos.","en":"God the Word.","ar":"الله الكلمة."}},{"id":"t1445-27","text":{"cop":"+ Ⲛ̀ⲑⲟ ⲧⲉ ϯϩ̀ⲣⲏⲣⲓ:","cop_lat":"+ Entho te ti-ehreeri:","en":"+ You are the flower,","ar":"+ أنتِ زهرة،"}},{"id":"t1445-28","text":{"cop":"ⲛ̀ⲧⲉ ⲡⲓⲥ̀ⲑⲟⲓⲛⲟⲩϥⲓ:","cop_lat":"ente pi-estoinoufi:","en":"of incense,","ar":"البخور التي،"}},{"id":"t1445-29","text":{"cop":"ⲑⲏⲉ̀ⲧⲁⲥⲫⲓⲣⲓ ⲉ̀ⲃⲟⲗ:","cop_lat":"thee-etasfiri evol:","en":"that has blossomed,","ar":"أينعت من،"}},{"id":"t1445-30","text":{"cop":"ϧⲉⲛ ⲑ̀ⲛⲟⲩⲛⲓ ⲛ̀Ⲓⲉⲥⲥⲉ.","cop_lat":"khen ethnouni enyesse.","en":"from the root of Jesse.","ar":"أصل يسَّى."}},{"id":"t1445-31","text":{"cop":"Ⲡⲓϣ̀ⲃⲱⲧ ⲛ̀ⲧⲉ Ⲁ̀ⲁ̀ⲣⲱⲛ:","cop_lat":"Pi-eshvot ente A-aron:","en":"The rod of Aaron,","ar":"عصا هرون،"}},{"id":"t1445-32","text":{"cop":"ⲉ̀ⲧⲁϥⲫⲓⲣⲓ ⲉ̀ⲃⲟⲗ:","cop_lat":"etaffiri evol:","en":"which blossomed,","ar":"التي أزهرت،"}},{"id":"t1445-33","text":{"cop":"ⲭⲱⲣⲓⲥ ϭⲟ ⲛⲉⲙ ⲧ̀ⲥⲟ:","cop_lat":"khoris cho nem etso:","en":"without planting or watering,","ar":"بغير غرس ولا سقي،"}},{"id":"t1445-34","text":{"cop":"ϥ̀ⲟⲓ ⲛ̀ⲧⲩⲡⲟⲥ ⲛⲉ.","cop_lat":"efoi entipos ne.","en":"resembles you.","ar":"هي مثال لكِ."}},{"id":"t1445-35","text":{"cop":"+ Ⲱ̀ ⲑⲏⲉ̀ⲧⲁⲥⲙⲉⲥ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ:","cop_lat":"+ O thee-etasmes Pi-ekhristos:","en":"+ O who gave birth to Christ,","ar":"+ يا مَنْ ولدِت المسيح،"}},{"id":"t1445-36","text":{"cop":"Ⲡⲉⲛⲛⲟⲩϯ ϧⲉⲛ ⲟⲩⲙⲉⲑⲙⲓ:","cop_lat":"Pennoti khen oumethmi:","en":"our true God,","ar":"إلهنا بالحقيقة،"}},{"id":"t1445-37","text":{"cop":"ⲁϭⲛⲉ ⲥ̀ⲡⲉⲣⲙⲁ ⲛ̀ⲣⲱⲙⲓ:","cop_lat":"achne esperma enromi:","en":"without the seed of man,","ar":"وبغير زرع بشر،"}},{"id":"t1445-38","text":{"cop":"ⲉⲥⲟⲓ ⲙ̀ⲡⲁⲣⲑⲉⲛⲟⲥ.","cop_lat":"esoi emparthenos.","en":"and remained a virgin.","ar":"وأنتِ عذراء."}},{"id":"t1445-39","text":{"cop":"Ⲉⲑⲃⲉ ⲫⲁⲓ ⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ:","cop_lat":"Ethve fai o-on niven:","en":"Wherefore everyone,","ar":"من أجل هذا،"}},{"id":"t1445-40","text":{"cop":"ⲥⲉϭⲓⲥⲓ ⲙ̀ⲙⲟ:","cop_lat":"sechisi emmo:","en":"magnifies you,","ar":"كل واحد يعظمِك،"}},{"id":"t1445-41","text":{"cop":"ⲧⲁϭⲟⲓⲥ Ϯⲑⲉⲟ̀ⲧⲟⲕⲟⲥ:","cop_lat":"tashois Tithe-otokos:","en":"O my Lady the Mother of God,","ar":"يا سيدتي والدة الإله،"}},{"id":"t1445-42","text":{"cop":"ⲉⲑⲟⲩⲁⲃ ⲛ̀ⲥⲏⲟⲩ ⲛⲓⲃⲉⲛ.","cop_lat":"ethowab enseeou niven.","en":"the ever-holy.","ar":"القديسة كل حين."}},{"id":"t1445-43","text":{"cop":"+ Ⲁ̀ⲛⲟⲛ ϩⲱⲛ ⲧⲉⲛⲧⲱⲃϩ:","cop_lat":"+ Anon hon tentovh:","en":"+ And we too,","ar":"+ ونحن أيضاً نطلب،"}},{"id":"t1445-44","text":{"cop":"ⲉⲑⲣⲉⲛϣⲁϣⲛⲓ ⲉⲩⲛⲁⲓ:","cop_lat":"ethrenshashni evnai:","en":"hope to win mercy,","ar":"أن نفوز برحمةٍ،"}},{"id":"t1445-45","text":{"cop":"ϩⲓⲧⲉⲛ ⲛⲉⲡ̀ⲣⲉⲥⲃⲓⲁ:","cop_lat":"hiten ne-epresvia:","en":"through your intercessions,","ar":"بشفاعاتِك،"}},{"id":"t1445-46","text":{"cop":"ⲛ̀ⲧⲟⲧϥ ⲙ̀Ⲡⲓⲙⲁⲓⲣⲱⲙⲓ.","cop_lat":"entotf empimairomi.","en":"with the Lover of Mankind.","ar":"عند محب البشر."}},{"id":"t1445-47","text":{"cop":"Ⲥⲉⲙⲟⲩϯ ⲉ̀ⲣⲟ ⲇⲓⲕⲉⲟⲥ:","cop_lat":"Semouti ero thikeos:","en":"You are called righteous,","ar":"مدعوة أنت،"}},{"id":"t1445-48","text":{"cop":"ⲱ̀ ⲑⲏⲉⲑⲟⲩⲁⲃ Ⲙⲁⲣⲓⲁ:","cop_lat":"o thee-ethowab Maria:","en":"O Saint Mary,","ar":"بالحقيقة،"}},{"id":"t1445-49","text":{"cop":"ϫⲉ ϯⲙⲁϩⲥ̀ⲛⲟⲩϯ ⲛ̀ⲥ̀ⲕⲏⲛⲏ:","cop_lat":"je timahesnoti eneskeenee:","en":"the second tabernacle,","ar":"أيتها القديسة مريم،"}},{"id":"t1445-50","text":{"cop":"ⲛ̀ⲧⲉ ⲛⲏⲉⲑⲟⲩⲁⲃ.","cop_lat":"ente nee-ethowab.","en":"belonging to the holies.","ar":"القبة التي للأقداس."}},{"id":"t1445-51","text":{"cop":"+ Ⲑⲏⲉ̀ⲧⲟⲩⲭⲏ ⲛ̀ϧⲏⲧⲥ:","cop_lat":"+ Thee-etoukee enkheets:","en":"+ Wherein is placed,","ar":"+ تلك الموضوع فيها،"}},{"id":"t1445-52","text":{"cop":"ⲛ̀ϫⲉ ⲡⲓϣ̀ⲃⲱⲧ ⲛ̀ⲧⲉ Ⲁ̀ⲁ̀ⲣⲱⲛ:","cop_lat":"enje pi-eshvot ente A-aron:","en":"the rod of Aaron,","ar":"عصا هرون،"}},{"id":"t1445-53","text":{"cop":"ⲛⲉⲙ ϯϩ̀ⲣⲏⲣⲓ ⲉⲑⲟⲩⲁⲃ:","cop_lat":"nem ti-ehreeri ethowab:","en":"and the holy flower,","ar":"والزهرة المقدسة،"}},{"id":"t1445-54","text":{"cop":"ⲛ̀ⲧⲉ ⲡⲓⲥ̀ⲑⲟⲓⲛⲟⲩϥⲓ.","cop_lat":"ente pi-estoinoufi.","en":"of incense.","ar":"التي للبخور."}},{"id":"t1445-55","text":{"cop":"Ⲧⲉϫⲟⲗϩ ⲙ̀ⲡⲓⲧⲟⲩⲃⲟ:","cop_lat":"Tegolh empitouvo:","en":"You are clothed with purity,","ar":"أنت مشتملة بالطهارة،"}},{"id":"t1445-56","text":{"cop":"ⲥⲁϧⲟⲩⲛ ⲛⲉⲙ ⲥⲁⲃⲟⲗ:","cop_lat":"sakhoun nem savol:","en":"within and without,","ar":"من داخل ومن خارج،"}},{"id":"t1445-57","text":{"cop":"ⲱ̀ ϯⲥ̀ⲕⲏⲛⲏ ⲛ̀ⲕⲁⲑⲁⲣⲟⲥ:","cop_lat":"o ti-eskeenee enkatharos:","en":"O pure tabernacle,","ar":"أيتها القبة النقية،"}},{"id":"t1445-58","text":{"cop":"ⲫ̀ⲙⲁ ⲛ̀ϣⲱⲡⲓ ⲛ̀ⲛⲓⲇⲓⲕⲉⲟⲥ.","cop_lat":"efma enshopi ennithikeos.","en":"the dwelling of the righteous.","ar":"مسكن الصديقين."}},{"id":"t1445-59","text":{"cop":"+ Ⲛⲓⲧⲁⲅⲙⲁ ⲛ̀ⲧⲉ ⲡ̀ϭⲓⲥⲓ:","cop_lat":"+ Nitaghma ente epchisi:","en":"+ The hosts of the high standings,","ar":"+ طغمات العلاء،"}},{"id":"t1445-60","text":{"cop":"ⲛⲉⲙ ⲡ̀ⲭⲟⲣⲟⲥ ⲛ̀ⲧⲉ ⲛⲓⲑ̀ⲙⲏⲓ:","cop_lat":"nem epkhoros ente ni-ethmee:","en":"and the chorus of the just,","ar":"وصفوف الأبرار،"}},{"id":"t1445-61","text":{"cop":"ⲥⲉⲉⲣⲉⲩⲇⲟⲝⲁⲍⲓⲛ:","cop_lat":"se-erevthoksazin:","en":"glorify you,","ar":"يمجدون،"}},{"id":"t1445-62","text":{"cop":"ⲛ̀ⲛⲉⲙⲁⲕⲁⲣⲓⲥⲙⲟⲥ.","cop_lat":"ennemakarismos.","en":"and your blessedness.","ar":"طوباويتك."}},{"id":"t1445-63","text":{"cop":"Ⲉⲑⲃⲉ ⲫⲁⲓ ⲧⲉⲛϭⲓⲥⲓ:","cop_lat":"Ethve fai tenchisi:","en":"Wherefore we,","ar":"من أجل هذا،"}},{"id":"t1445-64","text":{"cop":"ⲙ̀ⲙⲟ ⲁⲝⲓⲱⲥ:","cop_lat":"emmo aksios:","en":"magnify you befittingly,","ar":"نعظمِك،"}},{"id":"t1445-65","text":{"cop":"ϧⲉⲛ ϩⲁⲛⲩⲙⲛⲟⲗⲟⲅⲓⲁ:","cop_lat":"khen hanimnologia:","en":"with prophetic,","ar":"بإستحقاقٍ،"}},{"id":"t1445-66","text":{"cop":"ⲙ̀ⲡ̀ⲣⲟⲫⲏⲧⲓⲕⲟⲛ.","cop_lat":"emeprofeetikon.","en":"hymnology.","ar":"بتماجيد نبوية."}},{"id":"t1445-67","text":{"cop":"+ Ϫⲉ ⲁⲩⲥⲁϫⲓ ⲉⲑⲃⲏϯ:","cop_lat":"+ Je avsaji ethveeti:","en":"+ For they spoke of you,","ar":"+ لأنهم تكلموا،"}},{"id":"t1445-68","text":{"cop":"ⲛ̀ϩⲁⲛϩ̀ⲃⲏⲟⲩⲓ̀ ⲉⲩⲧⲁⲓⲏⲟⲩⲧ:","cop_lat":"enhanehveeoui evtaieeout:","en":"with great honor,","ar":"من أجلِك بأعمال كريمة،"}},{"id":"t1445-69","text":{"cop":"ϯⲃⲁⲕⲓ ⲉⲑⲟⲩⲁⲃ:","cop_lat":"tivaki ethowab:","en":"O holy city,","ar":"أيتها المدينة المقدسة،"}},{"id":"t1445-70","text":{"cop":"ⲛ̀ⲧⲉ ⲡⲓⲛⲓϣϯ ⲛ̀Ⲟⲩⲣⲟ.","cop_lat":"ente pinishti enouro.","en":"of the great King.","ar":"التي للملك العظيم."}},{"id":"t1445-71","text":{"cop":"Ⲧⲉⲛϯϩⲟ ⲧⲉⲛⲧⲱⲃϩ:","cop_lat":"Tentiho tentovh:","en":"We entreat and pray,","ar":"نسأل ونطلب،"}},{"id":"t1445-72","text":{"cop":"ⲉⲑⲣⲉⲛϣⲁϣⲛⲓ ⲉⲩⲛⲁⲓ:","cop_lat":"ethrenshashni evnai:","en":"that we may win mercy,","ar":"أن نفوز برحمةٍ،"}},{"id":"t1445-73","text":{"cop":"ϩⲓⲧⲉⲛ ⲛⲉⲡ̀ⲣⲉⲥⲃⲓⲁ:","cop_lat":"hiten ne-epresvia:","en":"through your intercessions,","ar":"بشفاعاتِك،"}},{"id":"t1445-74","text":{"cop":"ⲛ̀ⲧⲟⲧϥ ⲙ̀Ⲡⲓⲙⲁⲓⲣⲱⲙⲓ. -","cop_lat":"entotf empimairomi. -","en":"with the Lover of Mankind.","ar":"عند محب البشر."}},{"id":"t1445-76","text":{"cop":"Ⲏ̀ⲡⲁⲣⲑⲉⲛⲟⲥ ⲥⲏⲙⲉⲣⲟⲛ ⲧⲟⲛ ⲩ̀ⲡⲉⲣⲟⲩⲥⲓⲟⲛ ⲧⲓⲕⲧⲓ:","cop_lat":"Eeparthenos seemeron ton iperousion tikti:","en":"Today, the Virgin bears Him who is transcendent,","ar":"اليوم البتول تلد الفائق الجوهر"}},{"id":"t1445-77","text":{"cop":"ⲕⲉ ⲏ̀ⲅⲏⲧⲟ ⲥ̀ⲡⲏⲗⲉⲟⲛ ⲧⲱ ⲁⲡⲣⲟⲥⲓⲧⲱ ⲡ̀ⲣⲟⲥⲁⲅⲓ:","cop_lat":"ke eegeeto espeeleon to aprosito eprosagi:","en":"and the earth presents the cave to Him who is beyond reach.","ar":"والأرض تقرب المغارة لغير المقترب إليه."}},{"id":"t1445-78","text":{"cop":"ⲁⲅⲅⲉⲗⲓ ⲙⲉⲧⲁ ⲡⲓⲙⲉⲛⲱⲛ ⲇⲟⲝⲟⲗⲟⲅⲟⲩⲥⲓ:","cop_lat":"angeli meta pimenon thoksologhousi:","en":"Angels,","ar":"الملائكة مع الرعاة يمجدون."}},{"id":"t1445-79","text":{"cop":"ⲙⲁⲅⲓ ⲇⲉ ⲙⲉⲧⲁ ⲁⲥⲧⲉⲣⲟⲥ ⲟ̀ⲇⲓⲡⲟⲣⲟⲩⲥⲓ:","cop_lat":"magi the meta asteros othiporousi:","en":"along with shepherds glorify Him.","ar":"والمجوس مع الكوكب في الطريق سائرون."}},{"id":"t1445-80","text":{"cop":"ⲇⲓ ⲏ̀ⲙⲁⲥ ⲅⲁⲣ ⲉ̀ⲅⲉⲛⲛⲏⲑⲏ:","cop_lat":"thi eemas ghar egenneethee:","en":"The Magi make their way to Him by a star.","ar":"لأن من أجلنا"}},{"id":"t1445-81","text":{"cop":"ⲡⲉⲇⲓⲟⲛ ⲛⲉⲟⲛ:","cop_lat":"pethion neon:","en":"For a new Child has been born for us,","ar":"وُلد صبياً جديداً."}},{"id":"t1445-82","text":{"cop":"ⲟ̀ⲡ̀ⲣⲟⲉ̀ⲱ̀ⲛⲱⲛ Ⲑⲉⲟⲥ.","cop_lat":"o-epro-e-onon Theos.","en":"the God before all ages.","ar":"الإله الذي قبل الدهور."}},{"id":"t1445-83","text":{"cop":"Ⲡⲓϫⲓⲛⲙⲓⲥⲓ ⲙ̀ⲡⲁⲣⲑⲉⲛⲓⲕⲟⲛ ⲟⲩⲟϩ ⲛⲓⲛⲁⲕϩⲓ ⲙ̀ⲡ̀ⲛⲉⲩⲙⲁⲧⲓⲕⲟⲛ ⲟⲩϣ̀ⲫⲏⲣⲓ ⲙ̀ⲡⲁⲣⲁⲇⲟⲝⲟⲛ ⲕⲁⲧⲁ ⲛⲓⲥ̀ⲙⲏⲓ ⲙ̀ⲡ̀ⲣⲟⲫⲏⲧⲓⲕⲟⲛ. -","cop_lat":"Pijinmisi emparthenikon o-woh ninakhi emepnevmatikon ou-eshfeeri emparathokson kata ni-esmee emeprofeetikon. -","en":"The virginal birth and spiritual contractions, are marvelous wonders according to the prophetic sayings.","ar":"الميلاد البتولي، والطلقات الروحانية، عجب عجيب، كالأخبار النبوية."}},{"id":"t1445-85","text":{"cop":"Ⲉ̀ⲧⲁⲩⲉⲛ ⲛⲓⲥ̀ϧⲁⲓ ⲛ̀ϩⲓⲣⲏⲛⲓⲕⲟⲛ:","cop_lat":"Etaven ni-eskhai enhireenikon:","en":"When the peaceful writings,","ar":"لما وردت مكاتبات السلام،"}},{"id":"t1445-86","text":{"cop":"ⲛ̀ⲧⲉ Ⲕⲱⲥⲧⲁⲛⲧⲓⲛⲟⲥ ⲉ̀ϧⲟⲩⲛ ⲉ̀Ⲣⲁⲕⲟϯ:","cop_lat":"ente Kostantinos ekhoun erakoti:","en":"of Constantine reached Alexandria saying,","ar":"التي لقسطنطين إلى الإسكندرية قائلة،"}},{"id":"t1445-87","text":{"cop":"ϫⲉ ⲙⲁϣ̀ⲑⲁⲙ ⲙ̀ⲫ̀ⲣⲟ ⲛ̀ⲛⲓⲉⲣⲫⲏⲟⲩⲓ̀:","cop_lat":"je ma-eshtam emefro ennierfeeoui:","en":"“Shut the gates of the heathen,","ar":"\"أغلقوا أبواب البرابي،"}},{"id":"t1445-88","text":{"cop":"ⲁ̀ⲱ̀ⲟⲩⲛ ⲙ̀ⲫ̀ⲣⲟ ⲛ̀ⲛⲓⲉⲕⲕⲗⲏⲥⲓⲁ.","cop_lat":"a-ooun emefro enniekkleesia.","en":"and open the gates of the churches.”","ar":"وإفتحوا أبواب الكنائس.\""}},{"id":"t1445-89","text":{"cop":"Ⲡⲁⲣⲁⲗⲉⲝ:","cop_lat":"Paraleks:","en":"Paralex:","ar":"برلكس:"}},{"id":"t1445-90","text":{"cop":"Ⲁ̀ ⲛⲓⲉ̀ⲡⲓⲥⲕⲟⲡⲟⲥ ⲥⲱⲧⲉⲙ ⲁⲩⲣⲁϣⲓ:","cop_lat":"A ni-episkopos sotem avrashi:","en":"The bishops heard and became happy,","ar":"الأساقفة سمعوا ففرحوا،"}},{"id":"t1445-91","text":{"cop":"ⲁ̀ ⲛⲓⲡ̀ⲣⲉⲥⲃⲩⲧⲉⲣⲟⲥ ⲟⲩⲛⲟϥ ⲙ̀ⲙⲱⲟⲩ:","cop_lat":"a ni-epresviteros ounof emmoou:","en":"the priests rejoiced,","ar":"والقساوسة إبتهجوا،"}},{"id":"t1445-92","text":{"cop":"ⲁ̀ ⲡⲓϣⲁϣϥ ⲛ̀ⲧⲁⲅⲙⲁ ⲛ̀ⲧⲉ Ϯⲉⲕⲕⲗⲏⲥⲓⲁ:","cop_lat":"a pishashf entaghma ente Tiekkleesia:","en":"and the seven ranks of the Church,","ar":"وسبع رتب الكنيسة،"}},{"id":"t1445-93","text":{"cop":"ϯⲱ̀ⲟⲩ ⲙ̀Ⲫ̀ⲛⲟⲩϯ ⲛ̀ⲧⲉ ⲧ̀ⲫⲉ.","cop_lat":"ti-oou emefnoti ente etfe.","en":"glorified the God of heaven.","ar":"مجدوا إله السماء."}},{"id":"t1445-94","text":{"cop":"Ⲁϣ ⲛ̀ⲗⲁⲥ ⲛ̀ⲥⲱⲙⲁⲧⲓⲕⲟⲥ:","cop_lat":"Ash enlas ensomatikos:","en":"What bodily tongue,","ar":"أي لسان جسدي،"}},{"id":"t1445-95","text":{"cop":"ⲛⲁ ϣ̀ⲥⲁϫⲓ ⲉ̀ⲡⲉⲕⲛⲓϣϯ ⲛ̀ⲑⲉⲗⲏⲗ:","cop_lat":"na eshsaji epeknishti entheleel:","en":"can speak of your great happiness,","ar":"يقدر أن ينطق بعِظَم سرورك،"}},{"id":"t1445-96","text":{"cop":"ⲱ̀ ⲡⲓⲗⲁⲟⲥ ⲙ̀ⲡⲓⲥ̀ⲧⲟⲥ:","cop_lat":"o pilaos empi-estos:","en":"O faithful people,","ar":"أيها الشعب المؤمن،"}},{"id":"t1445-97","text":{"cop":"ϧⲉⲛ ⲛⲓⲉⲕⲕⲗⲏⲥⲓⲁ ⲧⲏⲣⲟⲩ.","cop_lat":"khen niekkleesia teerou.","en":"in all the churches.","ar":"في جميع الكنائس."}},{"id":"t1445-98","text":{"cop":"Ⲙ̀ⲫ̀ⲛⲁⲩ ⲉ̀ⲧⲁⲩⲥⲱⲧⲉⲙ ⲉ̀ⲛⲓⲥ̀ϧⲁⲓ:","cop_lat":"Emefnav etavsotem eni-eskhai:","en":"When they heard of the teachings,","ar":"عندما سمعوا كتب،"}},{"id":"t1445-99","text":{"cop":"ⲛ̀ⲧⲉ ⲡ̀ⲟⲩⲣⲟ Ⲕⲱⲥⲧⲁⲛⲧⲓⲛⲟⲥ:","cop_lat":"ente epouro Kostantinos:","en":"of king Constantine saying,","ar":"قسطنطين الملك قائلاً،"}},{"id":"t1445-100","text":{"cop":"ϫⲉ ⲙⲁϣ̀ⲑⲁⲙ ⲙ̀ⲫ̀ⲣⲟ ⲛ̀ⲛⲓⲉⲣⲫⲏⲟⲩⲓ̀:","cop_lat":"je ma-eshtam emefro ennierfeeoui:","en":"“Shut the gates of the heathen,","ar":"\"إغلقوا أبواب البرابي،"}},{"id":"t1445-101","text":{"cop":"ⲁ̀ ⲟⲩⲱⲛ ⲙ̀ⲫ̀ⲣⲟ ⲛ̀ⲛⲓⲉⲕⲕⲗⲏⲥⲓⲁ.","cop_lat":"a o-on emefro enniekkleesia.","en":"and open the gates of the churches.","ar":"إفتحوا أبواب الكنائس."}},{"id":"t1445-102","text":{"cop":"Ⲙⲁϣ̀ⲑⲁⲙ ⲛ̀ⲛⲓⲏ̀ⲟⲩ ⲛ̀ⲛⲓⲇⲉⲙⲱⲛ:","cop_lat":"Ma-eshtam enni-eeou ennithemon:","en":"Shut the houses of demons,","ar":"أغلقوا بيوت الشياطين،"}},{"id":"t1445-103","text":{"cop":"ⲟⲩⲟϩ ⲁ̀ ⲟⲩⲱⲛ ⲛ̀ⲛⲓⲏ̀ⲟⲩ ⲛ̀ⲧⲉ Ⲫ̀ⲛⲟⲩϯ:","cop_lat":"o-woh a o-on enni-eeou ente Efnoti:","en":"and open the houses","ar":"وإفتحوا بيوت الله،\" مغبوط"}},{"id":"t1445-104","text":{"cop":"ⲱ̀ⲟⲩⲛⲓⲁⲧϥ ⲙ̀ⲡⲁⲓⲗⲁⲟⲥ ⲫⲁⲓ:","cop_lat":"oouniatf empailaos fai:","en":"of God,” blessed are these people,","ar":"هذا الشعب الذي،"}},{"id":"t1445-105","text":{"cop":"ⲉ̀ⲧⲁϥϫⲟⲥ ⲙ̀ⲡⲁⲓⲟⲩⲁϩⲥⲁϩⲛⲓ ⲛⲁϥ.","cop_lat":"etafgos empaiowahsahni naf.","en":"that heard this matter.","ar":"قيل له هذا الأمر."}},{"id":"t1445-106","text":{"cop":"Ⲱ̀ⲟⲩⲛⲓⲁⲧⲕ ⲱ̀ Ⲕⲱⲥⲧⲁⲛⲧⲓⲛⲟⲥ:","cop_lat":"Oouniatk o Kostantinos:","en":"Blessed are you O Constantine,","ar":"طوباك يا قسطنطين،"}},{"id":"t1445-107","text":{"cop":"ϫⲉ ⲁⲕⲧⲁⲛϧⲟ ⲙ̀ⲡⲓⲛⲁϩϯ:","cop_lat":"je aktankho empinahti:","en":"for you revived the faith,","ar":"لأنك أحييت الإيمان،"}},{"id":"t1445-108","text":{"cop":"ⲉⲑⲃⲉ ⲫⲁⲓ ⲁ̀ Ⲫ̀ⲛⲟⲩϯ ⲧⲁⲛϧⲟⲕ:","cop_lat":"ethve fai a Efnoti tankhok:","en":"therefore God gave you life,","ar":"فلذلك أحياك الله،"}},{"id":"t1445-109","text":{"cop":"ϧⲉⲛ ⲑ̀ⲙⲉⲧⲟⲩⲣⲟ ⲛ̀ⲧⲉ ⲛⲓⲫⲏⲟⲩⲓ̀.","cop_lat":"khen ethmetouro ente nifeeoui.","en":"in the kingdom of heavens.","ar":"في ملكوت السموات."}},{"id":"t1445-110","text":{"cop":"Ⲧⲱⲃϩ ⲙ̀Ⲡ̀ϭⲟⲓⲥ ⲉ̀ϩ̀ⲣⲏⲓ ⲉ̀ϫⲱⲛ:","cop_lat":"Tovh emepshois e-ehree egon:","en":"Pray to the Lord on our behalf,","ar":"أُطلبا من الرب عنا،"}},{"id":"t1445-111","text":{"cop":"ⲡⲁϭⲟⲓⲥ ⲡ̀ⲟⲩⲣⲟ Ⲕⲱⲥⲧⲁⲛⲧⲓⲛⲟⲥ:","cop_lat":"pashois epouro Kostantinos:","en":"my lord king Constantine,","ar":"يا سيدي الملك قسطنطين،"}},{"id":"t1445-112","text":{"cop":"ⲛⲉⲙ Ⲏ̀ⲗⲁⲛⲏ ϯⲟⲩⲣⲱ:","cop_lat":"nem Eelanee tiouro:","en":"and queen Helen,","ar":"والملكة هيلانة،"}},{"id":"t1445-113","text":{"cop":"ⲛ̀ⲧⲉϥⲭⲁ ⲛⲉⲛⲛⲟⲃⲓ ⲛⲁⲛ ⲉ̀ⲃⲟⲗ. -","cop_lat":"entefka nennovi nan evol. -","en":"that He may forgive us our sins.","ar":"ليغفر لنا خطايانا."}},{"id":"t1445-115","text":{"cop":"Ⲭ̀ⲣⲓⲥⲧⲟⲥ ⲁ̀ⲛⲉⲥⲧⲏ ⲉⲕ ⲛⲉⲕⲣⲱⲛ:","cop_lat":"Ekhristos anestee ek nekron:","en":"Christ is risen from the dead,","ar":"المسيح قام من بين الأموات،"}},{"id":"t1445-116","text":{"cop":"ⲑⲁⲛⲁⲧⲱ ⲑⲁⲛⲁⲧⲟⲛ:","cop_lat":"thanato thanaton:","en":"trampling down death by death,","ar":"بالموت داس الموت،"}},{"id":"t1445-117","text":{"cop":"ⲡⲁⲧⲏⲥⲁⲥ ⲕⲉ ⲧⲓⲥ ⲉⲛ ⲧⲓⲥ ⲙ̀ⲛⲏⲙⲁⲥⲓ ⲍⲱⲏⲛ ⲭⲁⲣⲓⲥⲁⲙⲉⲛⲟⲥ.","cop_lat":"pateesas ke tis en tis emneemasi zoeen kharisamenos.","en":"and upon those in the tombs bestowing life.","ar":"والذين في القبور، أنعم لهم بالحياة الأبدية."}},{"id":"t1445-118","text":{"cop":"Ⲇⲟⲝⲁ Ⲡⲁⲧⲣⲓ ⲕⲉ Ⲩⲓⲱ ⲕⲉ Ⲁ̀ⲅⲓⲱ Ⲡ̀ⲛⲉⲩⲙⲁⲧⲓ:","cop_lat":"Thoksa Patri ke I-io ke Agio Epnevmati:","en":"Glory to the Father and the Son and the Holy Spirit,","ar":"المجد للآب والإبن والروح القدس،"}},{"id":"t1445-119","text":{"cop":"ⲕⲉ ⲛⲩⲛ ⲕⲉ ⲁ̀ⲓ̀ ⲕⲉ ⲓⲥ ⲧⲟⲥ ⲉ̀ⲱ̀ⲛⲁⲥ ⲧⲱⲛ ⲉ̀ⲱ̀ⲛⲱⲛ.","cop_lat":"ke nin ke a-i ke is tos e-onas ton e-onon.","en":"now and forever and unto the age of all ages.","ar":"الآن وكل أوان وإلى دهر الدهور."}},{"id":"t1445-120","text":{"cop":"Ⲁ̀ⲙⲏⲛ.","cop_lat":"Ameen.","en":"Amen.","ar":"آمين."}},{"id":"t1445-121","text":{"cop":"Ⲧⲟⲛ ⲥⲩⲛⲁⲛⲁⲣⲭⲟⲛ Ⲗⲟⲅⲟⲛ Ⲡⲁⲧⲣⲓ ⲕⲉ Ⲡ̀ⲛⲉⲩⲙⲁⲧⲓ:","cop_lat":"Ton sinanarkhon Loghon Patri ke Epnevmati:","en":"Or:","ar":"أو:"}},{"id":"t1445-122","text":{"cop":"ⲧⲟⲛ ⲉⲕ ⲡⲁⲣⲑⲉⲛⲟⲩ ⲧⲉⲭⲑⲉⲛⲧⲁ ⲓⲥ ⲥⲱⲧⲏⲣⲓⲁⲛ ⲏ̀ⲙⲟⲛ:","cop_lat":"ton ek parthenou tekhthenta is soteerian eemon:","en":"We the believers hymn and worship the Logos,","ar":"نسبح نحن المؤمنين ونمجد الكلمة المساوي للآب"}},{"id":"t1445-123","text":{"cop":"ⲁ̀ⲛⲩⲙⲛⲏⲥⲱⲙⲉⲛ ⲡⲓⲥⲧⲓ ⲕⲉ ⲡ̀ⲣⲟⲥⲕⲩⲛⲏⲥⲱⲙⲉⲛ:","cop_lat":"animneesomen pisti ke eproskineesomen:","en":"without beginning with the Father and the Spirit,","ar":"والروح في الأزلية وعدم الإبتداء،"}},{"id":"t1445-124","text":{"cop":"ⲟ̀ⲧⲓ ⲏⲩⲇⲟⲕⲏⲥⲉ ⲥⲁⲣⲕⲓ:","cop_lat":"oti eevthokeese sarki:","en":"having been born of a virgin for our salvation,","ar":"المولود من العذراء لخلاصنا،"}},{"id":"t1445-125","text":{"cop":"ⲁ̀ⲛⲉⲗⲑⲓⲛ ⲉⲛ ⲧⲱ ⲥ̀ⲧⲁⲩⲣⲟ:","cop_lat":"anelthin en to estavro:","en":"for He appeared","ar":"لأنه سُرَ"}},{"id":"t1445-126","text":{"cop":"ⲕⲉ ⲑⲁⲛⲁⲧⲟⲛ ⲩ̀ⲡⲟⲙⲓⲛⲉ:","cop_lat":"ke thanaton ipomine:","en":"in the flesh to ascend on the Cross.","ar":"وأرتضى بالجسد أن يعلوا على الصليب،"}},{"id":"t1445-127","text":{"cop":"ⲕⲉ ⲉ̀ⲅⲓⲣⲉ ⲧⲟⲩⲥ ⲧⲉⲑⲛⲉⲱ̀ⲟ̀:","cop_lat":"ke egire tous tethne-o-o:","en":"He persevered unto death and raised the dead","ar":"ويحتمل الموت"}},{"id":"t1445-128","text":{"cop":"ⲧⲁⲥ ⲉⲛ ⲧⲏ ⲉⲛⲇⲟⲝⲱ Ⲁ̀ⲛⲁⲥⲧⲁⲥⲓ ⲁⲩⲧⲟⲩ.","cop_lat":"tas en tee enthokso Anastasi avtou.","en":"through His glorious Resurrection.","ar":"وينهض الموتى بقيامته المجيدة."}},{"id":"t1445-129","text":{"cop":"Ⲧⲟⲩ ⲗⲓⲑⲟⲩⲥ ⲫ̀ⲣⲁⲅⲓⲥⲑⲉⲛ ⲧⲟⲥ ⲩ̀ⲡⲟ ⲧⲱⲛ Ⲓⲟⲩⲇⲉⲱⲛ:","cop_lat":"Tou lithous efragisten tos ipo ton Youdeon:","en":"Or:","ar":"أو:"}},{"id":"t1445-130","text":{"cop":"ⲕⲉ ⲥ̀ⲧ̀ⲣⲁⲧⲓⲱ ⲧⲱⲛ ⲫⲩⲗⲁⲥⲥⲟⲛ ⲧⲱⲛ ⲧⲟ ⲁⲭⲣⲁⲛⲧⲟⲛ ⲥⲟⲩ Ⲥⲱⲙⲁ:","cop_lat":"ke esetratio ton filasson ton to akhranton sou Soma:","en":"When the stone was sealed by the Jews, and the soldiers were guarding Your undefiled Body,","ar":"أن الحجر لما خُتِم من اليهود وجسدك الطاهر حُفِظ من الجند،"}},{"id":"t1445-131","text":{"cop":"ⲁ̀ⲛⲉⲥⲧⲏⲥ ⲧ̀ⲣⲓⲏ̀ⲙⲉⲣⲟⲥ Ⲥⲱⲧⲏⲣ:","cop_lat":"anestees etri-eemeros Soteer:","en":"You arose on the third day,","ar":"قُمت في اليوم الثالث أيها المخلص،"}},{"id":"t1445-132","text":{"cop":"ⲇⲱⲣⲟⲩⲙⲉⲛⲟⲥ ⲧⲱ ⲕⲟⲥⲙⲱ ⲧⲏⲛ ⲍⲱⲏⲛ:","cop_lat":"thoroumenos to kosmo teen zoeen:","en":"O Savior, granting life to the world.","ar":"مانحاً العالم الحياة."}},{"id":"t1445-133","text":{"cop":"ⲇⲓⲁ ⲧⲟⲩⲧⲟ ⲉ̀ⲇⲩⲛⲁⲙⲓⲥ ⲧⲱⲛ ⲟⲩⲣⲁⲛⲱⲛ ⲉ̀ⲃⲟⲱⲛ ⲥⲓ ⲍⲱⲟ̀ⲇⲟⲧⲁ:","cop_lat":"thia touto ethinamis ton ouranon evo-on si zo-othota:","en":"For this reason, the heavenly powers cried out to You, O Giver of Life,","ar":"لأجل هذا قوات السموات هتفوا إليك"}},{"id":"t1445-134","text":{"cop":"ⲇⲟⲝⲁ ⲧⲏ Ⲁ̀ⲛⲁⲥⲧⲁⲥⲓ ⲥⲟⲩ Ⲭ̀ⲣⲓⲥⲧⲉ:","cop_lat":"thoksa tee Anastasi sou Ekhriste:","en":"“Glory to Your Resurrection O Christ.","ar":"يا واهب الحياة \"المجد لقيامتك أيها المسيح،"}},{"id":"t1445-135","text":{"cop":"ⲇⲟⲝⲁ ⲧⲏ ⲃⲁⲥⲓⲗⲓⲁ ⲥⲟⲩ:","cop_lat":"thoksa tee vasilia sou:","en":"Glory to Your kingdom.","ar":"المجد لتدبيرك،"}},{"id":"t1445-136","text":{"cop":"ⲇⲟⲝⲁ ⲧⲏ ⲟⲓⲕⲟⲛⲟⲙⲓⲁ ⲥⲟⲩ:","cop_lat":"thoksa tee oikonomia sou:","en":"Glory be to Your Economy,","ar":"المجد لملكك"}},{"id":"t1445-137","text":{"cop":"ⲙⲟⲛⲉ Ⲫⲓⲗⲁⲛⲑ̀ⲣⲱⲡⲉ.","cop_lat":"mone Filanethrope.","en":"O You who alone are Lover of Mankind.”","ar":"يا محب البشر وحدك.\""}},{"id":"t1445-138","text":{"cop":"Ⲧⲏⲛ Ⲁ̀ⲛⲁⲥⲧⲁⲥⲓⲛ ⲥⲟⲩ Ⲭ̀ⲣⲓⲥⲧⲉ Ⲥⲱⲧⲏⲣ:","cop_lat":"Teen Anastasin sou Ekhriste Soteer:","en":"Or: Your Resurrection,","ar":"أو: أيها المسيح مخلصنا،"}},{"id":"t1445-139","text":{"cop":"ⲁⲅⲅⲉⲗⲓ ⲩⲙⲛⲟⲩⲥⲓⲛ ⲉⲛ ⲟⲩⲣⲁⲛⲓⲥ:","cop_lat":"angeli imnousin en ouranis:","en":"Christ Savior,","ar":"أن الملائكة لا يزالون في السماء يسبحون قيامتك،"}},{"id":"t1445-140","text":{"cop":"ⲕⲉ ⲏ̀ⲙⲁⲥ ⲧⲟⲩⲥ ⲉ̀ⲡⲓ ⲅⲩⲥ ⲕⲁⲧⲁⲝⲓⲱⲥⲟⲛ:","cop_lat":"ke eemas tous epi gis kataksioson:","en":"is praised by the angels in heaven;","ar":"ولذلك نضرع إليك فأهلنا، نحن الذين على الأرض،"}},{"id":"t1445-141","text":{"cop":"ⲉⲛ ⲕⲁⲑⲁⲣⲁ ⲕⲁⲣⲇⲓⲁ ⲥⲉ ⲇⲟⲝⲁⲍⲓⲛ.","cop_lat":"en kathara karthia se thoksazin.","en":"and make us on earth worthy with pure hearts to glorify You.","ar":"أن نكون ممجدين إياك بقلوب نقية أبداً."}},{"id":"t1445-142","text":{"cop":"Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ ⲁϥⲧⲱⲛϥ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲛⲏⲉⲑⲙⲱⲟⲩⲧ:","cop_lat":"Pi-ekhristos aftonf evol khen nee-ethmoout:","en":"Or: Christ is risen from the dead;","ar":"أو: المسيح قام من بين الأموات،"}},{"id":"t1445-143","text":{"cop":"ⲫⲏⲉ̀ⲧⲁϥⲙⲟⲩ ⲁϥϩⲱⲙⲓ ⲉ̀ϫⲉⲛ ⲫ̀ⲙⲟⲩ ⲟⲩⲟϩ ⲛⲏⲉⲧⲭⲏ ϧⲉⲛ ⲛⲓⲙ̀ϩⲁⲩ ⲁϥⲉⲣϩ̀ⲙⲟⲧ ⲛⲱⲟⲩ ⲙ̀ⲡⲓⲱⲛϧ ⲛ̀ⲉ̀ⲛⲉϩ. -","cop_lat":"fee-etafmou afhomi ejen efmou o-woh nee-etkee khen ni-emhav aferehmot noou empionkh eneneh. -","en":"He who died trampled down death and upon those in the tombs bestowed eternal life.","ar":"الذي مات داس الموت والذين في القبور أنعم لهم بالحياة الأبدية."}},{"id":"t1445-145","text":{"cop":"Ⲭ̀ⲣⲓⲥⲧⲟⲥ ⲁ̀ⲛⲉⲗⲩⲯⲩⲥ ⲧⲟⲛ ⲟⲩⲣⲁⲛⲟⲛ:","cop_lat":"Ekhristos anelipsis ton ouranon:","en":"Christ has ascended into the heaven,","ar":"المسيح صعد إلى السماء،"}},{"id":"t1445-146","text":{"cop":"ⲉⲝⲁⲡⲉⲥⲧⲓⲗⲉ Ⲡⲁⲣⲁⲕⲗⲏⲧⲟⲛ ⲧⲟ Ⲡ̀ⲛⲉⲩⲙⲁ ⲧⲟ ⲁ̀ⲅⲓⲟⲛ:","cop_lat":"eksapestile Parakleeton to Epnevma to agion:","en":"and sent us the Paraclete, the Holy Spirit,","ar":"وأرسل البارقليط الروح القدس،"}},{"id":"t1445-147","text":{"cop":"ⲍⲱⲏⲛ ⲭⲁⲣⲓⲥⲁⲙⲉⲛⲟⲥ ⲉ̀ⲡⲓⲧⲱⲛ ⲯⲩⲭⲱⲛ ⲏ̀ⲙⲱⲛ.","cop_lat":"zoeen kharisamenos epiton psikhon eemon.","en":"bestowing life to our souls.","ar":"وأنعم لنفوسنا بالحياة."}},{"id":"t1445-148","text":{"cop":"Ⲇⲟⲝⲁ Ⲡⲁⲧⲣⲓ...","cop_lat":"Thoksa Patri...","en":"Glory to the Father….","ar":"المجد للآب ..."}},{"id":"t1445-149","text":{"cop":"Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ ⲁϥⲧⲱⲛϥ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲛⲏⲉⲑⲙⲱⲟⲩⲧ:","cop_lat":"Pi-ekhristos aftonf evol khen nee-ethmoout:","en":"Or: Christ is risen from the dead,","ar":"أو: المسيح قام من بين الأموات،"}},{"id":"t1445-150","text":{"cop":"ⲟⲩⲟϩ ⲁϥϣⲉⲛⲁϥ ⲉ̀ⲡ̀ϣⲱⲓ ⲉ̀ⲛⲓⲫⲏⲟⲩⲓ̀:","cop_lat":"o-woh afshenaf e-epshoi enifeeoui:","en":"and ascended into the heavens,","ar":"وصعد إلى السموات،"}},{"id":"t1445-151","text":{"cop":"ⲁϥϩⲉⲙⲥⲓ ⲥⲁⲟⲩⲓ̀ⲛⲁⲙ ⲙ̀Ⲡⲉϥⲓⲱⲧ ϧⲉⲛ ⲛⲏⲉⲧϭⲟⲥⲓ:","cop_lat":"afhemsi saouinam empefiot khen nee-etchosi:","en":"and is seated at the right hand of His Father in the highest,","ar":"وجلس عن يمين أبيه في الأعالي،"}},{"id":"t1445-152","text":{"cop":"ⲁϥⲉⲣϩ̀ⲙⲟⲧ ⲛⲁⲛ (ⲛ̀ⲛⲉⲛⲯⲩⲭⲏ) ⲙ̀ⲡⲓⲱⲛϧ ⲛ̀ⲉ̀ⲛⲉϩ. -","cop_lat":"aferehmot nan (ennenpsishee) empionkh eneneh. -","en":"bestowing upon us (our souls) everlasting life.","ar":"وأنعم لنا (لنفوسنا) بالحياة الأبدية."}},{"id":"t1445-154","text":{"cop":"Ⲕ̀ⲥ̀ⲙⲁⲣⲱⲟⲩⲧ ⲁ̀ⲗⲏⲑⲱⲥ:","cop_lat":"Ekesmaroout aleethos:","en":"Blessed are You indeed,","ar":"مبارك أنت بالحقيقة،"}},{"id":"t1445-155","text":{"cop":"ⲛⲉⲙ Ⲡⲉⲕⲓⲱⲧ ⲛ̀ⲁ̀ⲅⲁⲑⲟⲥ:","cop_lat":"nem Pekiot enaghathos:","en":"with Your good Father,","ar":"مع أبيك الصالح،"}},{"id":"t1445-156","text":{"cop":"ⲛⲉⲙ Ⲡⲓⲡ̀ⲛⲉⲩⲙⲁ Ⲉⲑⲟⲩⲁⲃ:","cop_lat":"nem Pi-epnevma Ethowab:","en":"and the Holy Spirit,","ar":"والروح القدس،"}},{"id":"t1445-157","text":{"cop":"ϫⲉ (ⲁⲕⲧⲱⲛⲕ) ⲁⲕⲥⲱϯ ⲙ̀ⲙⲟⲛ.","cop_lat":"je (aktonk) aksoti emmon.","en":"for You have (risen) and saved us.","ar":"لأنك (قُمتَ) وخلصتنا."}},{"id":"t1445-158","text":{"cop":"Ϩⲓⲧⲉⲛ ⲛⲓⲉⲩⲭⲏ:","cop_lat":"Hiten nievshee:","en":"Through the prayers,","ar":"بصلوات،"}},{"id":"t1445-159","text":{"cop":"ⲛ̀ⲧⲉ ⲡⲉⲛⲱⲓⲧ ⲉⲧⲧⲁⲓⲏⲟⲩⲧ ⲛ̀ⲁⲣⲭⲏⲉ̀ⲣⲉⲩⲥ ⲡⲁⲡⲁ ⲁⲃⲃⲁ (Ⲑⲉⲟ̀ⲇⲟⲣⲟⲥ):","cop_lat":"ente penoit ettaieeout enarshee-erevs papa abba (The-odoros):","en":"of our honored father the high priest Pope Abba (Tawadros),","ar":"أبينا المكرم رئيس الكهنة البابا الأنبا (تواضروس)،"}},{"id":"t1445-160","text":{"cop":"ⲛⲉⲙ ⲡⲉⲛⲓⲱⲧ ⲛ̀ⲉ̀ⲡⲓⲥⲕⲟⲡⲟⲥ (ⲙ̀ⲙⲏⲧⲣⲟⲡⲟⲗⲓⲧⲏⲥ) ⲁⲃⲃⲁ (...):","cop_lat":"nem peniot enepiskopos (emmeetropolitees) abba (...):","en":"and our father the Bishop (Metropolitan) Abba (…),","ar":"وأبينا الأسقف (المطران) الأنبا (...)،"}},{"id":"t1445-161","text":{"cop":"Ⲡ̀ⲟ̅ⲥ̅ ⲁ̀ⲣⲓϩ̀ⲙⲟⲧ ⲛⲁⲛ ⲙ̀ⲡⲓⲭⲱ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲛⲉⲛⲛⲟⲃⲓ.","cop_lat":"Epshois ari-ehmot nan empiko evol ente nennovi.","en":"O Lord grant us the forgiveness of our sins.","ar":"يا رب أنعم لنا بمغفرة خطايانا."}},{"id":"t1454-1","text":{"cop":"Ⲧⲉⲛⲟⲩⲱϣⲧ ⲙ̀ⲙⲟⲕ ⲱ̀ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ:","cop_lat":"Tenowosht emmok o Pi-ekhristos:","en":"We worship You O Christ,","ar":"نسجد لك أيها المسيح،"},"section":{"en":"The Pauline Epistle, Ⲛⲓϩⲓⲟⲙⲓ ⲙⲁⲣⲟⲩϭⲛⲉϫⲱⲟⲩ","path":"Other Liturgical & Sacramental Services › Holy Matrimony - Crowning Ceremony"}},{"id":"t1454-2","text":{"cop":"ⲛⲉⲙ Ⲡⲉⲕⲓⲱⲧ ⲛ̀ⲁ̀ⲅⲁⲑⲟⲥ:","cop_lat":"nem Pekiot enaghathos:","en":"with Your good Father,","ar":"مع أبيك الصالح،"}},{"id":"t1454-3","text":{"cop":"ⲛⲉⲙ Ⲡⲓⲡ̀ⲛⲉⲩⲙⲁ Ⲉⲑⲟⲩⲁⲃ:","cop_lat":"nem Pi-epnevma Ethowab:","en":"and the Holy Spirit,","ar":"والروح القدس،"}},{"id":"t1454-4","text":{"cop":"ϫⲉ (ⲁⲕⲧⲱⲛⲕ) ⲁⲕⲥⲱϯ ⲙ̀ⲙⲟⲛ.","cop_lat":"je (aktonk) aksoti emmon.","en":"for You have (risen) and saved us.","ar":"لأنك (قُمتَ) وخلصتنا."}},{"id":"t1454-5","text":{"cop":"Ⲛⲁⲓ ⲛⲁⲛ","cop_lat":"Nai nan","en":"Have mercy upon us.","ar":"إرحمنا."}},{"id":"t1454-6","text":{"cop":"Ⲁ̀ⲡⲟⲥⲧⲟⲗⲟⲥ ⲡ̀ⲣⲟⲥ Ⲉ̀ⲫⲉⲥⲟⲥ Ⲕⲉⲫⲁⲗⲉⲟⲛ ⲉ̅ :","cop_lat":"Apostolos epros Efesos Kefaleon etiou :","en":"Reader:","ar":"القارئ:"}},{"id":"t1454-7","text":{"en":"Paul,","ar":"بولس"}},{"id":"t1454-8","text":{"cop":"ⲅ̅","cop_lat":"shomt","en":"the servant of our Lord Jesus Christ,","ar":"عبد"}},{"id":"t1454-9","text":{"cop":"Ⲡⲁⲩⲗⲟⲥ ⲫ̀ⲃⲱⲕ ⲙ̀Ⲡⲉⲛϭⲟⲓⲥ Ⲓⲏⲥⲟⲩⲥ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ:","cop_lat":"Pavlos efvok empenshois Ieesous Pi-ekhristos:","en":"called to be an apostle,","ar":"ربنا يسوع المسيح،"}},{"id":"t1454-10","text":{"cop":"ⲡⲓⲁ̀ⲡⲟⲥⲧⲟⲗⲟⲥ ⲉⲧⲑⲁϩⲉⲙ ⲫⲏⲉ̀ⲧⲁⲩⲑⲁϣϥ ⲉ̀ⲡⲓϩⲓϣⲉⲛⲛⲟⲩϥⲓ ⲛ̀ⲧⲉ Ⲫ̀ⲛⲟⲩϯ. -","cop_lat":"pi-apostolos etthahem fee-etavthashf epihishennoufi ente Efnoti. -","en":"appointed to the Gospel of God.","ar":"الرسول المدعو المفرز لكرازة الله."}},{"id":"t1454-12","text":{"en":"Wives, submit to your own husbands, as to the Lord.","ar":"أَيُّهَا النِّسَاءُ اخْضَعْنَ لِرِجَالِكُنَّ كَمَا لِلرَّبِّ،"}},{"id":"t1454-13","text":{"en":"For the husband is head of the wife,","ar":"لأَنَّ الرَّجُلَ هُوَ رَأْسُ الْمَرْأَةِ كَمَا أَنَّ الْمَسِيحَ أَيْضاً رَأْسُ الْكَنِيسَةِ،"}},{"id":"t1454-14","text":{"cop":"ⲙ̀ⲫ̀ⲣⲏϯ ⲙ̀Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ ⲉ̀ⲧⲉ ⲁ̀ⲫⲉ ⲛ̀ϯⲉⲕⲕⲗⲏⲥⲓⲁ:","cop_lat":"emefreeti empi-ekhristos ete afe entiekkleesia:","en":"as also Christ is head of the church;","ar":"وَهُوَ مُخَلِّصُ الْجَسَدِ."}},{"id":"t1454-15","text":{"cop":"ⲡⲉ ⲛ̀ⲑⲟϥ ⲡⲉ Ⲡ̀ⲥⲱⲧⲏⲣ ⲙ̀ⲡⲓⲥⲱⲙⲁ.","cop_lat":"pe enthof pe Epsoteer empisoma.","en":"and He is the Savior of the body.","ar":"وَلَكِنْ كَمَا تَخْضَعُ الْكَنِيسَةُ لِلْمَسِيحِ،"}},{"id":"t1454-16","text":{"en":"Therefore, just as the church is subject to Christ, so let the wives be to their own husbands in everything.","ar":"كَذَلِكَ النِّسَاءُ لِرِجَالِهِنَّ فِي كُلِّ شَيْءٍ."}},{"id":"t1454-17","text":{"en":"Husbands, love your wives just as Christ also loved the church and gave Himself for her,","ar":"أَيُّهَا الرِّجَالُ، أَحِبُّوا نِسَاءَكُمْ كَمَا أَحَبَّ الْمَسِيحُ أَيْضاً الْكَنِيسَةَ وَأَسْلَمَ نَفْسَهُ لأَجْلِهَا،"}},{"id":"t1454-18","text":{"en":"that He might sanctify and cleanse her with the washing of water by the word,","ar":"لِكَيْ يُقَدِّسَهَا، مُطَهِّراً إِيَّاهَا بِغَسْلِ الْمَاءِ بِالْكَلِمَةِ،"}},{"id":"t1454-19","text":{"en":"that He might present her to Himself a glorious church, not having spot or wrinkle or any such thing, but that she should be holy and without blemish.","ar":"لِكَيْ يُحْضِرَهَا لِنَفْسِهِ كَنِيسَةً مَجِيدَةً، لاَ دَنَسَ فِيهَا وَلاَ غَضْنَ أَوْ شَيْءٌ مِنْ مِثْلِ ذَلِكَ، بَلْ تَكُونُ مُقَدَّسَةً وَبِلاَ عَيْبٍ."}},{"id":"t1454-20","text":{"en":"So husbands ought to love their own wives as their own bodies; he who loves his wife loves himself.","ar":"كَذَلِكَ يَجِبُ عَلَى الرِّجَالِ أَنْ يُحِبُّوا نِسَاءَهُمْ كَأَجْسَادِهِمْ. مَنْ يُحِبُّ امْرَأَتَهُ يُحِبُّ نَفْسَهُ."}},{"id":"t1454-21","text":{"en":"For no one ever hated his own flesh, but nourishes and cherishes it, just as the Lord does the church.","ar":"فَإِنَّهُ لَمْ يُبْغِضْ أَحَدٌ جَسَدَهُ قَطُّ بَلْ يَقُوتُهُ وَيُرَبِّيهِ، كَمَا الرَّبُّ أَيْضاً لِلْكَنِيسَةِ."}},{"id":"t1454-22","text":{"cop":"(ⲗ̅) Ϫⲉ ⲁ̀ⲛⲟⲛ ϩⲁⲛⲙⲉⲗⲟⲥ ⲛ̀ⲧⲉ ⲡⲉϥⲥⲱⲙⲁ.","cop_lat":"(map) Je anon hanmelos ente pefsoma.","en":"For we are members of His body, of His flesh and of His bones.","ar":"لأَنَّنَا أَعْضَاءُ جِسْمِهِ، مِنْ لَحْمِهِ وَمِنْ عِظَامِهِ."}},{"id":"t1454-23","text":{"en":"“For this reason a man shall leave his father and mother and be joined to his wife, and the two shall become one flesh.”","ar":"مِنْ أَجْلِ هَذَا يَتْرُكُ الرَّجُلُ أَبَاهُ وَأُمَّهُ وَيَلْتَصِقُ بِامْرَأَتِهِ، وَيَكُونُ الِاثْنَانِ جَسَداً وَاحِداً."}},{"id":"t1454-24","text":{"en":"This is a great mystery, but I speak concerning Christ and the church.","ar":"هَذَا السِّرُّ عَظِيمٌ، وَلَكِنَّنِي أَنَا أَقُولُ مِنْ نَحْوِ الْمَسِيحِ وَالْكَنِيسَةِ."}},{"id":"t1454-25","text":{"en":"Nevertheless, let each one of you in particular so love his own wife as himself, and let the wife see that she respects her husband.","ar":"وَأَمَّا أَنْتُمُ الأَفْرَادُ، فَلْيُحِبَّ كُلُّ وَاحِدٍ امْرَأَتَهُ هَكَذَا كَنَفْسِهِ، وَأَمَّا الْمَرْأَةُ فَلْتَهَبْ رَجُلَهَا."}},{"id":"t1454-26","text":{"cop":"(ⲋ̅:ⲁ̅) Ⲛⲓϣⲏⲣⲓ ⲥⲱⲧⲉⲙ ⲛ̀ⲥⲁ ⲛⲉⲧⲉⲛⲓⲟϯ ϧⲉⲛ Ⲡ̀ϭⲟⲓⲥ ⲫⲁⲓ ⲅⲁⲣ ⲟⲩϩⲱⲃ ⲙ̀ⲙⲏⲓ ⲡⲉ.","cop_lat":"(soou:o-wai) Nisheeri sotem ensa netenioti khen Epshois fai ghar ouhob emmee pe.","en":"Children, obey your parents in the Lord, for this is right.","ar":"أَيُّهَا الأَوْلاَدُ، أَطِيعُوا وَالِدِيكُمْ فِي الرَّبِّ لأَنَّ هَذَا حَقٌّ."}},{"id":"t1454-27","text":{"cop":"(̅ⲃ̅) Ⲙⲁⲧⲁⲓⲉ ⲡⲉⲕⲓⲱⲧ ⲛⲉⲙ ⲧⲉⲕⲙⲁⲩ ⲉ̀ⲧⲉ ⲑⲁⲓ ⲧⲉ ϯⲉⲛⲧⲟⲗⲏ ⲛ̀ϩⲟⲩⲓϯ ⲉⲧ ϧⲉⲛ ⲡⲓⲱϣ.","cop_lat":"(esnav) Mataie pekiot nem tekmav ete thai te tientolee enhouiti et khen piosh.","en":"“Honor your father and mother,” which is the first commandment with promise:","ar":"أَكْرِمْ أَبَاكَ وَأُمَّكَ، الَّتِي هِيَ أَوَّلُ وَصِيَّةٍ بِوَعْدٍ، لِكَيْ يَكُونَ لَكُمْ خَيْرٌ،"}},{"id":"t1454-28","text":{"cop":"(ⲅ̅) Ϩⲓⲛⲁ ⲛ̀ⲧⲉ ⲡⲓⲡⲉⲑⲛⲁⲛⲉϥ ϣⲱⲡⲓ ⲛⲁⲕ ⲟⲩⲟϩ ⲛ̀ⲧⲉⲕⲉⲣ ⲟⲩⲛⲓϣϯ ⲛ̀ⲭ̀ⲣⲟⲛⲟⲥ ϩⲓϫⲉⲛ ⲡⲓⲕⲁϩⲓ.","cop_lat":"(shomt) Hina ente pipethnanef shopi nak o-woh enteker ounishti enekhronos hijen pikahi.","en":"“That it may be well with you and you may live long on the earth.”","ar":"وَتَكُونُوا طِوَالَ الأَعْمَارِ عَلَى الأَرْضِ."}},{"id":"t1454-29","text":{"cop":"Ⲡⲓϩ̀ⲙⲟⲧ ⲅⲁⲣ ⲛⲉⲙⲱⲧⲉⲛ ⲛⲉⲙ ⲧ̀ϩⲓⲣⲏⲛⲏ ⲉⲩⲥⲟⲡ:","cop_lat":"Pi-ehmot ghar nemoten nem ethireenee evsop:","en":"The grace of God the Father be with you all.","ar":"نعمة الله الآب تكون مع جميعكم."}},{"id":"t1454-30","text":{"cop":"ϫⲉ ⲁ̀ⲙⲏⲛ ⲉⲥⲉ̀ϣⲱⲡⲓ.","cop_lat":"je ameen eseshopi.","en":"Amen.","ar":"آمين."}},{"id":"t1460-0","text":{"cop":"Ⲛⲁⲓ ⲉ̀ⲧⲁϥϩⲟⲧⲡⲟⲩ ⲉⲩⲥⲟⲡ:","cop_lat":"Nai etafhotpou evsop:","en":"Those whom the Holy Spirit,","ar":"هؤلاء الذين،"},"section":{"en":"The Gospel Response, Ⲛⲁⲓ ⲉ̀ⲧⲁϥϩⲟⲧⲡⲟⲩ ⲉ̀ⲩⲥⲟⲡ","path":"Other Liturgical & Sacramental Services › Holy Matrimony - Crowning Ceremony"}},{"id":"t1460-1","text":{"cop":"ⲛ̀ϫⲉ Ⲡⲓⲡ̀ⲛⲉⲩⲙⲁ Ⲉⲑⲟⲩⲁⲃ:","cop_lat":"enje Pi-epnevma Ethowab:","en":"has attuned together,","ar":"ألَّفهم الروح القدس معاً،"}},{"id":"t1460-2","text":{"cop":"ⲙ̀ⲫ̀ⲣⲏϯ ⲛ̀ⲟⲩⲕⲩⲑⲁⲣⲁ:","cop_lat":"emefreeti enoukithara:","en":"as a stringed instrument,","ar":"مثل قيثارة مُسبحين،"}},{"id":"t1460-3","text":{"cop":"ⲉⲩⲥ̀ⲙⲟⲩ ⲉ̀Ⲫ̀ⲛⲟⲩϯ ⲛ̀ⲥⲏⲟⲩ ⲛⲓⲃⲉⲛ.","cop_lat":"evesmou e-efnoti enseeou niven.","en":"always blessing God.","ar":"الله كل حين."}},{"id":"t1460-4","text":{"cop":"Ϧⲉⲛ ϩⲁⲛⲯⲁⲗⲙⲟⲥ ⲛⲉⲙ ϩⲁⲛϩⲱⲥ:","cop_lat":"Khen hanpsalmos nem hanhos:","en":"By psalms and hymns,","ar":"بمزامير وتسابيح،"}},{"id":"t1460-5","text":{"cop":"ⲛⲉⲙ ϩⲁⲛϩⲱⲇⲏ ⲙ̀ⲡ̀ⲛⲉⲩⲙⲁⲧⲓⲕⲟⲛ:","cop_lat":"nem hanhothee emepnevmatikon:","en":"and spiritual songs,","ar":"وترانيم روحية،"}},{"id":"t1460-6","text":{"cop":"ⲙ̀ⲡⲓⲉ̀ϩⲟⲟⲩ ⲛⲉⲙ ⲡⲓⲉ̀ϫⲱⲣϩ:","cop_lat":"empi-ehoou nem pi-egorh:","en":"by day and by night,","ar":"النهار والليل،"}},{"id":"t1460-7","text":{"cop":"ϧⲉⲛ ⲟⲩϩⲏⲧ ⲛ̀ⲁⲧⲭⲁⲣⲱϥ.","cop_lat":"khen ouheet enatkarof.","en":"with an incessant heart.","ar":"بقلب لا يفتر."}},{"id":"t1460-8","text":{"cop":"Ϫⲉ ϥ̀ⲥ̀ⲙⲁⲣⲱⲟⲩⲧ ⲛ̀ϫⲉ Ⲫ̀ⲓⲱⲧ ⲛⲉⲙ Ⲡ̀ϣⲏⲣⲓ:","cop_lat":"Je efesmaroout enje Efiot nem Epsheeri:","en":"For blessed be the Father and the Son,","ar":"لأنه مبارك الآب والإبن،"}},{"id":"t1460-9","text":{"cop":"ⲛⲉⲙ Ⲡⲓⲡ̀ⲛⲉⲩⲙⲁ Ⲉⲑⲟⲩⲁⲃ:","cop_lat":"nem Pi-epnevma Ethowab:","en":"and the Holy Spirit,","ar":"والروح القدس،"}},{"id":"t1460-10","text":{"cop":"Ϯⲧ̀ⲣⲓⲁⲥ ⲉⲧϫⲏⲕ ⲉ̀ⲃⲟⲗ:","cop_lat":"Ti-etrias etjeek evol:","en":"the perfect Trinity,","ar":"الثالوث الكامل،"}},{"id":"t1460-11","text":{"cop":"ⲧⲉⲛⲟⲩⲱϣⲧ ⲙ̀ⲙⲟⲥ ⲧⲉⲛϯⲱ̀ⲟⲩ ⲛⲁⲥ.","cop_lat":"tenowosht emmos tenti-oou nas.","en":"we worship Him and glorify Him.","ar":"نسجد له ونمجده."}},{"id":"t1460-12","text":{"cop":"Ⲕⲩⲣⲓⲉ ⲉ̀ⲗⲉⲏ̀ⲥⲟⲛ (ⲅ̅).","cop_lat":"Kirie ele-eeson (shomt).","en":"Lord have mercy (3).","ar":"يا رب إرحم (3)."}},{"id":"t1468-1","text":{"cop":"Ⲕⲁⲧⲁ ⲫ̀ⲣⲏϯ ⲉ̀ⲧⲁⲕⲧⲏⲓⲥ:","cop_lat":"Kata efreeti etakteeis:","en":"As You have given,","ar":"كما أعطيته،"},"section":{"en":"The First Matrimonial Prayer Response, Ⲕⲁⲧⲁ ⲫ̀ⲣⲏϯ ⲉ̀ⲧⲁⲕⲧⲏⲓⲥ","path":"Other Liturgical & Sacramental Services › Holy Matrimony - Crowning Ceremony"}},{"id":"t1468-2","text":{"cop":"ⲛ̀ⲛⲉⲕⲁ̀ⲅⲓⲟⲥ ⲛ̀ⲁ̀ⲡⲟⲥⲧⲟⲗⲟⲥ:","cop_lat":"ennekagios enapostolos:","en":"to Your saintly Apostles,","ar":"لرسلك القديسين،"}},{"id":"t1468-3","text":{"cop":"ⲉⲕⲉ̀ϫⲟⲥ ⲛⲁⲛ ⲙ̀ⲡⲟⲩⲣⲏϯ:","cop_lat":"ekegos nan empoureeti:","en":"likewise also say to us,","ar":"قُل لنا مثلهم،"}},{"id":"t1468-4","text":{"cop":"ϫⲉ ⲧⲁϩⲓⲣⲏⲛⲏ ϯϯ ⲙ̀ⲙⲟⲥ ⲛⲱⲧⲉⲛ.","cop_lat":"je tahireenee titi emmos noten.","en":"“My peace I give to You.”","ar":"\"إني أعطيكم سلامي.\""}},{"id":"t1468-5","text":{"cop":"Ⲧ̀ⲡⲩⲗⲏ ⲛ̀ⲧⲉ ⲛⲓⲙⲁⲛ̀ϣⲁⲓ:","cop_lat":"Etpilee ente nima-enshai:","en":"The gate in the East,","ar":"الباب الذي في المشارق،"}},{"id":"t1468-6","text":{"cop":"ⲡⲉ Ⲙⲁⲣⲓⲁ Ϯⲡⲁⲣⲑⲉⲛⲟⲥ:","cop_lat":"pe Maria Tiparthenos:","en":"is Mary the Virgin,","ar":"هو مريم العذراء،"}},{"id":"t1468-7","text":{"cop":"ⲡⲓⲙⲁⲛ̀ϣⲉⲗⲉⲧ ⲉⲧⲧⲟⲩⲃⲏⲟⲩⲧ:","cop_lat":"pima-enshelet ettouveeout:","en":"the chaste bridal chamber,","ar":"الخدر الطاهر،"}},{"id":"t1468-8","text":{"cop":"ⲛ̀ⲧⲉ Ⲡⲓⲛⲩⲙⲫⲓⲟⲥ ⲛ̀ⲕⲁⲑⲁⲣⲟⲥ.","cop_lat":"ente Pinimfios enkatharos.","en":"of the pure Bridegroom.","ar":"الذي للختن النقي."}},{"id":"t1468-9","text":{"cop":"Ⲕⲩⲣⲓⲉ ⲉ̀ⲗⲉⲏ̀ⲥⲟⲛ (ⲅ̅).","cop_lat":"Kirie ele-eeson (shomt).","en":"Lord have mercy (3).","ar":"يا رب إرحم (3)."}},{"id":"t1470-1","text":{"cop":"Ⲧⲁϩⲓⲣⲏⲛⲏ ⲁ̀ⲛⲟⲕ:","cop_lat":"Tahireenee anok:","en":"“My peace which I have taken,","ar":"\"سلامي أنا،"},"section":{"en":"The Second Matrimonial Prayer Response, Ⲧⲁϩⲓⲣⲏⲛⲏ ⲁ̀ⲛⲟⲕ","path":"Other Liturgical & Sacramental Services › Holy Matrimony - Crowning Ceremony"}},{"id":"t1470-2","text":{"cop":"ⲑⲏⲉ̀ⲧⲁⲓϭⲓⲧⲥ ϩⲓⲧⲉⲛ Ⲡⲁⲓⲱⲧ:","cop_lat":"thee-etaichits hiten Paiot:","en":"from My Father,","ar":"الذي أخذته من أبي،"}},{"id":"t1470-3","text":{"cop":"ⲁ̀ⲛⲟⲕ ϯⲭⲱ ⲙ̀ⲙⲟⲥ ⲛⲉⲙⲱⲧⲉⲛ:","cop_lat":"anok tiko emmos nemoten:","en":"I leave unto you,","ar":"أنا أتركه معكم،"}},{"id":"t1470-4","text":{"cop":"ⲓⲥϫⲉⲛ ϯⲛⲟⲩ ⲛⲉⲙ ϣⲁ ⲉ̀ⲛⲉϩ.","cop_lat":"isjen tinou nem sha eneh.","en":"both now and forever.”","ar":"من الأن وإلى الأبد.\""}},{"id":"t1470-5","text":{"cop":"Ⲉⲑⲃⲉ Ϯⲡⲁⲣⲑⲉⲛⲟⲥ:","cop_lat":"Ethve Tiparthenos:","en":"For the Virgin St. Mary:","ar":"للعذراء القديسة مريم:"}},{"id":"t1470-6","text":{"cop":"Ⲛⲓⲟⲩⲣⲱⲟⲩ ⲧⲏⲣⲟⲩ ⲛ̀ⲧⲉ ⲡ̀ⲕⲁϩⲓ:","cop_lat":"Niouroou teerou ente epkahi:","en":"All the kings of the earth,","ar":"كل ملوك الأرض،"}},{"id":"t1470-7","text":{"cop":"ⲥⲉⲙⲟϣⲓ ϧⲉⲛ ⲡⲓⲟⲩⲱⲓⲛⲓ:","cop_lat":"semoshi khen piowoini:","en":"walk into your light,","ar":"يسيرون في نورِك،"}},{"id":"t1470-8","text":{"cop":"ⲟⲩⲟϩ ⲛⲓⲉⲑⲛⲟⲥ ϧⲉⲛ ⲡⲉⲫⲓⲣⲓ:","cop_lat":"o-woh niethnos khen pefiri:","en":"and the nations in your brightness,","ar":"والأمم في ضيائِك،"}},{"id":"t1470-9","text":{"cop":"ⲱ̀ Ⲙⲁⲣⲓⲁ Ⲑ̀ⲙⲁⲩ ⲙ̀Ⲫ̀ⲛⲟⲩϯ.","cop_lat":"o Maria Ethmav emefnoti.","en":"O Mary the Mother of God.","ar":"يا مريم أُم الله."}},{"id":"t1470-10","text":{"cop":"Ⲥⲟⲗⲟⲙⲱⲛ ⲙⲟⲩϯ ⲉ̀ⲣⲟⲥ:","cop_lat":"Solomon mouti eros:","en":"Solomon has called her,","ar":"سليمان دعاها،"}},{"id":"t1470-11","text":{"cop":"ϧⲉⲛ ⲡⲓϫⲱ ⲛ̀ⲧⲉ ⲛⲓϫⲱ:","cop_lat":"khen pigo ente nigo:","en":"in the Song of Songs,","ar":"في نشيد الأنشاد،"}},{"id":"t1470-12","text":{"cop":"ϫⲉ ⲧⲁⲥⲱⲛⲓ ⲟⲩⲟϩ ⲧⲁϣ̀ⲫⲉⲣⲓ:","cop_lat":"je tasoni o-woh ta-eshferi:","en":"“My sister and my spouse,","ar":"وقال \"أختي صديقتي،"}},{"id":"t1470-13","text":{"cop":"ⲧⲁⲡⲟⲗⲓⲥ ⲙ̀ⲙⲏⲓ Ⲓⲉⲣⲟⲩⲥⲁⲗⲏⲙ.","cop_lat":"tapolis emmee Yerousaleem.","en":"my true city Jerusalem.”","ar":"مدينتي الحقيقية أورشليم.\""}},{"id":"t1470-14","text":{"cop":"Ⲕⲩⲣⲓⲉ ⲉ̀ⲗⲉⲏ̀ⲥⲟⲛ (ⲅ̅).","cop_lat":"Kirie ele-eeson (shomt).","en":"Lord have mercy (3).","ar":"يا رب إرحم (3)."}},{"id":"t1474-1","text":{"cop":"Ⲉϥⲉ̀ⲥ̀ⲙⲟⲩ ⲉ̀ⲣⲟⲛ ⲛ̀ϫⲉ Ⲫ̀ⲛⲟⲩϯ:","cop_lat":"Efe-esmou eron enje Efnoti:","en":"May God bless us,","ar":"يباركنا الله،"},"section":{"en":"Prayer of Submission Response, Ⲉϥⲉ̀ⲥ̀ⲙⲟⲩ ⲉ̀ⲣⲟⲛ ⲛ̀ϫⲉ Ⲫ̀ⲛⲟⲩϯ","path":"Other Liturgical & Sacramental Services › Holy Matrimony - Crowning Ceremony"}},{"id":"t1474-2","text":{"cop":"ⲧⲉⲛⲛⲁⲥ̀ⲙⲟⲩ ⲉ̀ⲡⲉϥⲣⲁⲛ ⲉⲑⲟⲩⲁⲃ:","cop_lat":"tenna-esmou epefran ethowab:","en":"and let us bless His holy name,","ar":"ولنبارك إسمه القدوس،"}},{"id":"t1474-3","text":{"cop":"ⲛ̀ⲥⲏⲟⲩ ⲛⲓⲃⲉⲛ ⲉ̀ⲣⲉ ⲡⲉϥⲥ̀ⲙⲟⲩ:","cop_lat":"enseeou niven ere pefesmou:","en":"and may His praise continually be,","ar":"في كل حين تسبحته،"}},{"id":"t1474-4","text":{"cop":"ⲛⲁϣⲱⲡⲓ ⲉϥⲙⲏⲛ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲣⲱⲛ.","cop_lat":"nashopi efmeen evol khen ron.","en":"always upon our mouths.","ar":"دائمة في أفواهنا."}},{"id":"t1474-5","text":{"cop":"Ⲕⲩⲣⲓⲉ ⲉ̀ⲗⲉⲏ̀ⲥⲟⲛ (ⲅ̅).","cop_lat":"Kirie ele-eeson (shomt).","en":"Lord have mercy (3).","ar":"يا رب إرحم (3)."}}]}