{"title":"Other","source":"tasbeha.org hymn library","languages":{"en":"English","cop":"Ⲙⲉⲧⲣⲉⲙⲛ̀ⲭⲏⲙⲓ","cop_lat":"Coptic (Latin letters)","ar":"عربي"},"roles":{"priest":{"en":"Priest","de":"Priester","ar":"الكاهن","cop":"Ⲡⲓⲟⲩⲏⲃ"},"deacon":{"en":"Deacon","de":"Diakon","ar":"الشماس","cop":"Ⲡⲓⲇⲓⲁⲕⲱⲛ"},"people":{"en":"People","de":"Gemeinde","ar":"الشعب","cop":"Ⲡⲓⲗⲁⲟⲥ"}},"paragraphs":[{"id":"t315-0","text":{"cop":"Ⲧⲉⲛⲟⲩⲱϣⲧ ⲙ̀Ⲫⲓⲱⲧ ⲙ̀ⲡⲓⲟⲩⲱⲓⲛⲓ ⲛⲉⲙ:","cop_lat":"Tenowosht emfiot empiowoini nem:","en":"We worship the Father of Light,","ar":"نسجد لآب النور،"},"section":{"en":"Ten-oo-osht, Ⲧⲉⲛⲟⲩⲱϣⲧ","path":""}},{"id":"t315-1","text":{"cop":"Ⲡⲉϥϣⲏⲣⲓ ⲙ̀ⲙⲟⲛⲟⲅⲉⲛⲏⲥ:","cop_lat":"Pefsheeri emmonogenees:","en":"and His only-begotten Son,","ar":"و إبنه الوحيد،"}},{"id":"t315-2","text":{"cop":"ⲛⲉⲙ Ⲡⲓⲡ̅ⲛ̅ⲁ ⲙ̀Ⲡⲁⲣⲁⲕⲗⲏⲧⲟⲛ:","cop_lat":"nem Pi-epnevma emparakleeton:","en":"and the Holy Spirit, the Trinity,","ar":"و الروح المعزي"}},{"id":"t315-3","text":{"cop":"Ϯⲧ̀ⲣⲓⲁⲥ ⲛ̀ⲟⲙⲟⲟⲩⲥⲓⲟⲥ.","cop_lat":"Ti-etrias enomoousios.","en":"one in essence.","ar":"الثالوث المساوي."}},{"id":"t673-0","text":{"cop":"Ⲁⲗⲗⲏⲗⲟⲩⲓⲁ","cop_lat":"Alleelouia","en":"Alleluia.","ar":"هلليلويا."},"section":{"en":"Al El-orban (Alleluia of the oblation), Ⲁⲗⲗⲏⲗⲟⲩⲓⲁ","path":""}},{"id":"t52-0","text":{"cop":"Ⲁⲗⲗⲏⲗⲟⲩⲓⲁ Ⲫⲁⲓ ⲡⲉ ⲡⲓⲉ̀ϩⲟⲟⲩ ⲉ̀ⲧⲁ Ⲡ̀ϭⲟⲓⲥ ⲑⲁⲙⲓⲟϥ :","cop_lat":"Alleelouia Fai pe pi-ehoou eta Epshois thamiof :","en":"Alleluia. This is the day that the Lord has made.","ar":"هلليلويا. هذا هو اليوم الذي صنعه الرب"},"section":{"en":"Alleluia.  This is the day, Ⲁⲗⲗⲏⲗⲟⲩⲓⲁ Ⲫⲁⲓ ⲡⲉ ⲡⲓⲉ̀ϩⲟⲟⲩ","path":""}},{"id":"t52-1","text":{"cop":"ⲙⲁⲣⲉⲛⲑⲉⲗⲏⲗ ⲛ̀ⲧⲉⲛⲟⲩⲛⲟϥ ⲙ̀ⲙⲟⲛ ⲛ̀ϧⲏⲧϥ :","cop_lat":"marentheleel entenounof emmon enkheetf :","en":"Let us rejoice and be glad in it.","ar":"فلنفرح ونبتهج فيه."}},{"id":"t52-2","text":{"cop":"ⲱ̀ Ⲡ̀ϭⲟⲓⲥ ⲉⲕⲉ̀ⲛⲁϩⲙⲉⲛ :","cop_lat":"o Epshois ekenahmen :","en":"O Lord save us.","ar":"يا رب خلصنا"}},{"id":"t52-3","text":{"cop":"ⲱ̀ Ⲡ̀ϭⲟⲓⲥ ⲉⲕⲉ̀ⲥⲟⲩⲧⲉⲛ ⲛⲉⲛⲙⲱⲓⲧ :","cop_lat":"o Epshois ekesouten nenmoit :","en":"O Lord straighten our ways.","ar":"يا رب سهل سبيلنا."}},{"id":"t52-4","text":{"cop":"ϥ̀ⲥ̀ⲙⲁⲣⲱⲟⲩⲧ ⲛ̀ϫⲉ ⲫⲏⲉⲑⲛⲏⲟⲩ ϧⲉⲛ ⲫ̀ⲣⲁⲛ ⲙ̀Ⲡ̀ϭⲟⲓⲥ :","cop_lat":"efesmaroout enje fee-ethneeou khen efran emepshois :","en":"Blessed is He, Who comes in the name of the Lord.","ar":"مبارك الآتي باسم الرب."}},{"id":"t52-5","text":{"cop":"Ⲁⲗⲗⲏⲗⲟⲩⲓⲁ","cop_lat":"Alleelouia","en":"Alleluia.","ar":"هلليلويا."}},{"id":"t53-0","text":{"cop":"Ⲁⲗⲗⲏⲗⲟⲩⲓⲁ ϫⲉ ⲫ̀ⲙⲉⲩⲓ̀ ⲛ̀ⲟⲩⲣⲱⲙⲓ ⲉⲩⲉ̀ⲟⲩⲱⲛϩ ⲛⲁⲕ ⲉ̀ⲃⲟⲗ Ⲡ̀ϭⲟⲓⲥ :","cop_lat":"Alleelouia je efmevi enouromi eveowonh nak evol Epshois :","en":"Alleluia. The thought of man shall confess to You, O Lord,","ar":"هلليلويا."},"section":{"en":"Alleluia.  The thought of man, Ⲁⲗⲗⲏⲗⲟⲩⲓⲁ ϫⲉ ⲫ̀ⲙⲉⲩⲓ̀","path":""}},{"id":"t53-1","text":{"cop":"ⲟⲩⲟϩ ⲡ̀ⲥⲱϫⲡ ⲛ̀ⲧⲉ ⲟⲩⲙⲉⲩⲓ̀ ⲉϥⲉ̀ⲉⲣϣⲁⲓ ⲛⲁⲕ :","cop_lat":"o-woh epsogp ente oumevi efe-ershai nak :","en":"and the rest of thought shall keep a feast to You.","ar":"إن فكر الإنسان يعترف لك يا رب،"}},{"id":"t53-2","text":{"cop":"ⲛⲓⲑⲩⲥⲓⲁ̀ ⲛⲓⲡ̀ⲣⲟⲥⲫⲟⲣⲁ ϣⲟⲡⲟⲩ ⲉ̀ⲣⲟⲕ :","cop_lat":"nithisi-a ni-eprosfora shopou erok :","en":"The Sacrifices and the offerings, receive them.","ar":"و بقية الفكر تعيد لك."}},{"id":"t53-3","text":{"cop":"Ⲁⲗⲗⲏⲗⲟⲩⲓⲁ.","cop_lat":"Alleelouia.","en":"Alleluia.","ar":"التقدمات و القرابين إقبلها إليك.هلليلويا."}},{"id":"t54-0","text":{"cop":"Ⲛⲓⲥⲁⲃⲉⲩ ⲧⲏⲣⲟⲩ ⲛ̀ⲧⲉ Ⲡⲓⲥⲣⲁⲏⲗ:","cop_lat":"Nisavev teerou ente Pisraeel:","en":"All the wise men of Israel,","ar":"يا كل حكماء اسرائيل"},"section":{"en":"All the wise men of Israel, Ⲛⲓⲥⲁⲃⲉⲩ ⲧⲏⲣⲟⲩ","path":""}},{"id":"t54-1","text":{"cop":"ⲛⲏⲉ̀ⲧⲉⲣϩⲱⲃ ⲉ̀ⲛⲓⲕⲁⲡ ⲛ̀ⲛⲟⲩⲃ:","cop_lat":"nee-eterhob enikap ennoub:","en":"who craft threads of gold,","ar":"صناع خيوط الذهب،"}},{"id":"t54-2","text":{"cop":"ⲙⲁⲑⲁⲙⲓⲟ̀ ⲛ̀ⲟⲩϣ̀ⲑⲏⲛ ⲛ̀ⲧⲉ Ⲁⲁⲣⲱⲛ ⲕⲁⲧⲁ ⲡ̀ⲧⲁⲓⲟ̀ ⲛ̀ϯⲙⲉⲧⲟⲩⲏⲃ ⲙ̀ⲡⲉⲛⲓⲱⲧ ⲉⲧⲧⲁⲓⲏⲟⲩⲧ ⲛ̀ⲁⲣⲭⲓⲉ̀ⲣⲉⲩⲥ ⲡⲁⲡⲁ ⲁⲃⲃⲁ (Ϣⲉⲛⲟⲩϯ):( *):","cop_lat":"mathami-o enou-eshteen ente A-aron kata eptai-o entimetoweeb empeniot ettaieeout enarshi-erevs papa abba (Shenouti):( *):","en":"make a garment of Aaron according to the honor of the priesthood of our honored father, the chief priest,","ar":"اصنعوا ثوباً هارونيا لائقا بكرامة كهنوت ابينا المكرم رئيس الكهنة البابا ____(*)"}},{"id":"t54-3","text":{"cop":"ⲡⲓⲙⲉⲛⲣⲓⲧ ⲛ̀ⲧⲉ Ⲡⲓⲭⲣⲓⲥⲧⲟⲥ.","cop_lat":"pimenrit ente Pikhristos.","en":"Pope abba (Shenouda)(*)the beloved of Christ.","ar":"حبيي المسيح."}},{"id":"t54-4","text":{"cop":"*Ⲛⲉⲙ ⲡⲉⲛⲓⲱⲧ ⲛ̀ⲉ̀ⲡⲓⲥⲕⲟⲡⲟⲥ (ⲙ̀ⲙⲩⲧⲣⲟⲡⲟⲗⲓⲧⲏⲥ) ⲁⲃⲃⲁ (...) :","cop_lat":"*Nem peniot enepiskopos (emmitropolitees) abba (...) :","en":"*And our father, the bishop (the metropolitan), Abba (...),","ar":"* و ابينا الاسقف(المطران)"}},{"id":"t54-5","text":{"cop":"ⲛⲓⲙⲉⲛⲣⲁϯ ⲛ̀ⲧⲉ Ⲡⲓⲭⲣⲓⲥⲧⲟⲥ.","cop_lat":"nimenrati ente Pikhristos.","en":"the beloved of Christ.","ar":"انبا____."}},{"id":"t54-6","text":{"cop":"*Ⲛⲉⲙ ⲛⲉⲛⲓⲟⲧ ⲛ̀ⲉ̀ⲡⲓⲥⲕⲟⲡⲟⲥ (ⲙ̀ⲙⲏⲧⲣⲟⲡⲟⲗⲓⲧⲏⲥ) ⲛⲏⲉⲧⲭⲏ ⲛⲉⲙⲁⲛ :","cop_lat":"*Nem neniot enepiskopos (emmeetropolitees) nee-etkee neman :","en":"*And our fathers, the bishops (the metropolitans), who are with us,","ar":"* و ابائنا"}},{"id":"t54-7","text":{"cop":"ⲛⲓⲙⲉⲛⲣⲁϯ ⲛ̀ⲧⲉ Ⲡⲓⲭⲣⲓⲥⲧⲟⲥ.","cop_lat":"nimenrati ente Pikhristos.","en":"the beloved of Christ.","ar":"الاساقفه(المطارنة)."}},{"id":"t317-0","text":{"cop":"Ⲥⲱⲑⲓⲥ ⲁ̀ⲙⲏⲛ:","cop_lat":"Sothis ameen:","en":"Saved. Amen.","ar":"خلصت حقاً."},"section":{"en":"Saved.Amen., Ⲥⲱⲑⲓⲥ ⲁ̀ⲙⲏⲛ","path":""}},{"id":"t317-1","text":{"cop":"ⲕⲉ ⲧⲱ ⲡ̀ⲛⲉⲩⲙⲁⲧⲓ ⲥⲟⲩ.","cop_lat":"ke to epnevmati sou.","en":"And with your spirit.","ar":"و لروحك."}},{"id":"t363-0","text":{"cop":"Ⲱ ⲡⲉⲛⲟ̅ⲥ̅ Ⲓⲏ̅ⲥ Ⲡⲭ̅ⲥ ⲫⲏⲉⲧⲱ̀ⲗⲓ ⲙ̀ⲫ̀ⲛⲟⲃⲓ ⲙ̀ⲡⲓⲕⲟⲥⲙⲟⲥ ⲟⲡⲧⲉⲛ ϩⲱⲛ ⲛⲉⲙ ⲛⲉⲕϩⲓⲛⲏⲃ ⲛⲁⲓ ⲉⲧⲥⲁⲟⲩⲓ̀ⲛⲁⲙ ⲙ̀ⲙⲟⲕ","cop_lat":"O penshois Ieesous Pi-ekhristos fee-etoli emefnovi empikosmos opten hon nem nekhineeb nai etsaouinam emmok","en":"O Our Lord Jesus Christ, Who carries the sin of the world, count us with Your sheep, those who are to Your right.","ar":"(هذه تقال ختام الثاوطوكيات الواطس بعد قراءه الدفنار )"},"section":{"en":"Conclusion of Watos Theotokias, Ⲱ Ⲡⲉⲛⲟ̅ⲥ̅ Ⲓⲏ̅ⲥ̅ Ⲡ̅ⲭ̅ⲥ̅","path":""}},{"id":"t363-1","text":{"cop":"Ⲁⲕϣⲁⲛⲓ̀ ϧⲉⲛ ⲧⲉⲕⲙⲁϩⲥ̀ⲛⲟⲩϯ ⲙ̀ⲡⲁⲣⲟⲩⲥⲓⲁ̀ ⲉⲧⲟⲓ ⲛ̀ϩⲟϯ ⲙ̀ⲡⲉⲛⲑ̀ⲣⲉⲛⲥⲱⲧⲉⲙ ϧⲉⲛ ⲟⲩⲥ̀ⲑⲉⲣⲧⲉⲣ ϫⲉ ϯⲥⲱⲟⲩⲛ ⲙ̀ⲙⲱⲧⲉⲛ ⲁⲛ","cop_lat":"Akshani khen tekmahesnoti emparousi-a etoi enhoti empenethrensotem khen ou-esterter je tisooun emmoten an","en":"And when You come again, in You second fearful appearance, may we never fearfully hear, You say I do not know you.","ar":"ياربنا يسوع المسيح حامل خطيه العلم أحسبنا مع خرافك الذين عن يمينك. عند ظهورك الثانى المخوف لانسمع برعده أءننى لست أعرفكم. بل نكون مستحقين لسماع صوتك الحنون الممتلىء فرحا يصرخ قائلا. تعالوا الى يامباركى أبى رثوا الحياه الدائمه الى الابد. يأتى الشهداء حاملين عذاباتهم ويأتى الصدقيون حاملين فضائلهم. يأتى ابن الله فى مجده ومجد أبيه ويجازى كل واحد كأعماله التى عملها. أيها المسيح كلمه الاب أعطنا سلامك المملوء فرحا. كماأعطيته لرسلك القدسين قلناملهم أنى أعطيكم سلامى . سلامى أنا الذى أخذته من أبى.أنا أتركه معكم من الان والى الابد. ياملاك هذا اليوم الطائر الى العلو بهذه التسبحه أذكرنا لدى الرب ليغفر لنا خطايانا. المرضى أشفهم الذين الذين رقدوا يارب نيحهم وأخواتنا الذين فى كل شده ياربى أعنا وأياهم. ياباركنا الله.ولنبارك أسمه القدوس.غى كل حين تسبحته دائمه فى أفواهنا. مبارك الاب والابن والروح القدس الثالوث الكامل نسجد له ونمجده."}},{"id":"t363-2","text":{"cop":"Ⲁⲗⲗⲁ ⲙⲁⲣⲉⲛⲉⲣⲡ̀ⲉⲙⲡ̀ϣⲁ ⲛ̀ⲥⲱⲧⲉⲙ ⲉ̀ϯⲥ̀ⲙⲏ ⲉⲑⲙⲉϩ ⲛ̀ⲣⲁϣⲓ ⲛ̀ⲧⲉ ⲛⲉⲕⲙⲉⲧϣⲁⲛⲁϩ̀ⲑⲏϥ ⲉⲥⲱϣ ⲉ̀ⲃⲟⲗ ⲉⲥϫⲱ ⲙ̀ⲙⲟⲥ","cop_lat":"Alla marenerepemepsha ensotem eti-esmee ethmeh enrashi ente nekmetshana-ehtheef esosh evol esgo emmos","en":"But rather may we be made worthy, to hear the voice full of Joy, of Your tender mercies, proclaiming and saying","ar":"Arabic-English Je rabbene jesoe3 el messie`h, `hemil gateejat il 3elem, i`h sibne me3 gierafek, elleziene 3en je mienek."}},{"id":"t363-3","text":{"cop":"Ϫⲉ ⲁ̀ⲙⲱⲓⲛⲓ ϩⲁⲣⲟⲓ ⲛⲏⲉⲧⲥ̀ⲙⲁⲣⲱⲟⲩⲧ ⲛ̀ⲧⲉ Ⲡⲁⲓⲱⲧ ⲁ̀ⲣⲓⲕ̀ⲗⲏⲣⲟⲛⲟⲙⲓⲛ ⲙ̀ⲡⲓⲱⲛϧ ⲉⲑⲙⲏⲛ ⲉⲃⲟⲗ ϣⲁ ⲉⲛⲉϩ","cop_lat":"Je amoini haroi nee-etesmaroout ente Paiot ari-ekleeronomin empionkh ethmeen evol sha eneh","en":"\"Come unto Me, O blessed of My Father, and inherit the Life, that endures forever.\"","ar":"3ind zohoerik el senie, el megoefoe le nesme3, bie ri3detin in ne nie, lesto e3riffekom."}},{"id":"t363-4","text":{"cop":"Ⲥⲉⲛⲁⲓ̀ ⲛ̀ϫⲉ ⲛⲓⲙⲁⲣⲧⲩⲣⲟⲥ ⲉⲩϥⲁⲓ ϧⲁ ⲛⲟⲩⲃⲁⲥⲁⲛⲟⲥ ⲥⲉⲛⲁⲓ̀ ⲛ̀ϫⲉ ⲛⲓⲇⲓⲕⲉⲟⲥ ⲉⲩϥⲁⲓ ϧⲁ ⲛⲟⲩⲡⲟⲗⲏⲧⲓⲁ̀","cop_lat":"Sena-i enje nimartiros evfai kha nouvasanos sena-i enje nithikeos evfai kha noupoleeti-a","en":"The martyrs will come, bearing their afflictions, and the righteous will come, bearing their virtues.","ar":"Bel nekoen mosta`hik kien, lie seme3 sauwtik il `henoen, il mom te li2 fara`han, jas rogoe ka ielen."}},{"id":"t363-5","text":{"cop":"Ϥ̀ⲛⲁⲓ̀ ⲛ̀ϫⲉ ⲡ̀ϣⲏⲣⲓ ⲙ̀Ⲫϯ ϧⲉⲛ ⲡⲉϥⲱ̀ⲟⲩ ⲛⲉⲙ ⲫⲁ Ⲡⲉϥⲓⲱⲧ ϥ̀ⲛⲁϯ ⲙ̀ⲡⲓⲟⲩⲁⲓ ⲕⲁⲧⲁ ⲛⲉϥϩ̀ⲃⲏⲟⲩⲓ̀ ⲉ̀ⲧⲁϥⲁⲓⲧⲟⲩ","cop_lat":"Efna-i enje epsheeri emefnoti khen pefoou nem fa Pefiot efnati empiowai kata nefehveeoui etafaitou","en":"The son of God shall come in His glory, and His fathers Glory, to give unto everyone, according to his deeds which he has done.","ar":"Te 3eloe ielei je, je moberekie ebieh, risoe el `he je, el de ie-me iele el ebed."}},{"id":"t363-6","text":{"cop":"Ⲡⲭ̅ⲥ ⲡⲓⲗⲟⲅⲟⲥ ⲛ̀ⲧⲉ Ⲫ̀ⲓⲱⲧ ⲡⲓⲙⲟⲛⲟⲅⲉⲛⲏⲥ ⲛ̀ⲛⲟⲩϯ ⲉⲕⲉ̀ϯ ⲛⲁⲛ ⲛ̀ⲧⲉⲕϩⲓⲣⲏⲛⲏ ⲑⲁⲓ ⲉⲑⲙⲉϩ ⲛ̀ⲣⲁϣⲓ ⲛⲓⲃⲉⲛ","cop_lat":"Pi-ekhristos piloghos ente Efiot pimonogenees ennoti eketi nan entekhireenee thai ethmeh enrashi niven","en":"O Christ the word of the Father, the Only begotten God, grant us Your peace, that is full of Joy.","ar":"Je2tie el shohede2, `hemiliene 3eze betiehim, we je2tie el sid dikoen, `hemiliene fada il-lehom."}},{"id":"t363-7","text":{"cop":"Ⲕⲁⲧⲁ ⲫ̀ⲣⲏϯ ⲉ̀ⲧⲁⲕⲧⲏⲓⲥ ⲛ̀ⲛⲉⲕⲁ̀ⲅⲓⲟⲥ ⲛ̀ⲁ̀ⲡⲟⲥⲧⲟⲗⲟⲥ ⲉⲕⲉ̀ϫⲟⲥ ⲛⲁⲛ ⲙ̀ⲡⲟⲩⲣⲏϯ ϫⲉ ⲧⲁϩⲓⲣⲏⲛⲏ ϯϯ ⲙ̀ⲙⲟⲥ ⲛⲱⲧⲉⲛ","cop_lat":"Kata efreeti etakteeis ennekagios enapostolos ekegos nan empoureeti je tahireenee titi emmos noten","en":"As You have Given, to Your saintly apostles, likewise also say to us, \"My Peace I give unto You\"","ar":"Je2tie ibn allah, fie mekhdiehie we mekhdie ebieh, we jo-khezie kolle we`hid, ke e3melihie el letie 3emelhe."}},{"id":"t363-8","text":{"cop":"Ⲧⲁϩⲓⲣⲏⲛⲏ ⲁ̀ⲛⲟⲕ ⲑⲏⲉ̀ⲧⲁⲓϭⲓⲧⲥ ϩⲓⲧⲉⲛ Ⲡⲁⲓⲱⲧ ⲁ̀ⲛⲟⲕ ϯⲭⲱ ⲙ̀ⲙⲟⲥ ⲛⲉⲙⲱⲧⲉⲛ ⲓⲥϫⲉⲛ ϯⲛⲟⲩ ⲛⲉⲙ ϣⲁ ⲉ̀ⲛⲉϩ","cop_lat":"Tahireenee anok thee-etaichits hiten Paiot anok tiko emmos nemoten isjen tinou nem sha eneh","en":"\"My peace which I have taken, from My Father, I leave unto you, both now and forever\"","ar":"Ei johe el messie`h keliemet ol eb, el ieleh il weh`ied, a3tiena selemek, el memloe2e fara`han."}},{"id":"t363-9","text":{"cop":"Ⲡⲓⲁⲅⲅⲉⲗⲟⲥ ⲛ̀ⲧⲉ ⲡⲁⲓ ⲉ̀ϩⲟⲟⲩ ⲉⲧϩⲏⲗ ⲉ̀ⲡ̀ϭⲓⲥⲓ ⲛⲉⲙ ⲡⲁⲓϩⲩⲙⲛⲟⲥ ⲁⲣⲓⲡⲉⲛⲙⲉⲩⲓ̀ ϧⲁⲧ̀ϩⲏ ⲙ̀Ⲡⲟ̅ⲥ̅ ⲛ̀ⲧⲉϥⲭⲁ ⲛⲉⲛⲛⲟⲃⲓ ⲛⲁⲛ ⲉ̀ⲃⲟⲗ","cop_lat":"Piangelos ente pai ehoou etheel e-epchisi nem paihimnos aripenmevi kha-ethee emepshois entefka nennovi nan evol","en":"O the angel of this day(night), flying up with this hymn, remember us before the Lord, that he may forgive us our sins.","ar":"Keme a3taj tehoe, lie rosolik el kiddisien, kol lene mislehom, in nie a3tiekom selemie."}},{"id":"t363-10","text":{"cop":"Ⲛⲏⲉⲧϣⲱⲛⲓ ⲙⲁⲧⲁⲗϭⲱⲟⲩ ⲛⲏⲉ̀ⲧⲁⲩⲉⲛⲕⲟⲧ Ⲡⲟ̅ⲥ̅ ⲙⲁⲙ̀ⲧⲟⲛ ⲛⲱⲟⲩ ⲛⲉⲛⲥ̀ⲛⲏⲟⲩ ⲉⲧⲭⲏ ϧⲉⲛ ϩⲟϫϩⲉϫ ⲛⲓⲃⲉⲛ Ⲡⲁⲟ̅ⲥ̅ ⲁ̀ⲣⲓⲃⲟⲓⲑⲓⲛ ⲉ̀ⲣⲟⲛ ⲛⲉⲙⲱⲟⲩ","cop_lat":"Nee-etshoni matalchoou nee-etavenkot Epshois ma-emton noou nenesneeou etkee khen hogheg niven Pashois arivoithin eron nemoou","en":"The sick heal them, those who have slept O Lord repose them, and all of our brothers in distress, help us my Lord and all of them.","ar":"Selemie ene el lezie, egezteho min ebieh, ene atrokeho me3kom, min el en we iele el ebed."}},{"id":"t363-11","text":{"cop":"Ⲉϥⲉ̀ⲥ̀ⲙⲟⲩ ⲉ̀ⲣⲟⲛ ⲛ̀ϫⲉ Ⲫϯ ⲧⲉⲛⲛⲁ̀ⲥ̀ⲙⲟⲩ ⲉ̀ⲡⲉϥⲣⲁⲛ ⲉ̅ⲑ̅ⲩ ⲛ̀ⲥⲏⲟⲩ ⲛⲓⲃⲉⲛ ⲉ̀ⲣⲉ ⲡⲉϥⲥ̀ⲙⲟⲩ ⲛⲁϣⲱⲡⲓ ⲉϥⲙⲏⲛ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲣⲱⲛ","cop_lat":"Efe-esmou eron enje Efnoti tenna-esmou epefran ethowab enseeou niven ere pefesmou nashopi efmeen evol khen ron","en":"May God bless us, and let us bless his Holy Name, and may his praise continually be, always upon our mouths","ar":"Ya malaak haza el youm, el taer ila el olowa be hazihi el tasbeha, ozkorna amaam el rab, le yagfer lana gatayana."}},{"id":"t363-12","text":{"cop":"Ϫⲉ ϥ̀ⲥ̀ⲙⲁⲣⲱⲟⲩⲧ ⲛ̀ϫⲉ Ⲫ̀ⲓⲱⲧ ⲛⲉⲙ ̀Ⲡ̀ϣⲏⲣⲓ ⲛⲉⲙ Ⲡⲓⲡ̀ⲛⲉⲩⲙⲁ ⲉ̀ⲑⲟⲩⲁⲃ Ϯⲧ̀ⲣⲓⲁⲥ ⲉⲧϫⲏⲕ ⲉ̀ⲃⲟⲗ ⲧⲉⲛⲟⲩⲱϣⲧ ⲙ̀ⲙⲟⲥ ⲧⲉⲛϯⲱ̀ⲟⲩ ⲛⲁⲥ","cop_lat":"Je efesmaroout enje Efiot nem Epsheeri nem Pi-epnevma ethowab Ti-etrias etjeek evol tenowosht emmos tenti-oou nas","en":"For blessed is the Father, the son and the Holy Spirit, the Perfect trinity, we worship Him and Glorify Him","ar":"El marda ishfihom wa elazina rakado yarabi naihom, wa ellazina rakado yarab naihom, wa igwata alazina fa kol shida , yarab aina wa iaho."}},{"id":"t678-0","text":{"cop":"Ⲁ̀ ⲡⲓⲛⲁⲩ ϣⲱⲡⲓ ⲭⲁ ⲛⲓⲙⲏϣ ⲉⲃ̀ⲟⲗ :","cop_lat":"A pinav shopi ka nimeesh e-evol :","en":"The time came to send the multitude away.","ar":"قد حان الوقت أطلق الجميع."},"section":{"en":"Apinav shopi (The time came), Ⲁ̀ ⲡⲓⲛⲁⲩ ϣⲱⲡⲓ","path":""}},{"id":"t678-1","text":{"cop":"ⲙⲁⲣⲉ ⲛⲓⲥⲁϧ ⲫⲓⲣⲓ ⲉ̀ⲃⲟⲗ :","cop_lat":"mare nisakh firi evol :","en":"Let the scribes write.","ar":"فليفسر المعلمون."}},{"id":"t678-2","text":{"cop":"ⲙⲁⲣⲉ ⲛⲓⲥⲟⲫⲟⲥ ⲑⲱⲟⲩϯ ϣⲁⲣⲟⲛ :","cop_lat":"mare nisofos thoouti sharon :","en":"Let the wise men assemble,","ar":"فليجتمع الحكماء إلينا"}},{"id":"t678-3","text":{"cop":"ⲉⲩⲉⲣⲙⲏⲛⲉⲩⲓⲛ ϧⲉⲛ ⲛⲓⲅ̀ⲣⲁⲫⲏ ⲉⲑⲟⲩⲁⲃ.","cop_lat":"evermeenevin khen ni-eghrafee ethowab.","en":"and reveal what is in the Holy Scriptures.","ar":"مفسرين في الكتب المقدسة."}},{"id":"t678-4","text":{"cop":"Ⲉ̀ⲣⲉ ⲡⲓⲥ̀ⲙⲟⲩ ⲛ̀Ϯⲧ̀ⲣⲓⲁⲥ ⲉⲑⲟⲩⲁⲃ :","cop_lat":"Ere pi-esmou enti-etrias ethowab :","en":"The blessing of the Holy Trinity.The Father","ar":"بركة الثالوث القدوس."}},{"id":"t678-5","text":{"cop":"Ⲫ̀ⲓⲱⲧ ⲛⲉⲙ Ⲡ̀ϣⲏⲣⲓ ⲛⲉⲙ Ⲡⲓⲡ̀ⲛⲉⲩⲙⲁ ⲉⲑⲟⲩⲁⲃ.","cop_lat":"Efiot nem Epsheeri nem Pi-epnevma ethowab.","en":"and the Son and the Holy Spirit.","ar":"الآب والابن والروح القدس."}},{"id":"t678-6","text":{"cop":"Ⲉ̀ⲣⲉ Ⲡⲓⲥ̀ⲙⲟⲩ ⲛ̀ϯⲑⲉⲟ̀ⲧⲟⲕⲟⲥ :","cop_lat":"Ere Pi-esmou entithe-otokos :","en":"The blessing of the Mother of God.","ar":"بركة والدة الإله"}},{"id":"t678-7","text":{"cop":"Ⲙⲁⲣⲓⲁ ⲑ̀ⲙⲁⲩ ⲛ̀Ⲓⲏⲥⲟⲩⲥ Ⲡⲓⲭⲣⲓⲥⲧⲟⲥ.","cop_lat":"Maria ethmav enieesous Pikhristos.","en":"Mary the Mother of Jesus Christ.","ar":"مريم أم يسوع المسيح."}},{"id":"t678-8","text":{"cop":"Ⲉϥⲉ̀ⲓ̀ ⲉ̀ϩ̀ⲣⲏⲓ ⲉ̀ϫⲉⲛ ⲡⲁⲓⲗⲁⲟⲥ ⲧⲏⲣϥ ⲉⲩⲟⲩϫⲁⲓ ϧⲉⲛ Ⲡϭⲟⲓⲥ ϫⲉ ⲁ̀ⲙⲏⲛ ⲉⲥⲉ̀ϣⲱⲡⲓ.","cop_lat":"Efe-i e-ehree ejen pailaos teerf evougai khen Pshois je ameen eseshopi.","en":"Will be upon all the people, being sound and healthy in the Lord. Amen. So it shall be.","ar":"تحل علي هذاالشعب كله معافين من الرب أمين يكون."}},{"id":"t485-0","text":{"cop":"Ⲧⲉⲛⲟⲩⲱϣⲧ ⲙ̀Ⲫⲓⲱⲧ ⲛⲉⲙ Ⲡϣⲏⲣⲓ:","cop_lat":"Tenowosht emfiot nem Psheeri:","en":"We worship the Father and the Son,","ar":"نسجد للآب والإبن"},"section":{"en":"The Morning Doxology, Ⲧⲉⲛⲟⲩⲱϣⲧ ⲙ̀Ⲫⲓⲱⲧ","path":""}},{"id":"t485-1","text":{"cop":"ⲛⲉⲙ Ⲡⲓⲡ̅ⲛ̅ⲁ̅ ⲉ̅ⲑ̅ⲩ̅:","cop_lat":"nem Pi-epnevma ethowab:","en":"and the Holy Spirit,","ar":"والروح القدس"}},{"id":"t485-2","text":{"cop":"ⲭⲉⲣⲉ ϯⲉⲕⲕ̀ⲗⲏⲥⲓⲁ̀:","cop_lat":"shere tiekekleesi-a:","en":"Hail to the Church,","ar":"السلام للكنيسة"}},{"id":"t485-3","text":{"cop":"ⲡ̀ⲏⲓ ⲛ̀ⲧⲉ ⲛⲓⲁⲅⲅⲉⲗⲟⲥ.","cop_lat":"epee ente niangelos.","en":"the house of the angels.","ar":"بيت الملائكة."}},{"id":"t485-4","text":{"cop":"* Ⲭⲉⲣⲉ ϯⲡⲁⲣⲑⲉⲛⲟⲥ:","cop_lat":"* Shere tiparthenos:","en":"* Hail to the Virgin,","ar":"السلام للعذراء التى"}},{"id":"t485-5","text":{"cop":"ⲉ̀ⲧⲁⲥⲙⲉⲥ Ⲡⲉⲛⲥⲱⲧⲏⲣ:","cop_lat":"etasmes Pensoteer:","en":"who gave birth to our Savior,","ar":"ولدت مخلصنا"}},{"id":"t485-6","text":{"cop":"ⲭⲉⲣⲉ Ⲅⲁⲃⲣⲓⲏⲗ:","cop_lat":"shere Ghabrieel:","en":"Hail to Gabriel who announced,","ar":"السلام لغبريال"}},{"id":"t485-7","text":{"cop":"ⲉ̀ⲧⲁϥϩⲓϣⲉⲛⲛⲟⲩϥⲓ ⲛⲁⲥ.","cop_lat":"etafhishennoufi nas.","en":"to her the Good News.","ar":"الذى بشرها."}},{"id":"t485-8","text":{"cop":"Ⲭⲉⲣⲉ Ⲙⲓⲭⲁⲏⲗ:","cop_lat":"Shere Mikhaeel:","en":"Hail to Michael,","ar":"السلام لميخائيل"}},{"id":"t485-9","text":{"cop":"ⲡⲓⲣⲭⲏⲁⲅⲅⲉⲗⲟⲥ:","cop_lat":"pirsheeangelos:","en":"the archangel,","ar":"رئيس الملائكة"}},{"id":"t485-10","text":{"cop":"ⲭⲉⲣⲉ ⲡⲓϫⲟⲩⲧ ϥ̀ⲧⲟⲩ:","cop_lat":"shere pigout eftou:","en":"Hail to the twenty four,","ar":"السلام للأربعة"}},{"id":"t485-11","text":{"cop":"ⲙ̀ⲡ̀ⲣⲉⲥⲃⲩⲧⲉⲣⲟⲥ.","cop_lat":"emepresviteros.","en":"Presbyters.","ar":"والعشرين قسيساً."}},{"id":"t485-12","text":{"cop":"* Ⲭⲉⲣⲉ Ⲛⲓⲭⲉⲣⲟⲩⲃⲓⲙ:","cop_lat":"* Shere Nisherouvim:","en":"* Hail to the Cherubim,","ar":"السلام للشاروبيم"}},{"id":"t485-13","text":{"cop":"ⲭⲉⲣⲉ Ⲛⲓⲥⲉⲣⲁⲫⲓⲙ:","cop_lat":"shere Niserafim:","en":"Hail to the Seraphim,","ar":"السلام للسارافيم."}},{"id":"t485-14","text":{"cop":"ⲭⲉⲣⲉ ⲛⲓⲧⲁⲅⲙⲁ ⲧⲏⲣⲟⲩ:","cop_lat":"shere nitaghma teerou:","en":"Hail to all the hosts,","ar":"السلام لجميع الطغمات"}},{"id":"t485-15","text":{"cop":"ⲛ̀ⲉ̀ⲡⲟⲩⲣⲁⲛⲓⲟⲛ.","cop_lat":"enepouranion.","en":"of the heavens.","ar":"السمائية."}},{"id":"t485-16","text":{"cop":"Ⲭⲉⲣⲉ Ⲓⲱⲁⲛⲛⲏⲥ:","cop_lat":"Shere Yoannees:","en":"Hail to John,","ar":"السلام ليوحنا"}},{"id":"t485-17","text":{"cop":"ⲡⲓⲛⲓϣϯ ⲙ̀ⲡ̀ⲣⲟⲇⲣⲟⲙⲟⲥ:","cop_lat":"pinishti emeprothromos:","en":"the great forerunner,","ar":"السابق العظيم."}},{"id":"t485-18","text":{"cop":"ⲭⲉⲣⲉ ⲡⲓⲙⲏⲧ ⲥ̀ⲛⲁⲩ:","cop_lat":"shere pimeet esnav:","en":"Hail to the,","ar":"السلام للاثنى"}},{"id":"t485-19","text":{"cop":"ⲛ̀ⲁ̀ⲡⲟⲥⲧⲟⲗⲟⲥ.","cop_lat":"enapostolos.","en":"twelve apostles.","ar":"عشر رسولا."}},{"id":"t485-20","text":{"cop":"* Ⲭⲉⲣⲉ ⲡⲉⲛⲓⲱⲧ Ⲙⲁⲣⲕⲟⲥ:","cop_lat":"* Shere peniot Markos:","en":"* Hail to our father Mark,","ar":"السلام لأبينا"}},{"id":"t485-21","text":{"cop":"ⲡⲓⲉⲩⲁⲅⲅⲉⲗⲓⲥⲧⲏⲥ:","cop_lat":"pievangelistees:","en":"the Evangelist,","ar":"مرقس الانجيلى"}},{"id":"t485-22","text":{"cop":"ⲡⲓⲣⲉϥϫⲱⲣ ⲉ̀ⲃⲟⲗ:","cop_lat":"pirefgor evol:","en":"the destroyer,","ar":"مبدد"}},{"id":"t485-23","text":{"cop":"ⲛ̀ⲧⲉ ⲛⲓⲓ̀ⲇⲱⲗⲟⲛ.","cop_lat":"ente nitholon.","en":"of the idols.","ar":"الأوثان."}},{"id":"t485-24","text":{"cop":"Ⲭⲉⲣⲉ Ⲥⲧⲉⲫⲁⲛⲟⲥ:","cop_lat":"Shere Stefanos:","en":"Hail to Stephen,","ar":"السلام"}},{"id":"t485-25","text":{"cop":"ⲡⲓϣⲟⲣⲡ ⲙ̀ⲙⲁⲣⲧⲩⲣⲟⲥ:","cop_lat":"pishorp emmartiros:","en":"the first martyr,","ar":"لاستفانوس الشهيد."}},{"id":"t485-26","text":{"cop":"ⲭⲉⲣⲉ Ⲅⲱⲉⲣⲅⲓⲟⲥ:","cop_lat":"shere Ghoergios:","en":"Hail to George,","ar":"السلام لجرجس"}},{"id":"t485-27","text":{"cop":"ⲡⲓⲥⲓⲟⲩ ⲛ̀ⲧⲉ ϩⲁⲛⲁ̀ⲧⲟⲟⲩⲓ̀.","cop_lat":"pisiou ente hanatooui.","en":"the morning star.","ar":"كوكب الصبح."}},{"id":"t485-28","text":{"cop":"* Ⲭⲉⲣⲉ ⲡ̀ⲭⲟⲣⲟⲥ ⲧⲏⲣϥ:","cop_lat":"* Shere epkhoros teerf:","en":"* Hail to the whole choir,","ar":"السلام لجميع صفوف"}},{"id":"t485-29","text":{"cop":"ⲛ̀ⲧⲉ ⲛⲓⲙⲁⲣⲧⲩⲣⲟⲥ:","cop_lat":"ente nimartiros:","en":"of the martyrs,","ar":"الشهداء السلام"}},{"id":"t485-30","text":{"cop":"ⲭⲉⲣⲉ Ⲁⲃⲃⲁ Ⲁⲛⲧⲱⲛⲓ:","cop_lat":"shere Abba Antoni:","en":"Hail to Abba Antony,","ar":"لأنبا انطونيوس"}},{"id":"t485-31","text":{"cop":"ⲛⲉⲙ ⲡⲓϣⲟⲙⲧ Ⲙⲁⲕⲁⲣⲓⲟⲥ.","cop_lat":"nem pishomt Makarios.","en":"and the three Macarii.","ar":"والثلاثة المقارات."}},{"id":"t485-32","text":{"cop":"Ⲭⲉⲣⲉ ⲡ̀ⲭⲟⲣⲟⲥ ⲧⲏⲣϥ:","cop_lat":"Shere epkhoros teerf:","en":"Hail to the whole choir,","ar":"السلام لجميع صفوف"}},{"id":"t485-33","text":{"cop":"ⲛ̀ⲧⲉ ⲛⲓⲥ̀ⲧⲁⲩⲣⲟⲫⲟⲣⲟⲥ:","cop_lat":"ente ni-estavroforos:","en":"of the cross-bearers,","ar":"لُباس الصليب."}},{"id":"t485-34","text":{"cop":"ⲭⲉⲣⲉ ⲛⲏⲉ̅ⲑ̅ⲩ̅ ⲧⲏⲣⲟⲩ:","cop_lat":"shere nee-ethowab teerou:","en":"Hail to all the saints,","ar":"السلام لجميع القديسين"}},{"id":"t485-35","text":{"cop":"ⲉ̀ⲧⲁϥⲣⲁⲛⲁϥ Ⲡⲟ̅ⲥ̅.","cop_lat":"etafranaf Epshois.","en":"who have pleased the Lord.","ar":"الذين أرضوا الرب."}},{"id":"t485-36","text":{"cop":"* Ϩⲓⲧⲉⲛ ⲛⲟⲩⲉⲩⲭⲏ:","cop_lat":"* Hiten nowevshee:","en":"* Through their prayers,","ar":"أيها المسيح"}},{"id":"t485-37","text":{"cop":"Ⲡⲭ̅ⲥ̅ Ⲡⲉⲛⲟⲩⲣⲟ:","cop_lat":"Pi-ekhristos Penouro:","en":"O Christ our King,","ar":"ملكنا بصلواتهم"}},{"id":"t485-38","text":{"cop":"ⲁ̀ⲣⲓⲟⲩⲛⲁⲓ ⲛⲉⲙⲁⲛ:","cop_lat":"ariounai neman:","en":"have mercy upon us,","ar":"إصنع معنا رحمة"}},{"id":"t485-39","text":{"cop":"ϧⲉⲛ ⲧⲉⲕⲙⲉⲧⲟⲩⲣⲟ.","cop_lat":"khen tekmetouro.","en":"in Your kingdom.","ar":"فى ملكوتك."}},{"id":"t485-40","text":{"cop":"Ⲡⲓⲟⲩⲱⲓⲛⲓ ⲛ̀ⲧⲁⲫ̀ⲙⲏⲓ:","cop_lat":"Piowoini enta-efmee:","en":"O True Light,","ar":"أيها النور الحقيقى"}},{"id":"t485-41","text":{"cop":"ⲫⲏⲉ̀ⲧⲉⲣⲟⲩⲱⲓⲛⲓ:","cop_lat":"fee-eterowoini:","en":"that gives light,","ar":"الذى يضئ لكل"}},{"id":"t485-42","text":{"cop":"ⲉ̀ⲣⲱⲙⲓ ⲛⲓⲃⲉⲛ:","cop_lat":"eromi niven:","en":"to every man,","ar":"إنسان آت"}},{"id":"t485-43","text":{"cop":"ⲉⲑⲛⲏⲟⲩ ⲉ̀ⲡⲓⲕⲟⲥⲙⲟⲥ.","cop_lat":"ethneeou epikosmos.","en":"that comes into the world.","ar":"إلى العالم."}},{"id":"t485-44","text":{"cop":"* Ⲁⲕⲓ ⲉ̀ⲡⲓⲕⲟⲥⲙⲟⲥ:","cop_lat":"* Aki epikosmos:","en":"* You came into the world,","ar":"أتيت إلى العالم"}},{"id":"t485-45","text":{"cop":"ϩⲓⲧⲉⲛ ⲧⲉⲕⲙⲉⲧⲙⲁⲓⲣⲱⲙⲓ:","cop_lat":"hiten tekmetmairomi:","en":"through Your Love for man,","ar":"بمحبتك للبشر"}},{"id":"t485-46","text":{"cop":"ⲁ̀ϯⲕ̀ⲧⲏⲥⲓⲥ ⲧⲏⲣⲥ:","cop_lat":"ati-ekteesis teers:","en":"and all the creation,","ar":"وكل الخليقة"}},{"id":"t485-47","text":{"cop":"ⲑⲉⲗⲏⲗ ϧⲁ ⲡⲉⲕϫⲓⲛⲓ̀.","cop_lat":"theleel kha pekjini.","en":"rejoiced at Your coming.","ar":"تهللت بمجيئك."}},{"id":"t485-48","text":{"cop":"Ⲁⲕⲥⲱϯ ⲛ̀Ⲁⲇⲁⲙ:","cop_lat":"Aksoti enadam:","en":"You have saved Adam,","ar":"خلصت آدم"}},{"id":"t485-49","text":{"cop":"ⲉ̀ⲃⲟⲗ ϧⲉⲛ ϯⲁ̀ⲡⲁⲧⲏ:","cop_lat":"evol khen ti-apatee:","en":"from seduction,","ar":"من الغواية"}},{"id":"t485-50","text":{"cop":"ⲁⲕⲉⲣ Ⲉⲩⲁ ⲛ̀ⲣⲉⲙϩⲉ:","cop_lat":"aker Eva enremhe:","en":"and delivered Eve,","ar":"وعتقت حواء"}},{"id":"t485-51","text":{"cop":"ϧⲉⲛ ⲛⲓⲛⲁⲕϩⲓ ⲛ̀ⲧⲉ ⲫ̀ⲙⲟⲩ.","cop_lat":"khen ninakhi ente efmou.","en":"from the pangs of death.","ar":"من طلقات الموت."}},{"id":"t485-52","text":{"cop":"* Ⲁⲕϯ ⲛⲁⲛ ⲙ̀Ⲡⲓⲡ̅ⲛ̅ⲁ̅:","cop_lat":"* Akti nan empi-epnevma:","en":"* You gave unto us,","ar":"أعطيتنا روح"}},{"id":"t485-53","text":{"cop":"ⲛ̀ⲧⲉ ϯⲙⲉⲧϣⲏⲣⲓ:","cop_lat":"ente timetsheeri:","en":"the Spirit of Sonship,","ar":"البنوة نسبحك"}},{"id":"t485-54","text":{"cop":"ⲉⲛϩⲱⲥ ⲉⲛⲥ̀ⲙⲟⲩ ⲉ̀ⲣⲟⲕ:","cop_lat":"enhos enesmou erok:","en":"we praise and bless You,","ar":"ونباركك مع"}},{"id":"t485-55","text":{"cop":"ⲛⲉⲙ ⲛⲉⲕⲁⲅⲅⲉⲗⲟⲥ.","cop_lat":"nem nekangelos.","en":"with Your angels.","ar":"ملائكتك."}},{"id":"t485-56","text":{"cop":"Ϧⲉⲛ ⲡ̀ϫⲓⲛⲏ̀ⲣⲉϥⲓ̀ ⲛⲁⲛ ⲉ̀ϧⲟⲩⲛ:","cop_lat":"Khen epjineerefi nan ekhoun:","en":"When the morning hour,","ar":"عند ما يدخل الينا"}},{"id":"t485-57","text":{"cop":"ⲛ̀ϫⲉ ⲫ̀ⲛⲁⲩ ⲛ̀ϣⲱⲣⲡ:","cop_lat":"enje efnav enshorp:","en":"comes upon us,","ar":"وقت باكر أيها"}},{"id":"t485-58","text":{"cop":"ⲱ̀ Ⲡⲭ̅ⲥ̅ Ⲡⲉⲛⲛⲟⲩϯ:","cop_lat":"o Pi-ekhristos Pennoti:","en":"O Christ our God,","ar":"المسيح إلهنا"}},{"id":"t485-59","text":{"cop":"ⲡⲓⲟⲩⲱⲓⲛⲓ ⲛ̀ⲧⲁⲫ̀ⲙⲏⲓ.","cop_lat":"piowoini enta-efmee.","en":"the True Light.","ar":"النور الحقيقى."}},{"id":"t485-60","text":{"cop":"* Ⲙⲁⲣⲟⲩϣⲁⲓ ⲛ̀ϧⲏⲧⲉⲛ:","cop_lat":"* Maroushai enkheeten:","en":"* Let the thought of light,","ar":"فلتشرق"}},{"id":"t485-61","text":{"cop":"ⲛ̀ϫⲉ ⲛⲓⲗⲟⲅⲓⲥⲙⲟⲥ ⲛ̀ⲧⲉ ⲡⲓⲟⲩⲱⲓⲛⲓ:","cop_lat":"enje nilogismos ente piowoini:","en":"shine within us,","ar":"فينا حواس النور"}},{"id":"t485-62","text":{"cop":"ⲟⲩⲟϩ ⲙ̀ⲡⲉⲛⲏ̀ⲣⲉϥϩⲟⲃⲥⲧⲉⲛ:","cop_lat":"o-woh empeneerefhovsten:","en":"and do not let the darkness,","ar":"ولا تغطينا"}},{"id":"t485-63","text":{"cop":"ⲛ̀ϫⲉ ⲡ̀ⲭⲁⲕⲓ ⲛ̀ⲛⲓⲡⲁⲑⲟⲥ.","cop_lat":"enje epkaki ennipathos.","en":"of pain cover us.","ar":"ظلمة الآلام."}},{"id":"t485-64","text":{"cop":"Ϩⲓⲛⲁ ⲛ̀ⲧⲉⲛϩⲱⲥ ⲉ̀ⲣⲟⲕ:","cop_lat":"Hina entenhos erok:","en":"That we may praise You,","ar":"لكى نسبحك"}},{"id":"t485-65","text":{"cop":"ⲛ̀ⲛⲟⲏⲧⲟⲥ ⲛⲉⲙ Ⲇⲁⲩⲓⲇ:","cop_lat":"ennoeetos nem David:","en":"with understanding,","ar":"عقلياً مع داود"}},{"id":"t485-66","text":{"cop":"ⲉⲛⲱϣ ⲟⲩⲃⲏⲕ:","cop_lat":"enosh ouveek:","en":"proclaiming and saying,","ar":"صارخين"}},{"id":"t485-67","text":{"cop":"ⲟⲩⲟϩ ⲉⲛϫⲱ ⲙ̀ⲙⲟⲥ.","cop_lat":"o-woh engo emmos.","en":"with David.","ar":"نحوك قائلين."}},{"id":"t485-68","text":{"cop":"* Ϫⲉ ⲁⲩⲉⲣϣⲟⲣⲡ ⲙ̀ⲫⲟϩ:","cop_lat":"* Je avershorp emfoh:","en":"* My eyes have reached,","ar":"سبق أن بلغت عيناى"}},{"id":"t485-69","text":{"cop":"ⲛ̀ϫⲉ ⲛⲁⲃⲁⲗ ⲙ̀ⲫ̀ⲛⲁⲩ ⲛ̀ϣⲱⲣⲡ:","cop_lat":"enje naval emefnav enshorp:","en":"the morning watch,","ar":"وقت السحر لأتلو"}},{"id":"t485-70","text":{"cop":"ⲉ̀ⲉⲣⲙⲉⲗⲉⲧⲁⲛ:","cop_lat":"e-ermeletan:","en":"that I might meditate,","ar":"جميع"}},{"id":"t485-71","text":{"cop":"ϧⲉⲛ ⲛⲉⲕⲥⲁϫⲓ ⲧⲏⲣⲟⲩ.","cop_lat":"khen neksaji teerou.","en":"upon all Your words.","ar":"أقوالك."}},{"id":"t485-72","text":{"cop":"Ⲥⲱⲧⲉⲙ ⲉ̀ⲧⲉⲛⲥ̀ⲙⲏ:","cop_lat":"Sotem etenesmee:","en":"Hear our voices,","ar":"إسمع صوتنا"}},{"id":"t485-73","text":{"cop":"ⲕⲁⲧⲁ ⲡⲉⲕⲛⲓϣϯ ⲛ̀ⲛⲁⲓ:","cop_lat":"kata peknishti ennai:","en":"according to Your great mercy,","ar":"كعظيم رحمتك"}},{"id":"t485-74","text":{"cop":"ⲛⲁϩⲙⲉⲛ Ⲡⲟ̅ⲥ̅ Ⲡⲉⲛⲛⲟⲩϯ:","cop_lat":"nahmen Epshois Pennoti:","en":"save us O Lord our God,","ar":"ونجنا أيها الرب"}},{"id":"t485-75","text":{"cop":"ⲕⲁⲧⲁ ⲛⲉⲕⲙⲉⲧϣⲉⲛϩⲏⲧ.","cop_lat":"kata nekmetshenheet.","en":"according to Your compassion.","ar":"إلهنا حسب رأفاتك."}},{"id":"t485-76","text":{"cop":"* Ⲫϯ ⲡⲓϥⲁⲓⲣⲱⲟⲩϣ:","cop_lat":"* Efnoti pifairooush:","en":"* O Caring God,","ar":"يا الله المهتم"}},{"id":"t485-77","text":{"cop":"ⲛ̀ⲣⲉϥⲉⲣⲡⲉⲑⲛⲁⲛⲉϥ:","cop_lat":"enreferpethnanef:","en":"the Maker of all good things,","ar":"صانع الخيرات"}},{"id":"t485-78","text":{"cop":"ⲡⲓⲣⲉϥⲉⲣⲟⲓⲕⲟⲛⲟⲙⲓⲛ:","cop_lat":"pireferoikonomin:","en":"who governs well,","ar":"مدبر مختاريه"}},{"id":"t485-79","text":{"cop":"ⲛ̀ⲛⲉϥⲥⲱⲧⲡ ⲛ̀ⲕⲁⲗⲱⲥ.","cop_lat":"ennefsotp enkalos.","en":"with His chosen ones.","ar":"حسنا."}},{"id":"t485-80","text":{"cop":"Ⲡⲓⲣⲉϥⲉⲣϩⲉⲙⲓ ⲉⲧϫⲟⲣ:","cop_lat":"Pireferhemi etgor:","en":"The strong governor for those,","ar":"المدبر القوى"}},{"id":"t485-81","text":{"cop":"ⲛ̀ⲛⲏⲉ̀ⲧⲁⲩⲫⲱⲧ ϩⲁⲣⲟϥ:","cop_lat":"ennee-etavfot harof:","en":"who take refuge in Him,","ar":"للملتجئين اليه."}},{"id":"t485-82","text":{"cop":"ⲫ̀ⲣⲉϥϭⲓϣϣⲱⲟⲩ ⲛ̀ⲧⲉ ⲟⲩⲟⲛ ⲛⲓⲃⲉⲛ:","cop_lat":"efrefchishshoou ente o-on niven:","en":"who longs for the salvation,","ar":"المتشوق لخلاص"}},{"id":"t485-83","text":{"cop":"ⲛⲟϩⲉⲙ ⲛ̀ⲧⲟⲩⲟⲩϫⲁⲓ.","cop_lat":"nohem entowougai.","en":"and deliverance of everyone.","ar":"ونجاة كل أحد."}},{"id":"t485-84","text":{"cop":"* Ϧⲉⲛ ⲧⲉⲕⲙⲉⲧⲭⲣⲏⲥⲧⲟⲥ:","cop_lat":"* Khen tekmetkhreestos:","en":"* Through Your goodness,","ar":"بصلاحك هيأت"}},{"id":"t485-85","text":{"cop":"ⲁⲕⲥⲟⲃϯ ⲛⲁⲛ ⲙ̀ⲡⲓⲉϫⲱⲣϩ:","cop_lat":"aksovti nan empiegorh:","en":"Thou provided for us the night,","ar":"لنا الليل."}},{"id":"t485-86","text":{"cop":"ⲁⲣⲓϩ̀ⲙⲟⲧ ⲛⲁⲛ ⲙ̀ⲡⲁⲓⲉ̀ϩⲟⲟⲩ:","cop_lat":"ari-ehmot nan empai-ehoou:","en":"grant us to pass,","ar":"انعم لنا بهذا اليوم"}},{"id":"t485-87","text":{"cop":"ⲉⲛⲟⲓ ⲛ̀ⲁⲑⲛⲟⲃⲓ.","cop_lat":"enoi enathnovi.","en":"this day without sin.","ar":"ونحن بغير خطية."}},{"id":"t485-88","text":{"cop":"Ⲉⲑⲣⲉⲛⲉⲣⲡ̀ⲉⲙⲡ̀ϣⲁ:","cop_lat":"Ethrenerepemepsha:","en":"That we may be worthy,","ar":"لنستحق أن"}},{"id":"t485-89","text":{"cop":"ⲉ̀ϥⲁⲓ ⲛ̀ⲛⲉⲛϫⲓϫ ⲉ̀ⲡ̀ϣⲱⲓ:","cop_lat":"efai ennenjig e-epshoi:","en":"to lift up our hands,","ar":"نرفع أيدينا اليك"}},{"id":"t485-90","text":{"cop":"ϩⲁⲣⲟⲕ ⲙ̀ⲡⲉⲕⲙ̀ⲑⲟ:","cop_lat":"harok empekemtho:","en":"before You without anger,","ar":"أمامك بغير غضب"}},{"id":"t485-91","text":{"cop":"ⲭⲱⲣⲓⲥ ϫⲱⲛⲧ ⲛⲉⲙ ⲙⲟⲕⲙⲉⲕ ⲉϥϩⲱⲟⲩ.","cop_lat":"khoris gont nem mokmek efhoou.","en":"or evil thoughts.","ar":"ولا فكر ردىء."}},{"id":"t485-92","text":{"cop":"* Ϧⲉⲛ ⲧⲁⲓ ϩⲁⲛⲁ̀ⲧⲟⲟⲩⲓ̀:","cop_lat":"* Khen tai hanatooui:","en":"* At this dawn,","ar":"فى هذا السحر سهل"}},{"id":"t485-93","text":{"cop":"ⲥⲟⲩⲧⲱⲛ ⲛⲉⲛⲙⲱⲓⲧ ⲉ̀ϧⲟⲩⲛ:","cop_lat":"souton nenmoit ekhoun:","en":"make straight our coming in,","ar":"طرقنا الداخلية"}},{"id":"t485-94","text":{"cop":"ⲛⲉⲙ ⲛⲉⲛⲙⲱⲓⲧ ⲉ̀ⲃⲟⲗ:","cop_lat":"nem nenmoit evol:","en":"and our going out,","ar":"والخارجية"}},{"id":"t485-95","text":{"cop":"ϧⲉⲛ ⲡ̀ⲟⲩⲛⲟϥ ⲛ̀ⲧⲉ ⲧⲉⲕⲥ̀ⲕⲉⲡⲏ.","cop_lat":"khen epounof ente tekeskepee.","en":"in the joy of Your protection.","ar":"بسترك المفرح."}},{"id":"t485-96","text":{"cop":"Ⲉⲑⲣⲉⲛϫⲱ ⲛ̀ⲧⲉⲕⲙⲉⲑⲙⲏⲓ:","cop_lat":"Ethrengo entekmethmee:","en":"That we may proclaim,","ar":"لننطق بعدلك"}},{"id":"t485-97","text":{"cop":"ⲛ̀ⲉ̀ϩⲟⲟⲩ ⲛⲓⲃⲉⲛ:","cop_lat":"enehoou niven:","en":"Your righteousness daily,","ar":"كل يوم"}},{"id":"t485-98","text":{"cop":"ⲛ̀ⲧⲉⲛϩⲱⲥ ⲉ̀ⲧⲉⲕϫⲟⲙ:","cop_lat":"entenhos etekgom:","en":"and praise Your power,","ar":"ونمجد قوتك"}},{"id":"t485-99","text":{"cop":"ⲛⲉⲙ Ⲇⲁⲩⲓⲇ ⲡⲓⲡ̀ⲣⲟⲫⲏⲧⲏⲥ.","cop_lat":"nem David pi-eprofeetees.","en":"with David the prophet.","ar":"مع داود النبى."}},{"id":"t485-100","text":{"cop":"* Ϫⲉ ϧⲉⲛ ⲧⲉⲕϩⲓⲣⲏⲛⲏ:","cop_lat":"* Je khen tekhireenee:","en":"* Saying \"In Your peace,","ar":"قائلين بسلامك أيها"}},{"id":"t485-101","text":{"cop":"Ⲡⲭ̅ⲥ̅ Ⲡⲉⲛⲥ̅ⲱ̅ⲣ̅:","cop_lat":"Pi-ekhristos Pensoteer:","en":"O Christ our Savior,","ar":"المسيح مخلصنا رقدنا"}},{"id":"t485-102","text":{"cop":"ⲁⲛⲉⲛⲕⲟⲧ ⲁⲛⲧⲱⲟⲩⲛ:","cop_lat":"anenkot antooun:","en":"we slept and arose,","ar":"وقمنا لأننا"}},{"id":"t485-103","text":{"cop":"ϫⲉ ⲁⲛⲉⲣϩⲉⲗⲡⲓⲥ ⲉ̀ⲣⲟⲕ.","cop_lat":"je anerhelpis erok.","en":"for we have hoped in You.","ar":"توكلنا عليك."}},{"id":"t485-104","text":{"cop":"Ϩⲏⲡⲡⲉ ⲟⲩⲡⲉⲑⲛⲁⲛⲉϥ:","cop_lat":"Heeppe oupethnanef:","en":"Behold how beneficent,","ar":"ها ما هو الحسن"}},{"id":"t485-105","text":{"cop":"ⲓⲉ ⲟⲩⲡⲉⲧϩⲟⲗϫ ⲉ̀ⲃⲏⲗ:","cop_lat":"ie oupetholg eveel:","en":"and how pleasant,","ar":"وما هو الحلو"}},{"id":"t485-106","text":{"cop":"ⲉ̀̀ⲡ̀ϯⲙⲁϯ ⲛ̀ϩⲁⲛⲥ̀ⲛⲏⲟⲩ:","cop_lat":"e-eptimati enhanesneeou:","en":"it is for brethren,","ar":"الا اتفاق اخوة"}},{"id":"t485-107","text":{"cop":"ⲉⲩϣⲟⲡ ϩⲓ ⲟⲩⲙⲁ.","cop_lat":"evshop hi ouma.","en":"to dwell together in unity.\"","ar":"ساكنين معا."}},{"id":"t485-108","text":{"cop":"* Ⲉⲩⲉⲣⲥⲩⲙⲫⲱⲛⲓⲛ:","cop_lat":"* Eversimfonin:","en":"* United,","ar":"متفقين"}},{"id":"t485-109","text":{"cop":"ϧⲉⲛ ⲟⲩⲁⲅⲁⲡⲏ ⲙ̀ⲙⲏⲓ:","cop_lat":"khen o-aghapee emmee:","en":"in the True,","ar":"بمحبة حقيقية"}},{"id":"t485-110","text":{"cop":"ⲛ̀ⲉⲩⲁⲅⲅⲉⲗⲓⲕⲏ:","cop_lat":"enevangelikee:","en":"evangelic love,","ar":"انجيلية"}},{"id":"t485-111","text":{"cop":"ⲕⲁⲧⲁ ⲛⲓⲁ̀ⲡⲟⲥⲧⲟⲗⲟⲥ.","cop_lat":"kata ni-apostolos.","en":"like the apostles.","ar":"كمثل الرسل."}},{"id":"t485-112","text":{"cop":"Ⲙⲫ̀ⲣⲏϯ ⲙ̀ⲡⲓⲥⲟϫⲉⲛ:","cop_lat":"Mefreeti empisojen:","en":"It is like the fragrant oil,","ar":"مثل الطيب على"}},{"id":"t485-113","text":{"cop":"ⲉ̀ϯⲁ̀ⲫⲉ ⲙ̀Ⲡⲭ̅ⲥ̅:","cop_lat":"eti-afe empi-ekhristos:","en":"on the head of Christ,","ar":"رأس المسيح النازل"}},{"id":"t485-114","text":{"cop":"ⲉϥⲛⲏⲟⲩ ⲉ̀ϫⲉⲛ ϯⲙⲟⲣⲧ:","cop_lat":"efneeou ejen timort:","en":"running down the beard,","ar":"على اللحية الى"}},{"id":"t485-115","text":{"cop":"ϣⲁ ̀ⲉϧ̀ⲣⲏⲓ ⲉ̀ⲛⲓϭⲁⲗⲁⲩϫ.","cop_lat":"sha e-ekhree enichalavg.","en":"down to the feet.","ar":"أسفل الرجلين."}},{"id":"t485-116","text":{"cop":"* Ⲉϥⲑⲱϩⲥ ⲙ̀ⲙⲏⲛⲓ ⲛⲓⲃⲉⲛ:","cop_lat":"* Efthohs emmeeni niven:","en":"* That anoints every day,","ar":"يمسح كل يوم الشيوخ"}},{"id":"t485-117","text":{"cop":"ⲛⲓϧⲉⲗⲗⲟⲓ ⲛⲉⲙ ⲛⲓⲁⲗⲱⲟⲩⲓ̀:","cop_lat":"nikhelloi nem nialooui:","en":"the elders,","ar":"والصبيان"}},{"id":"t485-118","text":{"cop":"ⲛⲉⲙ ⲛⲓϧⲉⲗϣⲓⲣⲓ:","cop_lat":"nem nikhelshiri:","en":"the children and young men,","ar":"والفتيان"}},{"id":"t485-119","text":{"cop":"ⲛⲉⲙ ⲛⲓⲇⲓⲁ̀ⲕⲟⲛⲓⲥⲧⲏⲥ.","cop_lat":"nem nithi-akonistees.","en":"and the deacons.","ar":"والخدام."}},{"id":"t485-120","text":{"cop":"Ⲛⲁⲓ ⲉ̀ⲧⲁϥϩⲟⲧⲡⲟⲩ ⲉⲩⲥⲟⲡ:","cop_lat":"Nai etafhotpou evsop:","en":"Those whom the Holy Spirit,","ar":"هؤلاء الذين"}},{"id":"t485-121","text":{"cop":"ⲛ̀ϫⲉ Ⲡⲓⲡ̅ⲛ̅ⲁ̅ ⲉ̅ⲑ̅ⲩ̅:","cop_lat":"enje Pi-epnevma ethowab:","en":"has attuned together,","ar":"ألّفهم الروح القدس"}},{"id":"t485-122","text":{"cop":"ⲙ̀ⲫ̀ⲣⲏϯ ⲛ̀ⲟⲩⲕⲩⲑⲁⲣⲁ:","cop_lat":"emefreeti enoukithara:","en":"as a stringed instrument,","ar":"معا مثل قيثارة"}},{"id":"t485-123","text":{"cop":"ⲉⲩⲥ̀ⲙⲟⲩ ⲉ̀Ⲫϯ ⲛ̀ⲥⲏⲟⲩ ⲛⲓⲃⲉⲛ.","cop_lat":"evesmou e-efnoti enseeou niven.","en":"always blessing God.","ar":"مسبحين الله كل حين."}},{"id":"t485-124","text":{"cop":"* Ϧⲉⲛ ϩⲁⲛⲁⲗⲙⲟⲥ ⲛⲉⲙ ϩⲁⲛϩⲱⲥ:","cop_lat":"* Khen hanalmos nem hanhos:","en":"* By psalms and hymns,","ar":"بمزامير وتسابيح"}},{"id":"t485-125","text":{"cop":"ⲛⲉⲙ ϩⲁⲛϩⲱⲇⲏ ⲙ̀ⲡ̅ⲛ̅ⲁ̅ⲧⲓⲕⲟⲛ:","cop_lat":"nem hanhothee empnevmatikon:","en":"and spiritual songs,","ar":"وترانيم روحية النهار"}},{"id":"t485-126","text":{"cop":"ⲙ̀ⲡⲓⲉ̀ϩⲟⲟⲩ ⲛⲉⲙ ⲡⲓⲉ̀ϫⲱⲣϩ:","cop_lat":"empi-ehoou nem pi-egorh:","en":"by day and by night,","ar":"والليل بقلب"}},{"id":"t485-127","text":{"cop":"ϧⲉⲛ ⲟⲩϩⲏⲧ ⲛ̀ⲁⲧⲭⲁⲣⲱϥ.","cop_lat":"khen ouheet enatkarof.","en":"with an incessant heart.","ar":"لا يفتر."}},{"id":"t485-128","text":{"cop":"(Ⲉⲑⲃⲉ ϯⲡⲁⲣⲑⲉⲛⲟⲥ)","cop_lat":"(Ethve tiparthenos)","en":"(For the Virgin) You are the Mother","ar":"لأجل العذراء أنت"}},{"id":"t485-129","text":{"cop":"Ⲛⲑⲟ ⲏ̀ⲙⲁⲩ ⲙ̀ⲡⲓⲟⲩⲱⲓⲛⲓ:","cop_lat":"Ntho eemav empiowoini:","en":"of Light,","ar":"يا أم النور المكرمة"}},{"id":"t485-130","text":{"cop":"ⲉⲧⲧⲁⲓⲏⲟⲩⲧ ⲙ̀ⲙⲁⲥⲛⲟⲩϯ:","cop_lat":"ettaieeout emmasnoti:","en":"the honored Mother of God,","ar":"والدة الاله"}},{"id":"t485-131","text":{"cop":"ⲁ̀ⲣⲉϥⲁⲓ ϧⲁ ⲡⲓⲗⲟⲅⲟⲥ:","cop_lat":"arefai kha piloghos:","en":"you have carried,","ar":"حملت الكلمة غير"}},{"id":"t485-132","text":{"cop":"ⲡⲓⲁⲭⲱⲣⲓⲧⲟⲥ.","cop_lat":"piakhoritos.","en":"the Uncircumscript Logos.","ar":"المحوى."}},{"id":"t485-133","text":{"cop":"* Ⲙⲉⲛⲉⲛⲥⲁ ⲏ̀ⲣⲉⲙⲁⲥϥ:","cop_lat":"* Menensa eeremasf:","en":"* After you gave birth to Him,","ar":"ومن بعد أن"}},{"id":"t485-134","text":{"cop":"ⲁ̀ⲣⲉⲟ̀ϩⲓ ⲉ̀ⲣⲉⲟⲓ ⲙ̀ⲡⲁⲣⲑⲉⲛⲟⲥ:","cop_lat":"are-ohi ereoi emparthenos:","en":"you remained a virgin,","ar":"ولدته بقيت عذراء."}},{"id":"t485-135","text":{"cop":"ϧⲉⲛ ϩⲁⲛϩⲱⲥ ⲛⲉⲙ ϩⲁⲛⲥ̀ⲙⲟⲩ:ⲧⲉⲛϭⲓⲥⲓ ⲙ̀ⲙⲟ.","cop_lat":"khen hanhos nem hanesmou:tenchisi emmo.","en":"with praises and blessings, we magnify you.","ar":"نعظمك بتسابيح وبركات."}},{"id":"t485-136","text":{"cop":"Ϫⲉ ⲛ̀ⲑⲟϥ ϧⲉⲛ ⲡⲉϥⲟⲩⲱϣ:","cop_lat":"Je enthof khen pefowosh:","en":"For of His own will,","ar":"لأنه بارادته"}},{"id":"t485-137","text":{"cop":"ⲛⲉⲙ ⲡ̀ϯⲙⲁϯ ⲙ̀Ⲡⲉϥⲓⲱⲧ:","cop_lat":"nem eptimati empefiot:","en":"and the pleasure of His Father,","ar":"ومسرة أبيه"}},{"id":"t485-138","text":{"cop":"ⲛⲉⲙ Ⲡⲓⲡ̅ⲛ̅ⲁ̅ ⲉ̅ⲑ̅ⲩ̅:","cop_lat":"nem Pi-epnevma ethowab:","en":"and the Holy Spirit,","ar":"والروح القدس أتى"}},{"id":"t485-139","text":{"cop":"ⲁϥⲓ̀ ⲁϥⲥⲱϯ ⲙ̀ⲙⲟⲛ.","cop_lat":"afi afsoti emmon.","en":"He came and saved us.","ar":"وخلصنا."}},{"id":"t485-140","text":{"cop":"* Ⲁⲛⲟⲛ ϩⲱⲛ ⲧⲉⲛⲧⲱⲃϩ:","cop_lat":"* Anon hon tentovh:","en":"* And we too,","ar":"ونحن أيضا نطلب"}},{"id":"t485-141","text":{"cop":"ⲉⲑⲣⲉⲛϣⲁϣⲛⲓ ⲉⲩⲛⲁⲓ:","cop_lat":"ethrenshashni evnai:","en":"hope to win mercy,","ar":"أن نفوز برحمة"}},{"id":"t485-142","text":{"cop":"ϩⲓⲧⲉⲛ ⲛⲉⲡ̀ⲣⲉⲥⲃⲓⲁ̀:","cop_lat":"hiten ne-epresvi-a:","en":"through your intercessions,","ar":"بشفاعاتك لدى"}},{"id":"t485-143","text":{"cop":"ⲛ̀ⲧⲟⲧϥ ⲙ̀ⲡⲓⲙⲁⲓⲣⲱⲙⲓ.","cop_lat":"entotf empimairomi.","en":"with the Lover of mankind.","ar":"محب البشر."}},{"id":"t485-144","text":{"cop":"(Ⲉⲑⲃⲉ ϯⲡⲁⲣⲑⲉⲛⲟⲥ ⲟⲛ)","cop_lat":"(Ethve tiparthenos on)","en":"(Also","ar":"وأيضا لأجل"}},{"id":"t485-145","text":{"cop":"Ⲁⲡⲓⲥ̀ⲑⲟⲓⲛⲟϥⲓ ⲉⲧⲥⲱⲧⲡ:","cop_lat":"Api-estoinofi etsotp:","en":"for the Virgin) The select incense,","ar":"العذراء البخور"}},{"id":"t485-146","text":{"cop":"ⲛ̀ⲧⲉ ⲧⲉⲡⲁⲣⲑⲉⲛⲓⲁ̀:","cop_lat":"ente tepartheni-a:","en":"of your virginity,","ar":"المختار الذى"}},{"id":"t485-147","text":{"cop":"ⲁϥϣⲉⲛⲁϥ ⲉ̀ⲡ̀ϣⲱⲓ:","cop_lat":"afshenaf e-epshoi:","en":"ascended to the throne,","ar":"لبتوليتك صعد"}},{"id":"t485-148","text":{"cop":"ϣⲁ ⲡⲓⲏ̀ⲣⲟⲛⲟⲥ ⲙ̀Ⲫⲓⲱⲧ.","cop_lat":"sha pi-eeronos emfiot.","en":"of the Father.","ar":"الى كرسى الآب."}},{"id":"t485-149","text":{"cop":"* Ⲉϩⲟⲧⲉ ⲡⲓⲥ̀ⲑⲟⲓⲛⲟϥⲓ:","cop_lat":"* Ehote pi-estoinofi:","en":"* Better than the incense,","ar":"أفضل من بخور"}},{"id":"t485-150","text":{"cop":"ⲛ̀ⲧⲉ Ⲛⲓⲭⲉⲣⲟⲩⲃⲓⲙ:","cop_lat":"ente Nisherouvim:","en":"of the Cherubim,","ar":"الشاروبيم"}},{"id":"t485-151","text":{"cop":"ⲛⲉⲙ Ⲛⲓⲥⲉⲣⲁⲫⲓⲙ:","cop_lat":"nem Niserafim:","en":"and the Seraphim,","ar":"والسارافيم"}},{"id":"t485-152","text":{"cop":"Ⲙⲁⲣⲓⲁ̀ ϯⲡⲁⲣⲑⲉⲛⲟⲥ.","cop_lat":"Mari-a tiparthenos.","en":"O Virgin Mary.","ar":"يامريم العذراء."}},{"id":"t485-153","text":{"cop":"Ⲭⲉⲣⲉ ϯⲫⲉ ⲙ̀ⲃⲉⲣⲓ:","cop_lat":"Shere tife emveri:","en":"Hail to the New heaven,","ar":"السلام للسماء"}},{"id":"t485-154","text":{"cop":"ⲑⲏⲉ̀ⲧⲁ Ⲫⲓⲱⲧ ⲑⲁⲙⲓⲟⲥ:","cop_lat":"thee-eta Fiot thamios:","en":"whom the Father has created,","ar":"الجديدة التى صنعها الآب"}},{"id":"t485-155","text":{"cop":"ⲁϥⲭⲁⲥ ⲛ̀ⲟⲩⲙⲁⲛ̀ⲉⲙⲧⲟⲛ:","cop_lat":"afkas enouma-enemton:","en":"and made a place of rest,","ar":"وجعلها موضع راحة"}},{"id":"t485-156","text":{"cop":"ⲙ̀Ⲡⲉϥϣⲏⲣⲓ ⲙ̀ⲙⲉⲛⲣⲓⲧ.","cop_lat":"empefsheeri emmenrit.","en":"for His beloved Son.","ar":"لابنه الحبيب."}},{"id":"t485-157","text":{"cop":"* Ⲭⲉⲣⲉ ⲡⲓⲏ̀ⲣⲟⲛⲟⲥ:","cop_lat":"* Shere pi-eeronos:","en":"* Hail to the Royal throne,","ar":"السلام للكرسى"}},{"id":"t485-158","text":{"cop":"ⲙ̀ⲃⲁⲥⲓⲗⲓⲕⲟⲛ:","cop_lat":"emvasilikon:","en":"of Him who is,","ar":"الملوكى"}},{"id":"t485-159","text":{"cop":"ⲙ̀ⲫⲏⲉ̀ⲧⲟⲩϥⲁⲓ ⲙ̀ⲙⲟϥ:","cop_lat":"emfee-etoufai emmof:","en":"carried by,","ar":"الذى للمحمول على"}},{"id":"t485-160","text":{"cop":"ϩⲓϫⲉⲛ Ⲛⲓⲭⲉⲣⲟⲩⲃⲓⲙ.","cop_lat":"hijen Nisherouvim.","en":"the Cherubim.","ar":"الشاروبيم."}},{"id":"t485-161","text":{"cop":"Ⲭⲉⲣⲉ ϯⲡ̀ⲣⲟⲥⲧⲁⲧⲏⲥ:","cop_lat":"Shere ti-eprostatees:","en":"Hail to the advocate,","ar":"السلام لشفيعة"}},{"id":"t485-162","text":{"cop":"ⲛ̀ⲧⲉ ⲛⲉⲛⲯⲩⲭⲏ:","cop_lat":"ente nenpsishee:","en":"of our souls,","ar":"نفوسنا."}},{"id":"t485-163","text":{"cop":"ⲛ̀ⲑⲟ ⲅⲁⲣ ⲁ̀ⲗⲏⲑⲱⲥ:","cop_lat":"entho ghar aleethos:","en":"you are indeed,","ar":"أنت بالحقيقة"}},{"id":"t485-164","text":{"cop":"ⲡⲉ ⲡ̀ϣⲟⲩϣⲟⲩ ⲙ̀ⲡⲉⲛⲅⲉⲛⲟⲥ.","cop_lat":"pe epshoushou empengenos.","en":"the pride of our race.","ar":"فخر جنسنا."}},{"id":"t485-165","text":{"cop":"* Ⲁⲣⲓⲡ̀ⲣⲉⲥⲃⲉⲩⲓⲛ ⲉ̀ϫⲱⲛ:","cop_lat":"* Ari-epresvevin egon:","en":"* Intercede on our behalf,","ar":"اشفعى"}},{"id":"t485-166","text":{"cop":"ⲱ̀ ⲑⲏⲉⲑⲙⲉϩ ⲛ̀ϩ̀ⲙⲟⲧ:","cop_lat":"o thee-ethmeh enehmot:","en":"O full of grace,","ar":"فينا ياممتلئة"}},{"id":"t485-167","text":{"cop":"ⲛⲁϩⲣⲉⲛ Ⲡⲉⲛⲥ̅ⲱ̅ⲣ̅:","cop_lat":"nahren Pensoteer:","en":"before our Savior,","ar":"نعمة لدى مخلصنا"}},{"id":"t485-168","text":{"cop":"Ⲡⲉⲛⲟ̅ⲥ̅ Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅.","cop_lat":"Penshois Ieesous Pi-ekhristos.","en":"Our Lord Jesus Christ.","ar":"ربنا يسوع المسيح."}},{"id":"t485-169","text":{"cop":"Ϩⲟⲡⲱⲥ ⲛ̀ⲧⲉϥⲧⲁϫⲣⲟⲛ:","cop_lat":"Hopos enteftagron:","en":"That He may confirm us,","ar":"لكى يثبتنا فى"}},{"id":"t485-170","text":{"cop":"ϧⲉⲛ ⲡⲓⲛⲁϩϯ ⲉⲧⲥⲟⲩⲧⲱⲛ:","cop_lat":"khen pinahti etsouton:","en":"in the upright faith,","ar":"الايمان المستقيم"}},{"id":"t485-171","text":{"cop":"ⲟⲩⲟϩ ⲛ̀ⲧⲉϥⲉⲣϩ̀ⲙⲟⲧ ⲛⲁⲛ:","cop_lat":"o-woh enteferehmot nan:","en":"and grant us the forgiveness,","ar":"وينعم لنا"}},{"id":"t485-172","text":{"cop":"ⲙ̀ⲡⲓⲭⲱ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲛⲉⲛⲛⲟⲃⲓ.","cop_lat":"empiko evol ente nennovi.","en":"of our sins.","ar":"بمغفرة خطايانا."}},{"id":"t485-173","text":{"cop":"* Ϩⲓⲧⲉⲛ ⲛⲓⲡ̀ⲣⲉⲥⲃⲓⲁ̀:","cop_lat":"* Hiten ni-epresvi-a:","en":"* Through the intercessions,","ar":"بشفاعات"}},{"id":"t485-174","text":{"cop":"ⲛ̀ⲧⲉ ϯⲑⲉⲟ̀ⲧⲟⲕⲟⲥ ⲉ̅ⲑ̅ⲩ̅ Ⲙⲁⲣⲓⲁ̀:","cop_lat":"ente tithe-otokos ethowab Mari-a:","en":"of the Mother of God Saint Mary,","ar":"والدة الاله القديسة"}},{"id":"t485-175","text":{"cop":"Ⲡⲟ̅ⲥ̅ ⲁⲣⲓϩ̀ⲙⲟⲧ ⲛⲁⲛ:","cop_lat":"Epshois ari-ehmot nan:","en":"O Lord grant us,","ar":"مريم يارب أنعم لنا"}},{"id":"t485-176","text":{"cop":"ⲙ̀ⲡⲓⲭⲱ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲛⲉⲛⲛⲟⲃⲓ.","cop_lat":"empiko evol ente nennovi.","en":"the forgiveness of our sins.","ar":"بمغفرة خطايانا."}},{"id":"t485-177","text":{"cop":"(Ⲉⲑⲃⲉ ⲛⲓⲁⲅⲅⲉⲗⲟⲥ)","cop_lat":"(Ethve niangelos)","en":"(For the Angels) Thousands","ar":"لأجل الملائكة"}},{"id":"t485-178","text":{"cop":"Ϩⲁⲛⲁⲛϣⲟ ⲛ̀ϣⲟ:","cop_lat":"Hanansho ensho:","en":"of thousands,","ar":"ألوف ألوف"}},{"id":"t485-179","text":{"cop":"ⲛⲉⲙ ϩⲁⲛⲏ̀ⲃⲁ ⲛ̀̀ⲏ̀ⲃⲁ:","cop_lat":"nem haneeva eneeva:","en":"and myriads of myriads,","ar":"وربوات ربوات"}},{"id":"t485-180","text":{"cop":"ⲛ̀ⲁⲣⲭⲏⲁⲅⲅⲉⲗⲟⲥ:","cop_lat":"enarsheeangelos:","en":"of archangels,","ar":"رؤساء ملائكة"}},{"id":"t485-181","text":{"cop":"ⲛⲉⲙ ⲁⲅⲅⲉⲗⲟⲥ ⲉ̅ⲑ̅ⲩ̅.","cop_lat":"nem angelos ethowab.","en":"and holy angels.","ar":"وملائكة مقدسين."}},{"id":"t485-182","text":{"cop":"* Ⲉⲩⲟ̀ϩⲓ ⲉ̀ⲣⲁⲧⲟⲩ:","cop_lat":"* Evohi eratou:","en":"* They stand before,","ar":"وقوف أمام"}},{"id":"t485-183","text":{"cop":"ⲙ̀ⲡⲉⲙ̀ⲑⲟ ⲙ̀ⲡⲓⲏ̀ⲣⲟⲛⲟⲥ:","cop_lat":"empe-emtho empi-eeronos:","en":"the throne,","ar":"كرسى ضابط الكل"}},{"id":"t485-184","text":{"cop":"ⲛ̀ⲧⲉ ⲡⲓⲡⲁⲛⲧⲟⲕⲣⲁⲧⲱⲣ:","cop_lat":"ente pipantokrator:","en":"of the Pantocrator,","ar":"صارخين"}},{"id":"t485-185","text":{"cop":"ⲉⲩⲱϣ ⲉ̀ⲃⲟⲗ ⲉⲩϫⲱ ⲙ̀ⲙⲟⲥ.","cop_lat":"evosh evol evgo emmos.","en":"proclaiming and saying.","ar":"قائلين."}},{"id":"t485-186","text":{"cop":"Ϫⲉ ⲭ̀ⲟⲩⲁⲃ ⲭ̀ⲟⲩⲁⲃ:","cop_lat":"Je ekowab ekowab:","en":"Holy Holy,","ar":"قدوس قدوس قدوس"}},{"id":"t485-187","text":{"cop":"ⲭ̀ⲟⲩⲁⲃ ϧⲉⲛ ⲟⲩⲙⲉⲑⲙⲏⲓ:","cop_lat":"ekowab khen oumethmee:","en":"Holy in truth,","ar":"بالحقيقة المجد"}},{"id":"t485-188","text":{"cop":"ⲡⲓⲱ̀ⲟⲩ ⲛⲉⲙ ⲡⲓⲧⲁⲓⲟ̀:","cop_lat":"pi-oou nem pitai-o:","en":"the glory and the honor,","ar":"والكرامة"}},{"id":"t485-189","text":{"cop":"ⲉⲣⲡ̀ⲣⲉⲡⲓ ⲛ̀Ϯⲧ̀ⲣⲓⲁⲥ.","cop_lat":"ereprepi enti-etrias.","en":"befit the Trinity.","ar":"يليقان بالثالوث."}},{"id":"t485-190","text":{"cop":"* Ϩⲓⲧⲉⲛ ⲛⲓⲡ̀ⲣⲉⲥⲃⲓⲁ:","cop_lat":"* Hiten ni-epresvia:","en":"* Through the intercessions,","ar":"بشفاعات"}},{"id":"t485-191","text":{"cop":"ⲛ̀ⲧⲉ ⲡ̀ⲭⲟⲣⲟⲥ ⲧⲏⲣϥ ⲛ̀ⲧⲉ ⲛⲓⲁⲅⲅⲉⲗⲟⲥ:","cop_lat":"ente epkhoros teerf ente niangelos:","en":"of the whole choir of the angels,","ar":"جميع صفوف الملائكة"}},{"id":"t485-192","text":{"cop":"Ⲡⲟ̅ⲥ̅....","cop_lat":"Epshois....","en":"O Lord....","ar":"يارب...."}},{"id":"t485-193","text":{"cop":"(Ⲉⲑⲃⲉ ⲛⲓⲁ̀ⲡⲟⲥⲧⲟⲗⲟⲥ)","cop_lat":"(Ethve ni-apostolos)","en":"(For the Apostles) Our","ar":"لأجل الرسل"}},{"id":"t485-194","text":{"cop":"Ⲛⲉⲛⲓⲟϯ ⲛ̀ⲁ̀ⲡⲟⲥⲧⲟⲗⲟⲥ:","cop_lat":"Nenioti enapostolos:","en":"fathers the apostles,","ar":"آباؤنا الرسل"}},{"id":"t485-195","text":{"cop":"ⲁⲩϩⲓⲱⲓϣ ϧⲉⲛ ⲛⲓⲉⲑⲛⲟⲥ:","cop_lat":"avhioish khen niethnos:","en":"preached unto the nations,","ar":"بشروا فى الأمم"}},{"id":"t485-196","text":{"cop":"ϧⲉⲛ ⲡⲓⲉⲩⲁⲅⲅⲉⲗⲓⲟⲛ:","cop_lat":"khen pievangelion:","en":"the Gospel,","ar":"بانجيل"}},{"id":"t485-197","text":{"cop":"ⲛ̀ⲧⲉ Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅.","cop_lat":"ente Ieesous Pi-ekhristos.","en":"of Jesus Christ.","ar":"يسوع المسيح."}},{"id":"t485-198","text":{"cop":"* Ⲁⲡⲟⲩϧ̀ⲣⲱⲟⲩ ϣⲉⲛⲁϥ:","cop_lat":"* Apou-ekhroou shenaf:","en":"* Their voices went forth,","ar":"خرجت أصواتهم"}},{"id":"t485-199","text":{"cop":"ϩⲓϫⲉⲛ ⲡ̀ⲕⲁϩⲓ ⲧⲏⲣϥ:","cop_lat":"hijen epkahi teerf:","en":"into all the earth,","ar":"الى الأرض كلها"}},{"id":"t485-200","text":{"cop":"ⲟⲩⲟϩ ⲛⲟⲩⲥⲁϫⲓ ⲁⲩⲫⲟϩ:","cop_lat":"o-woh nousaji avfoh:","en":"and their words have reached,","ar":"وبلغ كلامهم الى"}},{"id":"t485-201","text":{"cop":"ϣⲁ ⲁⲩⲣⲏϫⲥ ⲛ̀ϯⲟⲓⲕⲟⲩⲙⲉⲛⲏ.","cop_lat":"sha avreegs entioikoumenee.","en":"the ends of the world.","ar":"أقطار المسكونة."}},{"id":"t485-202","text":{"cop":"Ϩⲓⲧⲉⲛ ⲛⲓⲉⲩⲭⲏ:","cop_lat":"Hiten nievshee:","en":"Through the prayers,","ar":"بصلوات"}},{"id":"t485-203","text":{"cop":"ⲛ̀ⲧⲉ ⲛⲁⲟ̅ⲥ̅ ⲛ̀ⲓⲟϯ ⲛ̀ⲁ̀ⲡⲟⲥⲧⲟⲗⲟⲥ:","cop_lat":"ente nashois enioti enapostolos:","en":"of my fathers the apostles,","ar":"سادتى الآباء الرسل"}},{"id":"t485-204","text":{"cop":"Ⲡⲟ̅ⲥ̅ ⲁ̀ⲣⲓϩ̀ⲙⲟⲧ...","cop_lat":"Epshois ari-ehmot...","en":"O Lord.....","ar":"يارب ..."}},{"id":"t485-205","text":{"cop":"(Ⲉⲑⲃⲉ ⲛⲓⲙⲁⲣⲧⲩⲣⲟⲥ)","cop_lat":"(Ethve nimartiros)","en":"(For the Martyrs)","ar":"لأجل الشهداء"}},{"id":"t485-206","text":{"cop":"* Ϩⲁⲛⲭ̀ⲗⲟⲙ ⲛ̀ⲁⲧⲗⲱⲙ:","cop_lat":"* Haneklom enatlom:","en":"* Unfading crowns,","ar":"أكاليل غير"}},{"id":"t485-207","text":{"cop":"ⲁϥⲧⲏⲓⲧⲟⲩ ⲛ̀ϫⲉ Ⲡⲟ̅ⲥ̅:","cop_lat":"afteeitou enje Epshois:","en":"the Lord has placed,","ar":"مضمحلة جعلها الرب"}},{"id":"t485-208","text":{"cop":"ϩⲓϫⲉⲛ ⲡ̀ⲭⲟⲣⲟⲥ ⲧⲏⲣϥ:","cop_lat":"hijen epkhoros teerf:","en":"upon the whole choir,","ar":"على جميع صفوف"}},{"id":"t485-209","text":{"cop":"ⲛ̀ⲧⲉ ⲛⲓⲙⲁⲣⲧⲩⲣⲟⲥ.","cop_lat":"ente nimartiros.","en":"of the martyrs.","ar":"الشهداء."}},{"id":"t485-210","text":{"cop":"Ⲁϥⲧⲟⲩϫⲱⲟⲩ ⲁϥⲛⲁϩⲙⲟⲩ:","cop_lat":"Aftougoou afnahmou:","en":"He saved and delivered them,","ar":"أنقذهم"}},{"id":"t485-211","text":{"cop":"ϫⲉ ⲁⲩⲫⲱⲧ ϩⲁⲣⲟϥ:","cop_lat":"je avfot harof:","en":"because they took refuge in Him,","ar":"وخلصهم لأنهم"}},{"id":"t485-212","text":{"cop":"ⲁⲩⲉⲣϣⲁⲓ ⲛⲉⲙⲁϥ:","cop_lat":"avershai nemaf:","en":"they celebrated with Him,","ar":"التجأوا اليه."}},{"id":"t485-213","text":{"cop":"ϧⲉⲛ ⲧⲉϥⲙⲉⲧⲟⲩⲣⲟ.","cop_lat":"khen tefmetouro.","en":"in His Kingdom.","ar":"وعيدوا معه فى ملكوته."}},{"id":"t485-214","text":{"cop":"* Ϩⲓⲧⲉⲛ ⲛⲓⲉⲩⲭⲏ:","cop_lat":"* Hiten nievshee:","en":"* Through the prayers,","ar":"بصلوات"}},{"id":"t485-215","text":{"cop":"ⲛ̀ⲧⲉ ⲡ̀ⲭⲟⲣⲟⲥ ⲧⲏⲣϥ ⲛ̀ⲧⲉ ⲛⲓⲙⲁⲣⲧⲩⲣⲟⲥ:","cop_lat":"ente epkhoros teerf ente nimartiros:","en":"of the whole choir of the martyrs,","ar":"جميع صفوف الشهداء"}},{"id":"t485-216","text":{"cop":"Ⲡⲟ̅ⲥ̅....","cop_lat":"Epshois....","en":"O Lord....","ar":"يارب ..."}},{"id":"t485-217","text":{"cop":"(Ⲉⲑⲃⲉ ⲛⲏⲉⲑⲟⲩⲁⲃ)","cop_lat":"(Ethve nee-ethowab)","en":"(For the Saints) Your","ar":"لأجل القديسين"}},{"id":"t485-218","text":{"cop":"Ⲛⲏⲉ̅ⲑ̅ⲩ̅ ⲛ̀ⲧⲁⲕ:","cop_lat":"Nee-ethowab entak:","en":"saints bless You,","ar":"قديسيك"}},{"id":"t485-219","text":{"cop":"ⲉⲩⲉ̀ⲥ̀ⲙⲟⲩ ⲉ̀ⲣⲟⲕ:","cop_lat":"eve-esmou erok:","en":"and they speak,","ar":"يباركونك."}},{"id":"t485-220","text":{"cop":"ⲉ̀ⲩⲉⲥⲁϫⲓ ⲙ̀ⲡ̀ⲱ̀ⲟⲩ:","cop_lat":"evesaji emepoou:","en":"of the glory,","ar":"وينطقون"}},{"id":"t485-221","text":{"cop":"ⲛ̀ⲧⲉ ⲧⲉⲕⲙⲉⲧⲟⲩⲣⲟ.","cop_lat":"ente tekmetouro.","en":"of Your Kingdom)","ar":"بمجد ملكوتك."}},{"id":"t485-222","text":{"cop":"* Ⲧⲉⲕⲙⲉⲧⲟⲩⲣⲟ Ⲡⲁⲛⲟⲩϯ:","cop_lat":"* Tekmetouro Panoti:","en":"* Your Kingdom O my God,","ar":"ملكوتك"}},{"id":"t485-223","text":{"cop":"ⲟⲩⲙⲉⲧⲟⲩⲣⲟ ⲛ̀ⲉ̀ⲛⲉϩ:","cop_lat":"oumetouro eneneh:","en":"is an eternal kingdom,","ar":"يا الهى ملكوت أبدى"}},{"id":"t485-224","text":{"cop":"ⲟⲩⲟϩ ⲧⲉⲕⲙⲉⲧⲟ̅ⲥ̅:","cop_lat":"o-woh tekmetshois:","en":"and Your Lordship,","ar":"وربوبيتك الى"}},{"id":"t485-225","text":{"cop":"ϣⲁ ⲛⲓⲅⲉⲛⲉⲁ̀ ⲧⲏⲣⲟⲩ.","cop_lat":"sha nigene-a teerou.","en":"is unto all ages.","ar":"كل الأجيال."}},{"id":"t485-226","text":{"cop":"Ϩⲓⲧⲉⲛ ⲛⲓⲉⲩⲭⲏ:","cop_lat":"Hiten nievshee:","en":"Through the prayers,","ar":"بصلوات"}},{"id":"t485-227","text":{"cop":"ⲛ̀ⲧⲉ ⲡ̀ⲭⲟⲣⲟⲥ ⲧⲏⲣϥ ⲛ̀ⲧⲉ ⲛⲓⲥ̀ⲧⲁⲩⲣⲟⲫⲟⲣⲟⲥ:","cop_lat":"ente epkhoros teerf ente ni-estavroforos:","en":"of the whole choir of the cross-bearers,","ar":"كافة مصاف لابسى الصليب"}},{"id":"t485-228","text":{"cop":"ⲛⲉⲙ ⲛⲓⲏ̀ⲙⲏⲓ ⲛⲉⲙ ⲛⲓⲇⲓⲕⲉⲟⲥ:","cop_lat":"nem ni-eemee nem nithikeos:","en":"the righteous and the just,","ar":"والأبرار والصديقين"}},{"id":"t485-229","text":{"cop":"Ⲡⲟ̅ⲥ̅...","cop_lat":"Epshois...","en":"O Lord....","ar":"يارب..."}},{"id":"t485-230","text":{"cop":"(Ⲉⲑⲃⲉ ⲛⲓⲡⲁⲧⲣⲓⲁⲣⲭⲏⲥ ⲛⲉⲙ ⲛⲓⲡ̀ⲣⲟⲫⲏⲧⲏⲥ)","cop_lat":"(Ethve nipatriarshees nem ni-eprofeetees)","en":"(For the Patriarchs and the Prophets) * Hail to Elijah,","ar":"لأجل الآباء والأنبياء السلام"}},{"id":"t485-231","text":{"cop":"* Ⲭⲉⲣⲉ Ⲉⲗⲓⲁⲥ:","cop_lat":"* Shere Elias:","en":"the prophet","ar":"لايليا"}},{"id":"t485-232","text":{"cop":"ⲡⲓⲥⲟⲫⲣⲟⲛ ⲙ̀ⲡ̀ⲣⲟⲫⲏⲧⲏⲥ:","cop_lat":"pisofron emeprofeetees:","en":"of temperance,","ar":"النبى المتعفف"}},{"id":"t485-233","text":{"cop":"ⲛⲉⲙ Ⲉⲗⲓⲥⲉⲟⲥ:","cop_lat":"nem Eliseos:","en":"and Elisha,","ar":"واليشع"}},{"id":"t485-234","text":{"cop":"ⲡⲉϥⲥⲱⲧⲡ ⲙ̀ⲙⲁⲑⲏⲧⲏⲥ.","cop_lat":"pefsotp emmatheetees.","en":"his elect disciple.","ar":"تلميذه المختار."}},{"id":"t485-235","text":{"cop":"Ⲡⲓⲛⲓϣϯ ⲛ̀ⲣⲉϥϩⲓⲱⲓϣ:","cop_lat":"Pinishti enrefhioish:","en":"The great Evangelist,","ar":"المبشر العظيم"}},{"id":"t485-236","text":{"cop":"ϧⲉⲛ ϯⲭⲱⲣⲁ ⲛ̀ⲧⲉ Ⲭⲏⲙⲓ:","cop_lat":"khen tikhora ente Keemi:","en":"of the land of Egypt,","ar":"فى كورة مصر"}},{"id":"t485-237","text":{"cop":"Ⲙⲁⲣⲕⲟⲥ ⲡⲓⲁ̀ⲡⲟⲥⲧⲟⲗⲟⲥ:","cop_lat":"Markos pi-apostolos:","en":"Mark the Apostle,","ar":"مرقس الرسول"}},{"id":"t485-238","text":{"cop":"ⲡⲉⲥϣⲟⲣⲡ ⲛ̀ⲛⲉϥⲉⲣϩⲉⲙⲓ.","cop_lat":"pesshorp enneferhemi.","en":"the first prelate.","ar":"مدبرها الأول."}},{"id":"t485-239","text":{"cop":"* Ⲛⲑⲟ ⲡⲉ ⲏ̀ⲙⲁⲩ ⲙ̀Ⲫϯ:","cop_lat":"* Ntho pe eemav emefnoti:","en":"* You are the Mother of God,","ar":"أنت هى أم الله يامريم"}},{"id":"t485-240","text":{"cop":"Ⲙⲁⲣⲓⲁ̀ ϯⲡⲁⲣⲑⲉⲛⲟⲥ:","cop_lat":"Mari-a tiparthenos:","en":"O Virgin Mary,","ar":"العذراء."}},{"id":"t485-241","text":{"cop":"ⲧⲱⲃϩ ⲙ̀ⲙⲟϥ ⲉ̀ϫⲱⲛ:","cop_lat":"tovh emmof egon:","en":"ask Him on our behalf,","ar":"أطلبى منه"}},{"id":"t485-242","text":{"cop":"ⲉⲑⲣⲉϥⲛⲁⲓ ϧⲁ ⲡⲉⲛⲅⲉⲛⲟⲥ.","cop_lat":"ethrefnai kha pengenos.","en":"to have mercy upon our race.","ar":"عنا أن يرحم جنسنا."}},{"id":"t485-243","text":{"cop":"Ⲡⲓⲛⲓϣϯ ⲙ̀ⲡⲁⲧⲣⲓⲁⲣⲭⲏⲥ:","cop_lat":"Pinishti empatriarshees:","en":"The great patriarch,","ar":"البطريرك العظيم"}},{"id":"t485-244","text":{"cop":"ⲡⲉⲛⲓⲱⲧ ⲁⲃⲃⲁ Ⲥⲉⲩⲏ̀ⲣⲟⲥ:","cop_lat":"peniot abba Seveeros:","en":"our father Abba Severus,","ar":"أبونا أنبا ساويرس"}},{"id":"t485-245","text":{"cop":"ⲫⲏⲉⲧⲁ ⲛⲉϥⲥ̀ⲃⲱⲟⲩⲓ̀ ⲉ̅ⲑ̅ⲩ̅:","cop_lat":"fee-eta nefesvooui ethowab:","en":"whose holy teachings,","ar":"الذى أنارت تعاليمه"}},{"id":"t485-246","text":{"cop":"ⲉ̀ⲣⲟⲩⲱⲓⲛⲓ ⲙ̀ⲡⲉⲛⲛⲟⲩⲥ.","cop_lat":"erowoini empennous.","en":"enlightened our minds.","ar":"المقدسة عقولنا."}},{"id":"t485-247","text":{"cop":"* Ⲡⲉⲛⲓⲱⲧ ⲛ̀ⲟ̀ⲙⲟⲗⲟⲅⲓⲧⲏⲥ:","cop_lat":"* Peniot enomologitees:","en":"* Our father the confessor,","ar":"أبونا المعترف أنبا"}},{"id":"t485-248","text":{"cop":"ⲁⲃⲃⲁ Ⲇⲓⲟⲥⲕⲟⲣⲟⲥ:","cop_lat":"abba Dioskoros:","en":"Abba Dioscorus,","ar":"ديسقوروس"}},{"id":"t485-249","text":{"cop":"ⲁϥⲙⲓϣⲓ ⲉ̀ϫⲉⲛ ⲡⲓⲛⲁϩϯ:","cop_lat":"afmishi ejen pinahti:","en":"defended the faith,","ar":"حارب عن الايمان"}},{"id":"t485-250","text":{"cop":"ⲟⲩⲃⲉ ⲛⲓϩⲉⲣⲉⲧⲓⲕⲟⲥ.","cop_lat":"ouve niheretikos.","en":"against the heretics.","ar":"ضد الهراطقة."}},{"id":"t485-251","text":{"cop":"Ⲛⲉⲙ ⲛⲉⲛⲓⲟϯ ⲧⲏⲣⲟⲩ:","cop_lat":"Nem nenioti teerou:","en":"And all of our fathers,","ar":"وكل آبائنا"}},{"id":"t485-252","text":{"cop":"ⲉ̀ⲧⲁⲩⲣⲁⲛⲁϥ ⲙ̀Ⲡⲟ̅ⲥ̅:","cop_lat":"etavranaf emepshois:","en":"who have pleased the Lord,","ar":"الذين أرضوا الرب"}},{"id":"t485-253","text":{"cop":"ⲉ̀ⲣⲉ ⲡⲟⲩⲥ̀ⲙⲟⲩ ⲉ̅ⲑ̅ⲩ̅:","cop_lat":"ere pou-esmou ethowab:","en":"may their holy blessings,","ar":"بركتهم المقدسة"}},{"id":"t485-254","text":{"cop":"ϣⲱⲡⲓ ⲛⲁⲛ ⲛ̀ⲟⲩⲣⲉϥⲣⲱⲓⲥ.","cop_lat":"shopi nan enourefrois.","en":"be a guard unto us.","ar":"تكون لنا حارسا."}},{"id":"t485-255","text":{"cop":"* Ϩⲓⲧⲉⲛ ⲛⲟⲩⲉⲩⲭⲏ:","cop_lat":"* Hiten nowevshee:","en":"* Through their prayers,","ar":"بصلواتهم"}},{"id":"t485-256","text":{"cop":"ⲁ̀ⲣⲓϩ̀ⲙⲟⲧ ⲛⲁⲛ Ⲫϯ:","cop_lat":"ari-ehmot nan Efnoti:","en":"O God grant us,","ar":"أنعم لنا"}},{"id":"t485-257","text":{"cop":"ⲙ̀ⲡⲓⲭⲱ ⲉ̀ⲃⲟⲗ ⲛ̀ⲧⲉ ⲛⲉⲛⲛⲟⲃⲓ:","cop_lat":"empiko evol ente nennovi:","en":"the forgiveness of our sins,","ar":"يا الله بمغفرة خطايانا"}},{"id":"t485-258","text":{"cop":"ⲙⲟⲓ ⲛⲁⲛ ⲛ̀ⲟⲩⲥⲱϯ.","cop_lat":"moi nan enousoti.","en":"and give us peace.","ar":"وأعطنا سلاما."}}]}