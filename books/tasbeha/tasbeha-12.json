{"title":"Fasts › Lazarus Saturday","source":"tasbeha.org hymn library","languages":{"en":"English","cop":"Ⲙⲉⲧⲣⲉⲙⲛ̀ⲭⲏⲙⲓ","cop_lat":"Coptic (Latin letters)","ar":"عربي"},"roles":{"priest":{"en":"Priest","de":"Priester","ar":"الكاهن","cop":"Ⲡⲓⲟⲩⲏⲃ"},"deacon":{"en":"Deacon","de":"Diakon","ar":"الشماس","cop":"Ⲡⲓⲇⲓⲁⲕⲱⲛ"},"people":{"en":"People","de":"Gemeinde","ar":"الشعب","cop":"Ⲡⲓⲗⲁⲟⲥ"}},"paragraphs":[{"id":"t1687-1","text":{"cop":"Ⲗⲁⲍⲁⲣⲟⲥ ⲁ̀ⲙⲟⲩ ⲉ̀ⲃⲟⲗ:","cop_lat":"Lazaros amou evol:","en":"“Lazarus come","ar":"\"لعازر هلم"},"section":{"en":"Distribution Hymn, Ⲗⲁⲍⲁⲣⲟⲥ ⲁ̀ⲙⲟⲩ ⲉ̀ⲃⲟⲗ","path":"Fasts › Lazarus Saturday"}},{"id":"t1687-2","text":{"cop":"Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ ⲁϥⲙⲟⲩϯ ⲉ̀ⲣⲟⲕ:","cop_lat":"Pi-ekhristos afmouti erok:","en":"forth,” Christ called to You,","ar":"خارجاً،\" المسيح دعاك،"}},{"id":"t1687-3","text":{"cop":"ϧⲉⲛ ⲧⲉϥⲫⲱⲛⲓ ⲛ̀ⲣⲉϥⲧⲁⲛϧⲟ:","cop_lat":"khen teffoni enreftankho:","en":"with His life-giving voice,","ar":"بصوته المحيي قائلاً،"}},{"id":"t1687-4","text":{"cop":"ϫⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲁ̀ⲙⲟⲩ ⲉ̀ⲃⲟⲗ.","cop_lat":"je Lazaros amou evol.","en":"saying “Lazarus come forth!”","ar":"\"لعازر هلم خارجاً.\""}},{"id":"t1687-5","text":{"cop":"Ⲗⲁⲍⲁⲣⲟⲥ ⲁϥⲙⲟϩ ⲟⲩⲟϩ ⲁⲩⲭⲁϥ:","cop_lat":"Lazaros afmoh o-woh avkaf:","en":"Lazarus died and was buried,","ar":"لعازر مات ووُضع،"}},{"id":"t1687-6","text":{"cop":"ϧⲉⲛ ⲡⲓⲙ̀ϩⲁⲩ ⲛ̀ϥ̀ⲧⲟⲟⲩ ⲛ̀ⲉ̀ϩⲟⲟⲩ:","cop_lat":"khen pi-emhav eneftoou enehoou:","en":"in the tomb for four days,","ar":"في القبر أربعة أيام،"}},{"id":"t1687-7","text":{"cop":"ⲁ̀ ϯⲥ̀ⲙⲏ ⲛ̀ⲧⲉ Ⲡ̀ϭⲟⲓⲥ ⲫⲟϩ ϣⲁⲣⲟϥ:","cop_lat":"a ti-esmee ente Epshois foh sharof:","en":"the Lord's voice reached him,","ar":"صوت الرب بلغ إليه،"}},{"id":"t1687-8","text":{"cop":"ϫⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲁ̀ⲙⲟⲩ ⲉ̀ⲃⲟⲗ.","cop_lat":"je Lazaros amou evol.","en":"saying “Lazarus come forth!”","ar":"\"لعازر هلم خارجاً.\""}},{"id":"t1687-9","text":{"cop":"Ⲛⲓⲙⲏϣ ⲉ̀ⲧⲁⲩⲑⲱⲟⲩϯ ⲙ̀ⲙⲁⲩ:","cop_lat":"Nimeesh etavthoouti emmav:","en":"The crowd which gathered there,","ar":"الجموع الذين إجتمعوا هناك،"}},{"id":"t1687-10","text":{"cop":"ⲉⲑⲣⲟⲩⲛⲟⲙϯ ⲛ̀ⲧⲉϥⲥⲱⲛⲓ:","cop_lat":"ethrounomti entefsoni:","en":"to comfort his sister,","ar":"ليعزوا أخته،"}},{"id":"t1687-11","text":{"cop":"ⲁⲩⲥⲱⲧⲉⲙ ⲙ̀Ⲡ̀ϭⲟⲓⲥ:","cop_lat":"avsotem emepshois:","en":"heard the Lord,","ar":"سمعوا الرب قائلاً،"}},{"id":"t1687-12","text":{"cop":"ϫⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲁ̀ⲙⲟⲩ ⲉ̀ⲃⲟⲗ.","cop_lat":"je Lazaros amou evol.","en":"saying “Lazarus come forth!”","ar":"\"لعازر هلم خارجاً.\""}},{"id":"t1687-13","text":{"cop":"Ⲡⲉϫⲉ Ⲙⲁⲣⲑⲁ ⲙ̀Ⲡⲉⲛϭⲟⲓⲥ Ⲓⲏⲥⲟⲩⲥ:","cop_lat":"Peje Martha empenshois Ieesous:","en":"Martha said to our Lord Jesus,","ar":"فقالت مرثا لربنا يسوع،"}},{"id":"t1687-14","text":{"cop":"ⲁ̀ ⲛⲁⲕⲭⲏ ⲙ̀ⲡⲁⲓⲙⲁ:","cop_lat":"a nakkee empaima:","en":"“Had You been here my brother would have not died,","ar":"لو كنت ههنا لم يموت أخي،"}},{"id":"t1687-15","text":{"cop":"ⲛⲁⲣⲉⲡⲁⲥⲟⲛ ⲙⲟⲩ ⲁⲛ ⲁⲗⲗⲁ ϯⲛⲁⲉ̀ⲙⲓ:","cop_lat":"narepason mou an alla tina-emi:","en":"but I know [You will call],","ar":"بل انا أعلم أنك تدعو،"}},{"id":"t1687-16","text":{"cop":"ϫⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲁ̀ⲙⲟⲩ ⲉ̀ⲃⲟⲗ.","cop_lat":"je Lazaros amou evol.","en":"saying ‘Lazarus come forth.’”","ar":"\"لعازر هلم خارجاً.\""}},{"id":"t1687-17","text":{"cop":"Ⲡⲉϫⲁϥ ⲛⲁⲥ ⲛ̀ϫⲉ Ⲡⲉⲛϭⲟⲓⲥ:","cop_lat":"Pegaf nas enje Penshois:","en":"Our Lord said to her,","ar":"فقال لها ربنا،"}},{"id":"t1687-18","text":{"cop":"ϫⲉ ⲁ̀ⲣⲉϣⲁⲛ ⲛⲁϩϯ ⲛ̀ϧⲏⲧ:","cop_lat":"je areshan nahti enkheet:","en":"“If you believe in Me,","ar":"\"إن آمنتِ بي،"}},{"id":"t1687-19","text":{"cop":"ⲓⲥ ϩⲏⲡⲡⲉ ϯⲛⲁⲙⲟⲩϯ ⲉ̀ⲣⲟϥ:","cop_lat":"is heeppe tinamouti erof:","en":"Then behold I will call him,","ar":"ها هوذا أدعوه،"}},{"id":"t1687-20","text":{"cop":"ϫⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲁ̀ⲙⲟⲩ ⲉ̀ⲃⲟⲗ.","cop_lat":"je Lazaros amou evol.","en":"saying ‘Lazarus come forth.’”","ar":"لعازر هلم خارجاً.\""}},{"id":"t1687-21","text":{"cop":"Ⲉⲓⲛⲁϩϯ ϫⲉ ⲛ̀ⲑⲟⲕ ⲡⲉ Ⲡ̀ϣⲏⲣⲓ ⲙ̀Ⲫ̀ⲛⲟⲩϯ:","cop_lat":"Einahti je enthok pe Epsheeri emefnoti:","en":"“I believe that You are the Son of God,","ar":"\"آمنت أنك أنت هو إبن الله،"}},{"id":"t1687-22","text":{"cop":"ⲫⲏⲉ̀ⲧⲉⲟⲩⲟⲛ ϣ̀ϫⲟⲙ ⲙ̀ⲙⲟⲕ:","cop_lat":"fee-eteowon eshgom emmok:","en":"who is able to,","ar":"تستطيع أن،"}},{"id":"t1687-23","text":{"cop":"ⲉⲑⲣⲉⲕⲙⲟⲩϯ ⲉ̀ⲣⲟϥ ϧⲉⲛ ⲧⲉⲕϫⲟⲙ:","cop_lat":"ethrekmouti erof khen tekgom:","en":"call him out, by Your might,","ar":"تدعوه بقوتك،"}},{"id":"t1687-24","text":{"cop":"ϫⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲁ̀ⲙⲟⲩ ⲉ̀ⲃⲟⲗ.","cop_lat":"je Lazaros amou evol.","en":"saying ‘Lazarus come forth!’”","ar":"لعازر هلم خارجاً.\""}},{"id":"t1687-25","text":{"cop":"Ⲛⲁⲓ ⲉ̀ⲧⲁϥϫⲟⲧⲟⲩ ⲁϥϥⲁⲓ ⲛ̀ⲛⲉϥⲃⲁⲗ:","cop_lat":"Nai etafgotou affai ennefval:","en":"Saying this He lifted His eyes,","ar":"لما قال هذا رفع عينيه،"}},{"id":"t1687-26","text":{"cop":"ⲉ̀ⲡ̀ϣⲱⲓ ϩⲁ Ⲡⲉϥⲓⲱⲧ ⲛ̀ⲁ̀ⲅⲁⲑⲟⲥ:","cop_lat":"e-epshoi ha Pefiot enaghathos:","en":"to His good Father,","ar":"إلى فوق نحو أبيه الصالح،"}},{"id":"t1687-27","text":{"cop":"ⲉϥⲱϣ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲟⲩⲛⲓϣϯ ⲛ̀ⲥ̀ⲙⲏ:","cop_lat":"efosh evol khen ounishti enesmee:","en":"crying out with a great voice,","ar":"صارخاً بصوت عظيم،"}},{"id":"t1687-28","text":{"cop":"ϫⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲁ̀ⲙⲟⲩ ⲉ̀ⲃⲟⲗ.","cop_lat":"je Lazaros amou evol.","en":"saying “Lazarus come forth!”","ar":"\"لعازر هلم خارجاً.\""}},{"id":"t1687-29","text":{"cop":"Ⲛⲓⲗⲉⲅⲉⲟⲛ ⲉ̀ⲧⲁⲩⲥⲟⲛϩ ⲙ̀ⲙⲟϥ:","cop_lat":"Nilegeon etavsonh emmof:","en":"The evil legions who bound him,","ar":"جنود الشر الذين أوثقوه،"}},{"id":"t1687-30","text":{"cop":"ϧⲉⲛ ⲟⲩⲙⲉⲧⲃⲱⲕ ⲙ̀ⲡⲓⲓ̀ⲧⲁⲣⲧⲁⲣⲟⲥ:","cop_lat":"khen oumetvok empitartaros:","en":"in servitude in the depth of depths,","ar":"في عبودية أسفل السافلين،"}},{"id":"t1687-31","text":{"cop":"ⲡⲉϫⲱⲟⲩ ϫⲉ ⲛⲓⲙ ⲡⲉ ⲫⲁⲓ ⲉⲑⲛⲁ ϫⲉ ⲡⲁⲓⲥⲁϫⲓ:","cop_lat":"pegoou je nim pe fai ethna je paisaji:","en":"said “Who is this who spoke,","ar":"قائلين \"مَنْ هو هذا المتكلم،"}},{"id":"t1687-32","text":{"cop":"ϫⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲁ̀ⲙⲟⲩ ⲉ̀ⲃⲟⲗ.","cop_lat":"je Lazaros amou evol.","en":"saying ‘Lazarus come forth.’","ar":"لعازر هلم خارجاً."}},{"id":"t1687-33","text":{"cop":"Ϫⲉ ⲛⲓⲙ ⲡⲉ ⲫⲁⲓ ⲉ̀ⲧⲁ ⲧⲉϥⲥ̀ⲙⲏ:","cop_lat":"Je nim pe fai eta tefesmee:","en":"Who is this whose voice,","ar":"مَنْ هو الذي صوته،"}},{"id":"t1687-34","text":{"cop":"ⲁϥⲕⲱϣ ⲛ̀ϩⲁⲛⲡⲉⲇⲏⲥ ⲛ̀ⲛⲓⲣⲉϥⲥⲱⲛϩ:","cop_lat":"afkosh enhanpethees ennirefsonh:","en":"broke the shackles of the bound,","ar":"كسر قيود المربوطين،"}},{"id":"t1687-35","text":{"cop":"ϫⲉ ⲁϥϫⲟⲥ ⲛⲁϥ ϧⲉⲛ ⲟⲩⲙⲉⲧⲁⲧϩⲟϯ:","cop_lat":"je afgos naf khen oumetathoti:","en":"and told him without fear,","ar":"وقال له بغير خوف،"}},{"id":"t1687-36","text":{"cop":"ϫⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲁ̀ⲙⲟⲩ ⲉ̀ⲃⲟⲗ.","cop_lat":"je Lazaros amou evol.","en":"saying ‘Lazarus come forth.’","ar":"لعازر هلم خارجاً."}},{"id":"t1687-37","text":{"cop":"Ⲧⲱⲟⲩⲛⲟⲩ ⲭⲁϥ ⲙ̀ⲙⲟϥ ⲟⲩⲟϩ ⲉⲛⲫⲱⲧ:","cop_lat":"Toounou kaf emmof o-woh enfot:","en":"Rise leave Him and flee,","ar":"قوموا لنتركه ونهرب،"}},{"id":"t1687-38","text":{"cop":"ⲫⲁⲓ ⲡⲉ ⲫⲏⲉⲧⲧⲁⲛϧⲟ ⲛ̀ⲛⲓⲣⲉϥⲙⲱⲟⲩⲧ:","cop_lat":"fai pe fee-ettankho ennirefmoout:","en":"this is the Life-Giver to the dead,","ar":"لأن هذا هو محيي الأموات،"}},{"id":"t1687-39","text":{"cop":"ⲁϥϯ ⲛ̀ⲧⲉϥⲥ̀ⲙⲏ ⲟⲩⲟϩ ⲁϥϩⲟⲛϩⲉⲛ ⲙ̀ⲙⲟϥ:","cop_lat":"afti entefesmee o-woh afhonhen emmof:","en":"He revealed His voice and ordered him,","ar":"أعلن صوته وأمره،"}},{"id":"t1687-40","text":{"cop":"ϫⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲁ̀ⲙⲟⲩ ⲉ̀ⲃⲟⲗ.","cop_lat":"je Lazaros amou evol.","en":"saying ‘Lazarus come forth.’”","ar":"لعازر هلم خارجاً.\""}},{"id":"t1687-41","text":{"cop":"Ⲥⲁⲧⲟⲧϥ Ⲗⲁⲍⲁⲣⲟⲥ ⲁϥⲓ̀ ⲉ̀ⲃⲟⲗ:","cop_lat":"Satotf Lazaros afi evol:","en":"Immediately Lazarus came out,","ar":"فخرج لعازر لوقته،"}},{"id":"t1687-42","text":{"cop":"ⲉϥⲙⲏⲣ ⲛ̀ⲟⲩⲥⲟⲇⲁⲣⲓⲟⲛ:","cop_lat":"efmeer enousotharion:","en":"bound in linen,","ar":"مربوطاً بعمامة،"}},{"id":"t1687-43","text":{"cop":"ϧⲉⲛ ⲡ̀ϫⲓⲛⲑ̀ⲣⲉ Ⲡ̀ϭⲟⲓⲥ ⲙⲟⲩϯ ⲉ̀ⲣⲟϥ:","cop_lat":"khen epjinethre Epshois mouti erof:","en":"when the Lord called him,","ar":"عندما دعاه الرب قائلاً،"}},{"id":"t1687-44","text":{"cop":"ϫⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲁ̀ⲙⲟⲩ ⲉ̀ⲃⲟⲗ.","cop_lat":"je Lazaros amou evol.","en":"saying “Lazarus come forth!”","ar":"\"لعازر هلم خارجاً.\""}},{"id":"t1687-45","text":{"cop":"Ⲛⲏⲉ̀ⲧⲁⲩⲓ̀ ϩⲁ Ⲙⲁⲣⲓⲁ:","cop_lat":"Nee-etavi ha Maria:","en":"Those who came to Mary,","ar":"فأولئك الذين أتوا إلى مريم،"}},{"id":"t1687-46","text":{"cop":"ⲁⲩⲛⲁϩϯ ⲉⲑⲃⲉ ⲛⲏⲉ̀ⲧⲁⲩⲁⲓⲧⲟⲩ:","cop_lat":"avnahti ethve nee-etavaitou:","en":"believed because of what He had done,","ar":"أمنوا من أجل ما صنع،"}},{"id":"t1687-47","text":{"cop":"ⲛⲉⲙ ⲉⲑⲃⲉ ϯⲥ̀ⲙⲏ ⲉ̀ⲧⲁⲩⲥⲟⲑⲙⲉⲥ:","cop_lat":"nem ethve ti-esmee etavsothmes:","en":"and because of the voice they heard,","ar":"ومن أجل الصوت الذي سمعوه،"}},{"id":"t1687-48","text":{"cop":"ϫⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲁ̀ⲙⲟⲩ ⲉ̀ⲃⲟⲗ.","cop_lat":"je Lazaros amou evol.","en":"saying “Lazarus come forth!”","ar":"\"لعازر هلم خارجاً.\""}},{"id":"t1687-49","text":{"cop":"Ⲙⲁⲣⲉⲛⲑⲱⲟⲩϯ ⲟⲩⲟϩ ⲛ̀ⲧⲉⲛϩⲱⲥ:","cop_lat":"Marenthoouti o-woh entenhos:","en":"Let us gather and praise,","ar":"فلنجتمع ونسبح،"}},{"id":"t1687-50","text":{"cop":"ⲙ̀Ⲡⲉⲛϭⲟⲓⲥ Ⲓⲏⲥⲟⲩⲥ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ:","cop_lat":"empenshois Ieesous Pi-ekhristos:","en":"our Lord Jesus Christ,","ar":"ربنا يسوع المسيح،"}},{"id":"t1687-51","text":{"cop":"ⲧⲉⲛⲱϣ ⲉ̀ⲃⲟⲗ ⲙ̀ⲫⲏⲉ̀ⲧⲁϥϫⲟⲥ:","cop_lat":"tenosh evol emfee-etafgos:","en":"and cry out to Him who said,","ar":"ونصرخ لمَنْ قال،"}},{"id":"t1687-52","text":{"cop":"ϫⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲁ̀ⲙⲟⲩ ⲉ̀ⲃⲟⲗ.","cop_lat":"je Lazaros amou evol.","en":"“Lazarus come forth!”","ar":"\"لعازر هلم خارجاً.\""}},{"id":"t1687-53","text":{"cop":"Ⲭⲱ ⲛⲁⲛ ⲉ̀ⲃⲟⲗ ⲛ̀ⲛⲉⲛⲁ̀ⲛⲟⲙⲓⲁ:","cop_lat":"Ko nan evol ennenanomia:","en":"Forgive us our iniquities,","ar":"إغفر لنا آثامنا،"}},{"id":"t1687-54","text":{"cop":"ⲟⲩⲟϩ ⲙⲟⲓ ⲛⲁⲛ ⲛ̀ⲟⲩⲥⲱⲧⲏⲣⲓⲁ:","cop_lat":"o-woh moi nan enousoteeria:","en":"and grant us salvation,","ar":"وأعطنا خلاصاً،"}},{"id":"t1687-55","text":{"cop":"ϩⲓⲧⲉⲛ ⲛⲉⲛⲧⲱⲃϩ ⲛⲉⲙ ⲛⲉⲛⲡ̀ⲣⲉⲥⲃⲓⲁ:","cop_lat":"hiten nentovh nem nenepresvia:","en":"through the prayers and intercessions,","ar":"بطلبات وشفاعات،"}},{"id":"t1687-56","text":{"cop":"ⲛ̀ⲧⲉ ⲧⲉⲛϭⲟⲓⲥ ⲛ̀ⲛⲏⲃ ϯⲁ̀ⲅⲓⲁ Ⲙⲁⲣⲓⲁ.","cop_lat":"ente tenshois enneeb ti-agia Maria.","en":"of our Lady Saint Mary.","ar":"سيدتنا كلنا القديسة مريم."}},{"id":"t1783-0","text":{"cop":"Ⲁ̀ⲙⲱⲓⲛⲓ ⲧⲏⲣⲟⲩ ⲛ̀ⲧⲉⲛϩⲱⲥ:","cop_lat":"Amoini teerou entenhos:","en":"Come all to praise,","ar":"تعالوا جميعاً لنسبح،"},"section":{"en":"Watos Psali, Ⲁ̀ⲙⲱⲓⲛⲓ ⲧⲏⲣⲟⲩ ⲛ̀ⲧⲉⲛϩⲱⲥ","path":"Fasts › Lazarus Saturday"}},{"id":"t1783-1","text":{"cop":"ⲟⲩⲟϩ ⲛ̀ⲧⲉⲛⲉⲣⲯⲁⲗⲓⲛ ⲉ̀Ⲡ̀ϭⲟⲓⲥ:","cop_lat":"o-woh entenerpsalin e-epshois:","en":"and sing to the Lord,","ar":"ونرتل للرب،"}},{"id":"t1783-2","text":{"cop":"Ⲓⲏⲥⲟⲩⲥ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ Ⲡⲓⲗⲟⲅⲟⲥ:","cop_lat":"Ieesous Pi-ekhristos Piloghos:","en":"Jesus Christ the Logos,","ar":"يسوع المسيح الكلمة،"}},{"id":"t1783-3","text":{"cop":"ⲫⲏⲉ̀ⲧⲁϥⲧⲟⲩⲛⲟⲥ ⲛ̀Ⲗⲁⲍⲁⲣⲟⲥ.","cop_lat":"fee-etaftounos enlazaros.","en":"who raised Lazarus.","ar":"الذي أقام لعازر."}},{"id":"t1783-4","text":{"cop":"Ⲃⲟⲛ ⲛⲓⲃⲉⲛ ⲥⲉϯⲱ̀ⲟⲩ ⲛⲁⲕ:","cop_lat":"Von niven seti-oou nak:","en":"Everyone glorifies You,","ar":"الكل يمجدونك،"}},{"id":"t1783-5","text":{"cop":"ⲱ̀ Ⲡⲓϣⲏⲣⲓ ⲛ̀ⲁⲓⲇⲓⲟⲥ:","cop_lat":"o Pisheeri enaithios:","en":"O eternal Son,","ar":"أيها الإبن الذاتي،"}},{"id":"t1783-6","text":{"cop":"ⲟⲩⲟϩ ⲡⲓⲱ̀ⲟⲩ ϥ̀ⲉⲣϣⲁⲩ ⲛⲁⲕ:","cop_lat":"o-woh pi-oou efershav nak:","en":"and glory befits You,","ar":"ويليق بك المجد،"}},{"id":"t1783-7","text":{"cop":"ϫⲉ ⲁⲕⲧⲟⲩⲛⲟⲥ ⲛ̀Ⲗⲁⲍⲁⲣⲟⲥ.","cop_lat":"je aktounos enlazaros.","en":"for You have raised Lazarus.","ar":"لأنك أقمت لعازر."}},{"id":"t1783-8","text":{"cop":"+ Ⲅⲉ ⲅⲁⲣ ⲁϥϣⲱⲡⲓ ϧⲉⲛ ⲟⲩⲙⲉⲑⲙⲏⲓ:","cop_lat":"+ Ge ghar afshopi khen oumethmee:","en":"+ For truly Lazarus was dead,","ar":"+ لأنه حدث بالحقيقة،"}},{"id":"t1783-9","text":{"cop":"ϫⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲁϥⲙⲟⲩ ⲟⲩⲟϩ ϧⲉⲛ ⲡⲓⲧⲁⲫⲟⲥ:","cop_lat":"je Lazaros afmou o-woh khen pitafos:","en":"they buried him in the tomb,","ar":"أن لعازر قد مات ودفنوه في القبر،"}},{"id":"t1783-10","text":{"cop":"ⲁⲩⲕⲟⲥϥ ⲙⲉⲛⲉⲛⲥⲁ ϥ̀ⲧⲟⲟⲩ ⲛ̀ⲉ̀ϩⲟⲟⲩ:","cop_lat":"avkosf menensa eftoou enehoou:","en":"and after four days,","ar":"وبعد أربعة أيام،"}},{"id":"t1783-11","text":{"cop":"ⲁϥⲧⲟⲩⲛⲟⲥϥ ⲛ̀ϫⲉ Ⲓⲏⲥⲟⲩⲥ.","cop_lat":"aftounosf enje Ieesous.","en":"Jesus raised him.","ar":"أقامه يسوع."}},{"id":"t1783-12","text":{"cop":"+ Ⲇⲓⲕⲉⲟⲥ ⲉ̀ⲧⲁⲥⲉ̀ⲙⲓ ⲛ̀ϫⲉ Ⲙⲁⲣⲑⲁ:","cop_lat":"+ Thikeos etasemi enje Martha:","en":"+ When the righteous Martha learned,","ar":"+ لما علمت البارة مرثا،"}},{"id":"t1783-13","text":{"cop":"ϧⲉⲛ ⲡ̀ϫⲓⲛⲓ̀ ⲙ̀Ⲡⲉⲛϭⲟⲓⲥ Ⲓⲏⲥⲟⲩⲥ:","cop_lat":"khen epjini empenshois Ieesous:","en":"of the coming of our Lord Jesus,","ar":"بمجئ ربنا يسوع،"}},{"id":"t1783-14","text":{"cop":"ⲁⲥⲣⲓⲙⲓ ϫⲉ ⲉ̀ⲛⲁⲕⲭⲏ ⲙ̀ⲡⲁⲓⲙⲁ:","cop_lat":"asrimi je enakkee empaima:","en":"she cried saying “If You were here,","ar":"بكت قائلة \"لو كنت ههنا،"}},{"id":"t1783-15","text":{"cop":"ⲛⲉ ⲙ̀ⲡⲉϥⲙⲟⲩ ϫⲉ ⲡⲁⲥⲟⲛ Ⲗⲁⲍⲁⲣⲟⲥ.","cop_lat":"ne empefmou je pason Lazaros.","en":"Lazarus my brother would not have died.”","ar":"ما كان قد مات أخي لعازر.\""}},{"id":"t1783-16","text":{"cop":"Ⲉ̀ⲧⲁϥⲛⲁⲩ ⲉ̀ⲣⲟⲥ ⲛ̀ϫⲉ Ⲡⲉⲛⲛⲟⲩϯ:","cop_lat":"Etafnav eros enje Pennoti:","en":"When our God saw her,","ar":"ولما رآها إلهنا تبكي،"}},{"id":"t1783-17","text":{"cop":"ⲉⲥⲣⲓⲙⲓ ⲁϥϣⲉⲛϩⲏⲧ ϧⲁⲣⲟⲥ:","cop_lat":"esrimi afshenheet kharos:","en":"he had compassion on her,","ar":"تراءف عليها،"}},{"id":"t1783-18","text":{"cop":"ⲡⲉϫⲁϥ ⲛⲁⲥ ϫⲉ ⲱ̀ ϯⲥ̀ϩⲓⲙⲓ:","cop_lat":"pegaf nas je o ti-eshimi:","en":"and told her “O woman,","ar":"وقال لها \"يا إمرأة،"}},{"id":"t1783-19","text":{"cop":"ϥ̀ⲛⲁⲧⲱⲛϥ ⲛ̀ϫⲉ Ⲗⲁⲍⲁⲣⲟⲥ.","cop_lat":"efnatonf enje Lazaros.","en":"Lazarus will rise.” Then she said to Him “Yes,","ar":"سيقوم لعازر.\" فقالت له \"نعم،"}},{"id":"t1783-20","text":{"cop":"Ⲍⲉ ⲟⲛⲧⲟⲥ ⲡⲉϫⲁⲥ ⲛⲁϥ:","cop_lat":"Ze ontos pegas naf:","en":"in the end of times,","ar":"في آخر الأزمنة،"}},{"id":"t1783-21","text":{"cop":"ϧⲉⲛ ⲧ̀ϧⲁⲉ̀ ⲛ̀ⲛⲓⲭ̀ⲣⲟⲛⲟⲥ:","cop_lat":"khen etkha-e enni-ekhronos:","en":"but call on him saying,","ar":"لكن أصرخ نحوه،"}},{"id":"t1783-22","text":{"cop":"ⲁⲗⲗⲁ ⲱϣ ⲉ̀ⲃⲟⲗ ⲛⲁϩⲣⲁϥ:","cop_lat":"alla osh evol nahraf:","en":"‘Lazarus rise","ar":"قائلاً قم وتعال"}},{"id":"t1783-23","text":{"cop":"ϫⲉ ⲧⲱⲛⲕ ⲁ̀ⲙⲟⲩ Ⲗⲁⲍⲁⲣⲟⲥ.","cop_lat":"je tonk amou Lazaros.","en":"and come forth.’","ar":"يا لعازر."}},{"id":"t1783-24","text":{"cop":"+ Ⲏⲡⲡⲉ ⲁ̀ⲛⲟⲕ ϯⲛⲁϩϯ:","cop_lat":"+ Eeppe anok tinahti:","en":"+ I believe that You are,","ar":"+ ها أنا أومن،"}},{"id":"t1783-25","text":{"cop":"ϫⲉ ⲛ̀ⲑⲟⲕ ⲡⲉ Ⲡⲓⲁ̀ⲭⲱⲣⲓⲧⲟⲥ:","cop_lat":"je enthok pe Pi-akhoritos:","en":"the Infinite One,","ar":"أنك أنت هو الغير المُحوَى،"}},{"id":"t1783-26","text":{"cop":"ⲉ̀ⲟⲩⲟⲛ ϣ̀ϫⲟⲙ ⲙ̀ⲙⲟⲕ ⲉⲕⲉ̀ⲙⲟⲩϯ:","cop_lat":"eowon eshgom emmok ekemouti:","en":"and You can call on him saying,","ar":"وتقدر أن تدعوه قائلاً،"}},{"id":"t1783-27","text":{"cop":"ϫⲉ ⲧⲱⲛⲕ ⲁ̀ⲙⲟⲩ Ⲗⲁⲍⲁⲣⲟⲥ.","cop_lat":"je tonk amou Lazaros.","en":"‘Lazarus rise","ar":"قم وتعال"}},{"id":"t1783-28","text":{"cop":"+ Ⲑⲱⲕ ⲧⲉ ϯϫⲟⲙ ⲛⲉⲙ ⲡⲓϩⲱⲥ ⲉ̀ⲣⲟⲕ:","cop_lat":"+ Thok te tigom nem pihos erok:","en":"and come forth.’” + To You is glory and praise,","ar":"يا لعازر.\" + لك المجد والتسبيح،"}},{"id":"t1783-29","text":{"cop":"ⲱ̀ Ⲡⲓⲙⲁⲓⲣⲱⲙⲓ ⲛ̀ⲁ̀ⲅⲁⲑⲟⲥ:","cop_lat":"o Pimairomi enaghathos:","en":"O good Lover of Mankind,","ar":"يا محب البشر الصالح،"}},{"id":"t1783-30","text":{"cop":"ⲙⲁⲧⲟⲩⲛⲟⲥⲧⲉⲛ ϧⲉⲛ ⲧⲉⲕϫⲟⲙ:","cop_lat":"matounosten khen tekgom:","en":"with Your power raise us,","ar":"أقِمنا بقوتك،"}},{"id":"t1783-31","text":{"cop":"ⲙ̀ⲫ̀ⲣⲏϯ ⲙ̀ⲡⲓⲑ̀ⲙⲏⲓ Ⲗⲁⲍⲁⲣⲟⲥ.","cop_lat":"emefreeti empi-ethmee Lazaros.","en":"like Lazarus the just.","ar":"مثل لعازر البار."}},{"id":"t1783-32","text":{"cop":"Ⲓ̀ⲧⲁ ⲙⲉⲛⲉⲛⲥⲁ ⲛⲁⲓ ⲁⲥⲕⲟⲧⲥ:","cop_lat":"Ita menensa nai askots:","en":"Afterward she came back,","ar":"وبعد هذا لما رجعت،"}},{"id":"t1783-33","text":{"cop":"ϣⲁ ⲧⲉⲥⲥⲱⲛⲓ ⲉⲥϫⲱ ⲙ̀ⲙⲟⲥ:","cop_lat":"sha tessoni esgo emmos:","en":"to her sister saying,","ar":"إلي أختها قائلة،"}},{"id":"t1783-34","text":{"cop":"ϫⲉ Ⲡⲉⲛⲣⲉϥϯⲥ̀ⲃⲱ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ:","cop_lat":"je Penrefti-esvo Pi-ekhristos:","en":"“Christ our Teacher has come,","ar":"\"إن مُعلمنا المسيح قد جاء،"}},{"id":"t1783-35","text":{"cop":"ⲁϥⲓ̀ ⲉ̀ϯⲛⲟⲙϯ ⲛⲁⲛ ϧⲉⲛ Ⲗⲁⲍⲁⲣⲟⲥ.","cop_lat":"afi etinomti nan khen Lazaros.","en":"to comfort us for Lazarus.","ar":"ليعزينا في لعازر."}},{"id":"t1783-36","text":{"cop":"Ⲕⲉ ⲡⲁⲗⲓⲛ ϥ̀ⲙⲟⲩϯ ⲉ̀ⲣⲟ:","cop_lat":"Ke palin efmouti ero:","en":"He is also calling you,","ar":"وهو أيضاً يدعوكِ،"}},{"id":"t1783-37","text":{"cop":"ⲧⲱⲛⲓ ⲛ̀ⲧⲉⲛϣⲉ ⲛⲁⲛ ϩⲁⲣⲟϥ:","cop_lat":"toni entenshe nan harof:","en":"rise and let us go to Him,","ar":"قومي لنذهب إليه،"}},{"id":"t1783-38","text":{"cop":"ⲟⲩⲟϩ ⲛ̀ⲧⲉⲛⲟⲩⲱϣⲧ ⲙ̀ⲡⲉϥⲙ̀ⲑⲟ:","cop_lat":"o-woh entenowosht empefemtho:","en":"worship before Him,","ar":"ونسجد أمامه،"}},{"id":"t1783-39","text":{"cop":"ϩⲓⲛⲁ ⲛ̀ⲧⲉϥⲧⲟⲩⲛⲟⲥ ⲛ̀Ⲗⲁⲍⲁⲣⲟⲥ.","cop_lat":"hina enteftounos enlazaros.","en":"that He may raise Lazarus.”","ar":"لكي يقيم لعازر.\""}},{"id":"t1783-40","text":{"cop":"+ Ⲗⲉⲅⲱⲛ ⲁⲥⲓ̀ ⲉ̀ⲃⲟⲗ ϩⲁⲣⲟϥ:","cop_lat":"+ Leghon asi evol harof:","en":"+ So she came to Him quickly,","ar":"+ فخرجت إليه مسرعة،"}},{"id":"t1783-41","text":{"cop":"ⲛⲉⲙ Ⲛⲓⲓⲟⲩⲇⲁⲓ ⲉⲩⲙⲟϣⲓ ⲛ̀ⲥⲱⲥ:","cop_lat":"nem Nioudai evmoshi ensos:","en":"and the Jews followed her,","ar":"واليهود يتبعوها،"}},{"id":"t1783-42","text":{"cop":"ⲛⲏⲉ̀ⲧⲁⲩⲑⲱⲟⲩϯ ⲛ̀ⲧⲟⲩϯ ⲛⲟⲙϯ ⲛⲱⲟⲩ:","cop_lat":"nee-etavthoouti entouti nomti noou:","en":"who gathered there to comfort them,","ar":"الذين أجتمعوا ليعزوهما،"}},{"id":"t1783-43","text":{"cop":"ϧⲉⲛ ⲡⲟⲩⲥⲟⲛ Ⲗⲁⲍⲁⲣⲟⲥ.","cop_lat":"khen pouson Lazaros.","en":"for their brother Lazarus.","ar":"في أخيهما لعازر."}},{"id":"t1783-44","text":{"cop":"+ Ⲙⲁⲣⲓⲁ ⲇⲉ ⲁⲥϩⲓⲧⲥ ⲉ̀ϧ̀ⲣⲏⲓ:","cop_lat":"+ Maria the ashits e-ekhree:","en":"+ Mary bowed and wept,","ar":"+ فخرَّت مريم،"}},{"id":"t1783-45","text":{"cop":"ⲥⲁⲡⲉⲥⲏⲧ ⲛ̀ⲛⲉⲛϭⲁⲗⲁⲩϫ ⲙ̀Ⲡ̀ϭⲟⲓⲥ:","cop_lat":"sapeseet ennenchalavg emepshois:","en":"under the feet of the Lord,","ar":"تحت قدمي الرب،"}},{"id":"t1783-46","text":{"cop":"ϫⲉ ⲁ̀ⲛⲁⲩ ⲉ̀ⲣⲟⲓ ⲟⲩⲟϩ ⲛⲁⲓ ⲛⲏⲓ:","cop_lat":"je anav eroi o-woh nai nee:","en":"saying “Look and have mercy on me,","ar":"قائلة \"أنظر إليَّ وأرحمني،"}},{"id":"t1783-47","text":{"cop":"ⲕⲁⲧⲁ ⲧⲉⲕⲙⲉⲧⲁ̀ⲅⲁⲑⲟⲥ.","cop_lat":"kata tekmetaghathos.","en":"according to Your goodness.”","ar":"كصلاحك.\""}},{"id":"t1783-48","text":{"cop":"Ⲛⲓⲙ ⲉⲧⲟ̀ⲛⲓ ⲙ̀ⲙⲟⲕ ϧⲉⲛ ⲛⲓⲛⲟⲩϯ:","cop_lat":"Nim etoni emmok khen ninoti:","en":"Who is like You among the gods,","ar":"مَنْ يشبهك في الآلهة،"}},{"id":"t1783-49","text":{"cop":"ⲱ̀ Ⲡⲉⲛⲥⲱⲧⲏⲣ ⲛ̀ⲁ̀ⲅⲁⲑⲟⲥ:","cop_lat":"o Pensoteer enaghathos:","en":"O our good Savior,","ar":"يا مخلصنا الصالح،"}},{"id":"t1783-50","text":{"cop":"ⲛ̀ⲑⲟⲕ ϧⲉⲛ ⲧ̀ϫⲟⲙ ⲛ̀ⲧⲉⲕⲙⲉⲑⲛⲟⲩϯ:","cop_lat":"enthok khen etgom entekmethnoti:","en":"with the power of Your divinity,","ar":"أنت بقوة لاهوتك،"}},{"id":"t1783-51","text":{"cop":"ⲁⲕⲧⲟⲩⲛⲟⲥ ⲙ̀ⲡⲓⲑ̀ⲙⲏⲓ Ⲗⲁⲍⲁⲣⲟⲥ.","cop_lat":"aktounos empi-ethmee Lazaros.","en":"You raised Lazarus the just.","ar":"أقمت لعازر البار."}},{"id":"t1783-52","text":{"cop":"Ⲝⲉⲣⲓⲧⲟⲥ ⲉ̀ⲧⲁϥⲛⲁⲩ ⲉ̀ⲣⲱⲟⲩ:","cop_lat":"Kseritos etafnav eroou:","en":"When our Lord Jesus,","ar":"فلما رأي ربنا يسوع،"}},{"id":"t1783-53","text":{"cop":"ⲁⲩⲣⲓⲙⲓ ⲛ̀ϫⲉ Ⲡⲉⲛϭⲟⲓⲥ Ⲓⲏⲥⲟⲩⲥ:","cop_lat":"avrimi enje Penshois Ieesous:","en":"saw everyone weeping,","ar":"الجموع يبكون،"}},{"id":"t1783-54","text":{"cop":"ⲁϥϥⲓⲁ̀ϩⲟⲙ ϧⲉⲛ ⲡⲓⲡ̀ⲛⲉⲩⲙⲁ:","cop_lat":"affi-ahom khen pi-epnevma:","en":"He sighed in the spirit,","ar":"تنهد بالروح،"}},{"id":"t1783-55","text":{"cop":"ϫⲉ ⲧⲱⲛⲕ ⲁ̀ⲙⲟⲩ Ⲗⲁⲍⲁⲣⲟⲥ.","cop_lat":"je tonk amou Lazaros.","en":"“Lazarus rise and come forth.”","ar":"\"لعازر قم وتعال.\""}},{"id":"t1783-56","text":{"cop":"+ Ⲟⲩⲟϩ ⲁϥⲕⲓⲙ ⲛ̀ϧ̀ⲣⲏⲓ ⲛ̀ϧⲏⲧϥ:","cop_lat":"+ O-woh afkim enekhree enkheetf:","en":"+ And His soul was troubled,","ar":"+ وأنزعج في نفسه،"}},{"id":"t1783-57","text":{"cop":"ⲉϥⲱϣ ⲉ̀ⲃⲟⲗ ⲉϥϫⲱ ⲙ̀ⲙⲟⲥ:","cop_lat":"efosh evol efgo emmos:","en":"He cried out saying,","ar":"وصرخ قائلاً،"}},{"id":"t1783-58","text":{"cop":"ⲡⲓⲙⲁ ⲁϥⲑⲱⲛ ⲉⲧⲭⲏ ⲛ̀ϧⲏⲧϥ:","cop_lat":"pima afthon etkee enkheetf:","en":"“Where was he laid,","ar":"\"أين المكان الذي"}},{"id":"t1783-59","text":{"cop":"ⲡⲓⲙⲉⲛⲣⲓⲧ Ⲗⲁⲍⲁⲣⲟⲥ.","cop_lat":"pimenrit Lazaros.","en":"Lazarus the beloved.” + They told Him “Come O Lord,","ar":"وُضِع فيه،"}},{"id":"t1783-60","text":{"cop":"+ Ⲡⲉϫⲱⲟⲩ ⲛⲁϥ ϫⲉ Ⲡ̀ϭⲟⲓⲥ:","cop_lat":"+ Pegoou naf je Epshois:","en":"and see him,” Jesus’ eyes broke","ar":"الحبيب لعازر.\" + قالوا له \"يا رب،"}},{"id":"t1783-61","text":{"cop":"ⲁ̀ⲙⲟⲩ ⲟⲩⲟϩ ⲁ̀ⲛⲁⲩ ⲉ̀ⲣⲟϥ:","cop_lat":"amou o-woh anav erof:","en":"in tears,","ar":"تعال وأنظر إليه،\""}},{"id":"t1783-62","text":{"cop":"Ⲓⲏⲥⲟⲩⲥ ⲟⲛ ⲁ̀ ⲛⲉϥⲃⲁⲗ ϯⲉⲣⲙⲏ:","cop_lat":"Ieesous on a nefval tiermee:","en":"Lazarus rise","ar":"فأدمعت عينا يسوع،"}},{"id":"t1783-63","text":{"cop":"ϫⲉ ⲧⲱⲛⲕ ⲁ̀ⲙⲟⲩ Ⲗⲁⲍⲁⲣⲟⲥ.","cop_lat":"je tonk amou Lazaros.","en":"and come forth.","ar":"لعازر قم وتعال."}},{"id":"t1783-64","text":{"cop":"Ⲣⲏⲧⲟⲥ ⲁϥϣⲉⲛⲁϥ ⲛⲉⲙⲱⲟⲩ:","cop_lat":"Reetos afshenaf nemoou:","en":"Therefore He went with them,","ar":"حينئذ ذهب معهم،"}},{"id":"t1783-65","text":{"cop":"ⲛⲁϥⲭⲏ ⲡⲓⲙ̀ϩⲁⲩ ϩⲱⲥ ⲥ̀ⲡⲉⲗⲉⲟⲛ:","cop_lat":"nafkee pi-emhav hos espeleon:","en":"to the tomb that was a cave,","ar":"وكان القبر مغارة،"}},{"id":"t1783-66","text":{"cop":"ⲛⲉⲙ ⲟⲩⲱ̀ⲛⲓ ⲉ̀ϩ̀ⲣⲏⲓ ⲉ̀ϫⲱϥ:","cop_lat":"nem o-oni e-ehree egof:","en":"and a rock was placed on it,","ar":"ووُضُع عليه حجر،"}},{"id":"t1783-67","text":{"cop":"ϫⲉ ⲧⲱⲛⲕ ⲁ̀ⲙⲟⲩ Ⲗⲁⲍⲁⲣⲟⲥ.","cop_lat":"je tonk amou Lazaros.","en":"Lazarus rise and come forth.","ar":"لعازر قم وتعال."}},{"id":"t1783-68","text":{"cop":"Ⲥⲉ ⲟⲛⲧⲟⲥ ⲱ̀ Ⲡⲓⲣⲉϥϣⲉⲛϩⲏⲧ:","cop_lat":"Se ontos o Pirefshenheet:","en":"Yea indeed O Compassionate,","ar":"نعم نعم أيها الرؤوف،"}},{"id":"t1783-69","text":{"cop":"ⲡⲉϫⲁⲕ ϫⲉ ⲥⲱⲕ ⲙ̀ⲡⲁⲓⲱ̀ⲛⲓ ⲕⲁⲗⲱⲥ:","cop_lat":"pegak je sok empai-oni kalos:","en":"You said “Remove the rock,","ar":"قُلت \"إرفعوا الحجر جيداً،"}},{"id":"t1783-70","text":{"cop":"ⲉ̀ⲃⲟⲗ ϩⲓⲣⲟϥ ⲙ̀ⲡⲓⲙ̀ϩⲁⲩ:","cop_lat":"evol hirof empi-emhav:","en":"from the opening","ar":"عن فم القبر،\" لعازر قم"}},{"id":"t1783-71","text":{"cop":"ϫⲉ ⲧⲱⲛⲕ ⲁ̀ⲙⲟⲩ Ⲗⲁⲍⲁⲣⲟⲥ.","cop_lat":"je tonk amou Lazaros.","en":"of the tomb,” Lazarus rise and come forth.","ar":"وتعال."}},{"id":"t1783-72","text":{"cop":"+ Ⲧⲟⲧⲉ Ⲙⲁⲣⲑⲁ ⲡⲉϫⲁⲥ ⲛⲁϥ:","cop_lat":"+ Tote Martha pegas naf:","en":"+ Therefore Martha spoke to Him,","ar":"+ حينئذ قالت له مرثا،"}},{"id":"t1783-73","text":{"cop":"ϫⲉ ϩⲏⲡⲡⲉ ⲓⲥ ⲛ̀ⲑⲟϥ ⲁϥⲭⲱⲛⲥ:","cop_lat":"je heeppe is enthof afkons:","en":"“Behold he is decomposed,","ar":"\"هوذا قد أنتن،"}},{"id":"t1783-74","text":{"cop":"ϫⲉ ϥ̀ⲧⲟⲟⲩ ⲛ̀ⲉ̀ϩⲟⲟⲩ ⲛ̀ⲧⲁϥ:","cop_lat":"je eftoou enehoou entaf:","en":"for he has been there","ar":"لأن له أربعة أيام،\" لعازر قم"}},{"id":"t1783-75","text":{"cop":"ϫⲉ ⲧⲱⲛⲕ ⲁ̀ⲙⲟⲩ Ⲗⲁⲍⲁⲣⲟⲥ.","cop_lat":"je tonk amou Lazaros.","en":"for four days,” Lazarus rise and come forth.","ar":"وتعال."}},{"id":"t1783-76","text":{"cop":"+ Ⲩⲡⲡⲉ Ⲓⲏⲥⲟⲩⲥ Ⲡⲓⲇⲩⲙⲓⲟⲩⲣⲅⲟⲥ:","cop_lat":"+ Ippe Ieesous Pithimiourghos:","en":"+ Behold Jesus the Creator,","ar":"+ هوذا يسوع الخالق،"}},{"id":"t1783-77","text":{"cop":"ⲫⲏⲉⲧⲧⲁⲛϧⲟ ⲛ̀ⲛⲓⲣⲉϥ-ⲙⲱⲟⲩⲧ:","cop_lat":"fee-ettankho enniref-moout:","en":"the Reviver of the dead,","ar":"المحيي الأموات،"}},{"id":"t1783-78","text":{"cop":"ⲁϥⲱϣ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲟⲩⲛⲓϣϯ ⲛ̀ⲥ̀ⲙⲏ:","cop_lat":"afosh evol khen ounishti enesmee:","en":"proclaimed in a great voice,","ar":"صرخ بصوت عظيم،"}},{"id":"t1783-79","text":{"cop":"ϫⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲁ̀ⲙⲟⲩ ⲉ̀ⲃⲟⲗ.","cop_lat":"je Lazaros amou evol.","en":"saying “Lazarus come forth.”","ar":"قائلاً \"لعازر هلم خارجاً.\""}},{"id":"t1783-80","text":{"cop":"Ⲫⲱⲕ ⲡⲉ ⲡⲓⲱ̀ⲟⲩ ⲛⲉⲙ ⲡⲓϩⲩⲙⲛⲟⲥ:","cop_lat":"Fok pe pi-oou nem pihimnos:","en":"To You is glory and chanting,","ar":"لك المجد"}},{"id":"t1783-81","text":{"cop":"ⲛ̀ⲑⲟⲕ ⲡⲉ ⲫⲏⲉⲧⲙⲏⲛ ⲉ̀ⲃⲟⲗ:","cop_lat":"enthok pe fee-etmeen evol:","en":"for You are eternal,","ar":"والترتيل،"}},{"id":"t1783-82","text":{"cop":"ⲧⲉⲛⲱϣ ⲉ̀ⲃⲟⲗ ϫⲉ ⲫⲏⲉ̀ⲧⲁϥϫⲟⲥ:","cop_lat":"tenosh evol je fee-etafgos:","en":"we proclaim to Him","ar":"لأنك أنت هو الدائم،"}},{"id":"t1783-83","text":{"cop":"ϫⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲁ̀ⲙⲟⲩ ⲉ̀ⲃⲟⲗ.","cop_lat":"je Lazaros amou evol.","en":"who have said,","ar":"نصرخ إلى الذي قال،"}},{"id":"t1783-84","text":{"cop":"Ⲭⲱ ⲛⲁⲛ ⲉ̀ⲃⲟⲗ ⲛ̀ⲛⲉⲛⲁ̀ⲛⲟⲙⲓⲁ:","cop_lat":"Ko nan evol ennenanomia:","en":"“Lazarus come forth.” Forgive us our iniquities,","ar":"\"لعازر هلم خارجاً.\" إغفر لنا آثامنا،"}},{"id":"t1783-85","text":{"cop":"ⲟⲩⲟϩ ⲙⲟⲓ ⲛⲁⲛ ⲛ̀ⲟⲩⲥⲱⲧⲏⲣⲓⲁ:","cop_lat":"o-woh moi nan enousoteeria:","en":"grant us salvation,","ar":"وأعطنا خلاصاً،"}},{"id":"t1783-86","text":{"cop":"ϩⲓⲧⲉⲛ ⲛⲓⲧⲱⲃϩ ⲛⲉⲙ ⲛⲓⲡ̀ⲣⲉⲥⲃⲓⲁ:","cop_lat":"hiten nitovh nem ni-epresvia:","en":"through the prayers and intercessions,","ar":"بطلبات وشفاعات،"}},{"id":"t1783-87","text":{"cop":"ⲛ̀ⲧⲉ ⲧⲉⲛϭⲟⲓⲥ ⲛ̀ⲛⲏⲃ Ⲙⲁⲣⲓⲁ.","cop_lat":"ente tenshois enneeb Maria.","en":"of the Lady of us all Mary.","ar":"سيدتنا السيدة مريم."}},{"id":"t1783-88","text":{"cop":"+ Ⲯⲱⲧⲏⲣ ⲙ̀ⲡⲓⲕⲟⲥⲙⲟⲥ ⲧⲏⲣϥ:","cop_lat":"+ Psoteer empikosmos teerf:","en":"+ O Savior of the whole world,","ar":"+ يا مخلص العالم كله،"}},{"id":"t1783-89","text":{"cop":"Ⲡⲉⲛⲛⲟⲩϯ ⲛ̀ⲁ̀ⲗⲏⲑⲓⲛⲟⲛ:","cop_lat":"Pennoti enaleethinon:","en":"our true God,","ar":"إلهنا الحقيقي،"}},{"id":"t1783-90","text":{"cop":"ⲧⲉⲛⲛⲁϩϯ ϧⲉⲛ ⲡⲉⲛϩⲏⲧ ⲧⲏⲣϥ:","cop_lat":"tennahti khen penheet teerf:","en":"we believe with all our hearts,","ar":"نؤمن بكل قلوبنا،"}},{"id":"t1783-91","text":{"cop":"ϫⲉ ⲛ̀ⲑⲟⲕ ⲡⲉ Ⲡ̀ⲟⲩⲣⲟ ⲟⲛ.","cop_lat":"je enthok pe Epouro on.","en":"for You are the King also.","ar":"أنك أنت هو الملك أيضاً."}},{"id":"t1783-92","text":{"cop":"+ Ⲱ̀ ⲫⲏⲉ̀ⲧⲁϥⲧⲟⲩⲛⲟⲥ ⲛ̀Ⲗⲁⲍⲁⲣⲟⲥ:","cop_lat":"+ O fee-etaftounos enlazaros:","en":"+ O You who raised Lazarus,","ar":"+ يا مَنْ أقام لعازر،"}},{"id":"t1783-93","text":{"cop":"ⲁ̀ⲛⲟⲕ ⲡⲉⲕⲃⲱⲕ ⲡⲓⲉ̀ⲗⲁⲭⲓⲥⲧⲟⲥ:","cop_lat":"anok pekvok pi-elashistos:","en":"I am Your poor servant,","ar":"أنا عبدك الحقير،"}},{"id":"t1783-94","text":{"cop":"ⲙⲟⲓ ⲛⲏⲓ ⲛ̀ⲟⲩⲙⲉⲣⲟⲥ ⲛⲉⲙ ⲟⲩⲕ̀ⲗⲏⲣⲟⲥ:","cop_lat":"moi nee enoumeros nem ou-ekleeros:","en":"grant me a share and an inheritance,","ar":"أعطني نصيباً وميراثاً،"}},{"id":"t1783-95","text":{"cop":"ⲛⲉⲙ ⲡⲉⲕⲙⲉⲛⲣⲓⲧ Ⲗⲁⲍⲁⲣⲟⲥ.","cop_lat":"nem pekmenrit Lazaros.","en":"with Your beloved Lazarus.","ar":"مع حبيبك لعازر."}},{"id":"t1680-1","text":{"cop":"Ⲭⲉⲣⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲫⲏⲉ̀ⲧⲁϥⲧⲟⲩⲛⲟⲥϥ:","cop_lat":"Shere Lazaros fee-etaftounosf:","en":"Hail to Lazarus whom He raised,","ar":"السلام للعازر الذي أقامه،"},"section":{"en":"The Verses of Cymbals, Ⲭⲉⲣⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲫⲏⲉ̀ⲧⲁϥⲧⲱⲛⲟⲥϥ","path":"Fasts › Lazarus Saturday"}},{"id":"t1680-2","text":{"cop":"ⲙⲉⲛⲉⲛⲥⲁ ϥ̀ⲧⲟⲟⲩ ⲛ̀ⲉ̀ϩⲟⲟⲩ:","cop_lat":"menensa eftoou enehoou:","en":"after four days,","ar":"بعد أربعة أيام،"}},{"id":"t1680-3","text":{"cop":"ⲙⲁⲧⲟⲩⲛⲟⲥ ⲡⲁϩⲏⲧ Ⲡⲁϭⲟⲓⲥ Ⲓⲏⲥⲟⲩⲥ:","cop_lat":"matounos paheet Pashois Ieesous:","en":"raise my heart O my Lord Jesus,","ar":"أقم قلبي يا ربي يسوع،"}},{"id":"t1680-4","text":{"cop":"ⲫⲏⲉ̀ⲧⲁϥϧⲟⲑⲃⲉϥ ⲛ̀ϫⲉ ⲡⲓⲡⲉⲧϩⲱⲟⲩ.","cop_lat":"fee-etafkhothvef enje pipethoou.","en":"that was killed by the evil one.","ar":"الذي قتله الشرير."}},{"id":"t1681-1","text":{"cop":"Ⲗⲁⲍⲁⲣⲟⲥ ⲡⲓⲉ̀ⲡⲓⲥⲕⲟⲡⲟⲥ:","cop_lat":"Lazaros pi-episkopos:","en":"Lazarus the bishop,","ar":"لعازر الأسقف،"},"section":{"en":"The Doxology, Ⲗⲁⲍⲁⲣⲟⲥ ⲡⲓⲉ̀ⲡⲓⲥⲕⲟⲡⲟⲥ","path":"Fasts › Lazarus Saturday"}},{"id":"t1681-2","text":{"cop":"ⲡⲓⲙⲉⲛⲣⲓⲧ ⲛ̀ⲧⲉ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ:","cop_lat":"pimenrit ente Pi-ekhristos:","en":"the beloved of Christ,","ar":"حبيب المسيح،"}},{"id":"t1681-3","text":{"cop":"ⲫⲏⲉ̀ⲧⲁϥⲧⲟⲩⲛⲟⲥϥ ϧⲉⲛ ⲛⲏⲉⲑⲙⲱⲟⲩⲧ:","cop_lat":"fee-etaftounosf khen nee-ethmoout:","en":"who was risen from the dead,","ar":"الذي أقامه من الأموات،"}},{"id":"t1681-4","text":{"cop":"ⲙⲉⲛⲉⲛⲥⲁ ⲡⲓϥ̀ⲧⲟⲟⲩ ⲛ̀ⲉ̀ϩⲟⲟⲩ.","cop_lat":"menensa pi-eftoou enehoou.","en":"after four days.","ar":"بعد أربعة أيام."}},{"id":"t1681-5","text":{"cop":"+ Ⲟⲩⲟϩ ⲁϥⲱⲛϧ ⲛ̀ϩ̀ⲙⲉ ⲛ̀ⲣⲟⲙⲡⲓ:","cop_lat":"+ O-woh afonkh enehme enrompi:","en":"+ And he lived for forty years,","ar":"+ وعاش أربعين سنة،"}},{"id":"t1681-6","text":{"cop":"ⲟⲩⲟϩ ⲁϥϣⲱⲡⲓ ⲛ̀ⲟⲩⲉ̀ⲡⲓⲥⲕⲟⲡⲟⲥ:","cop_lat":"o-woh afshopi enowepiskopos:","en":"and became a bishop,","ar":"وصار أسقفاً،"}},{"id":"t1681-7","text":{"cop":"ϩⲓϫⲉⲛ ⲡⲓⲑ̀ⲣⲟⲛⲟⲥ ⲛ̀ⲧⲉ Ⲕⲁϥⲁ̀ⲙⲟⲛⲓ ⲛⲓⲟ̀ϩⲓ ⲛ̀ⲧⲉ Ⲡⲭ̅ⲥ̅.","cop_lat":"hijen pi-ethronos ente Kafamoni ni-ohi ente Pi-ekhristos.","en":"on the throne of Cyprus, and tended the flock of Christ","ar":"علي كرسي قبرص، ورعى قطيع للمسيح."}},{"id":"t1681-8","text":{"cop":"Ⲱ̀ⲟⲩⲛⲓⲁⲧⲕ ⲡⲉⲛⲓⲱⲧ ⲉⲑⲟⲩⲁⲃ:","cop_lat":"Oouniatk peniot ethowab:","en":"Blessed are you O our holy father,","ar":"طوباك يا أبانا القديس،"}},{"id":"t1681-9","text":{"cop":"Ⲗⲁⲍⲁⲣⲟⲥ ⲡⲓⲉ̀ⲡⲓⲥⲕⲟⲡⲟⲥ:","cop_lat":"Lazaros pi-episkopos:","en":"Lazarus the bishop,","ar":"لعازر الأسقف،"}},{"id":"t1681-10","text":{"cop":"ϫⲉ ⲁⲕⲉⲣⲡ̀ⲉⲙⲡ̀ϣⲁ ⲛ̀ⲧ̀ⲥ̀ⲙⲏ ⲛ̀ⲧⲉ Ⲓⲏⲥⲟⲩⲥ:","cop_lat":"je akerepemepsha enetesmee ente Ieesous:","en":"for you were worthy to hear Jesus’ voice,","ar":"لأنك إستحققت صوت يسوع،"}},{"id":"t1681-11","text":{"cop":"Ⲫ̀ⲛⲟⲩϯ ⲛ̀ⲛⲏⲉⲧⲟⲛϧ ⲛⲉⲙ ⲛⲓⲣⲉϥⲙⲱⲟⲩⲧ.","cop_lat":"Efnoti ennee-etonkh nem nirefmoout.","en":"the God of the living and the dead.","ar":"إله الأحياء والأموات."}},{"id":"t1681-12","text":{"cop":"+ Ⲣⲁϣⲓ Ⲗⲁⲍⲁⲣⲟⲥ ⲡⲓⲙⲉⲛⲣⲓⲧ:","cop_lat":"+ Rashi Lazaros pimenrit:","en":"+ Rejoice O Lazarus the beloved,","ar":"+ إفرح يا لعازر الحبيب،"}},{"id":"t1681-13","text":{"cop":"ϫⲉ ⲁⲕⲉⲙⲡ̀ϣⲁ ⲛ̀ϯⲙⲉⲧⲉ̀ⲡⲓⲥⲕⲟⲡⲟⲥ:","cop_lat":"je akemepsha entimetepiskopos:","en":"for you were worthy of the episcopate,","ar":"لأنك إستحققت الأسقفية،"}},{"id":"t1681-14","text":{"cop":"ⲁⲕⲁ̀ⲙⲟⲛⲓ ⲛ̀ⲛⲓⲉ̀ⲥⲱⲟⲩ:","cop_lat":"akamoni enni-esoou:","en":"you tended the sheep,","ar":"ورعيت الخراف،"}},{"id":"t1681-15","text":{"cop":"ⲱ̀ ⲡⲓⲛⲓϣϯ ⲙ̀ⲙⲁⲛⲉ̀ⲥⲱⲟⲩ.","cop_lat":"o pinishti emmanesoou.","en":"O great shepherd.","ar":"أيها الراعي العظيم."}},{"id":"t1681-16","text":{"cop":"Ⲧⲉⲛⲧⲱⲃϩ ⲙ̀ⲙⲟⲕ ⲱ̀ ⲡⲁⲧⲏⲣ ⲩ̀ⲙⲱⲛ:","cop_lat":"Tentovh emmok o pateer imon:","en":"We entreat you O our father,","ar":"نطلب إليك يا أبانا،"}},{"id":"t1681-17","text":{"cop":"ⲛ̀ⲧⲉⲕⲉⲣⲡ̀ⲣⲉⲥⲃⲉⲩⲓⲛ ⲉ̀ϫⲱⲛ:","cop_lat":"entekerepresvevin egon:","en":"to intercede on our behalf,","ar":"لكي تشفع فينا،"}},{"id":"t1681-18","text":{"cop":"ⲛⲁϩⲣⲉⲛ Ⲡⲭ̅ⲥ̅ ⲫⲏⲉ̀ⲧⲁϥⲙⲉⲛⲣⲓⲧⲕ:","cop_lat":"nahren Pi-ekhristos fee-etafmenritk:","en":"before Christ who has loved you,","ar":"أمام المسيح الذي أحبك،"}},{"id":"t1681-19","text":{"cop":"ⲟⲩⲟϩ ⲁϥⲧⲟⲩⲛⲟⲥⲕ ϧⲉⲛ ⲛⲏⲉⲑⲙⲱⲟⲩⲧ.","cop_lat":"o-woh aftounosk khen nee-ethmoout.","en":"and raised you from the dead.","ar":"وأقامك من الأموات."}},{"id":"t1681-20","text":{"cop":"+ Ⲧⲱⲃϩ ⲙ̀Ⲡ̀ϭⲟⲓⲥ ⲉ̀ϩ̀ⲣⲏⲓ ⲉ̀ϫⲱⲛ:","cop_lat":"+ Tovh emepshois e-ehree egon:","en":"+ Pray to the Lord on our behalf,","ar":"+ أطلب من الرب عنا،"}},{"id":"t1681-21","text":{"cop":"ⲱ̀ ⲡⲓⲙⲁⲛⲉ̀ⲥⲱⲟⲩ ⲛ̀ⲧⲉ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ:","cop_lat":"o pimanesoou ente Pi-ekhristos:","en":"O shepherd of Christ,","ar":"أيها الراعي الذي للمسيح،"}},{"id":"t1681-22","text":{"cop":"Ⲗⲁⲍⲁⲣⲟⲥ ⲡⲓⲉ̀ⲡⲓⲥⲕⲟⲡⲟⲥ:","cop_lat":"Lazaros pi-episkopos:","en":"Lazarus the bishop,","ar":"لعازر الأسقف،"}},{"id":"t1681-23","text":{"cop":"ⲛ̀ⲧⲉϥⲭⲁ ⲛⲉⲛⲛⲟⲃⲓ ⲛⲁⲛ ⲉ̀ⲃⲟⲗ.","cop_lat":"entefka nennovi nan evol.","en":"that He may forgive us our sins.","ar":"ليغفر لنا خطايانا."}},{"id":"t1682-0","text":{"cop":"Ⲍⲉⲱϣ ⲛ̀ⲧⲉ ϩⲁⲛϣ̀ⲫⲏⲣⲓ:","cop_lat":"Zeosh ente haneshfeeri:","en":"Many are the wonders,","ar":"كثيرة الأعاجيب،"},"section":{"en":"Matins Gospel Response, Ⲍⲉⲱϣ ⲛ̀ⲧⲉ ϩⲁⲛϣ̀ⲫⲏⲣⲓ","path":"Fasts › Lazarus Saturday"}},{"id":"t1682-1","text":{"cop":"ⲛⲏⲉ̀ⲧⲁⲩⲓ̀ⲣⲓ ⲙ̀ⲙⲱⲟⲩ:","cop_lat":"nee-etaviri emmoou:","en":"which were performed,","ar":"التي صنعها،"}},{"id":"t1682-2","text":{"cop":"ϯⲛⲁϩϯ ⲉ̀ⲧⲁϥⲙⲉⲧϫⲱⲣⲓ:","cop_lat":"tinahti etafmetgori:","en":"I believe in His might,","ar":"أؤمن بجبروته،"}},{"id":"t1682-3","text":{"cop":"ϫⲉ ⲛ̀ⲑⲟϥ ⲡⲉ Ⲡ̀ⲟⲩⲣⲟ ⲛ̀ⲧⲉ ⲡ̀ⲱ̀ⲟⲩ.","cop_lat":"je enthof pe Epouro ente epoou.","en":"for He is the King of glory.","ar":"لأنه هو الملك المجد."}},{"id":"t1682-4","text":{"cop":"Ⲧⲱⲃϩ ⲙ̀Ⲡ̀ϭⲟⲓⲥ ⲉ̀ϩ̀ⲣⲏⲓ ⲉ̀ϫⲱⲛ:","cop_lat":"Tovh emepshois e-ehree egon:","en":"Pray to the Lord on our behalf,","ar":"أطلب من الرب عنا،"}},{"id":"t1682-5","text":{"cop":"ⲱ̀ ⲡⲓⲙⲁⲛⲉ̀ⲥⲱⲟⲩ ⲛ̀ⲧⲉ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ:","cop_lat":"o pimanesoou ente Pi-ekhristos:","en":"O shepherd of Christ,","ar":"أيها الراعي الذي للمسيح،"}},{"id":"t1682-6","text":{"cop":"Ⲗⲁⲍⲁⲣⲟⲥ ⲡⲓⲉ̀ⲡⲓⲥⲕⲟⲡⲟⲥ:","cop_lat":"Lazaros pi-episkopos:","en":"Lazarus the bishop,","ar":"لعازر الأسقف،"}},{"id":"t1682-7","text":{"cop":"ⲛ̀ⲧⲉϥⲭⲁ ⲛⲉⲛⲛⲟⲃⲓ ⲛⲁⲛ ⲉ̀ⲃⲟⲗ.","cop_lat":"entefka nennovi nan evol.","en":"that He may forgive us our sins.","ar":"ليغفر لنا خطايانا."}},{"id":"t1682-8","text":{"cop":"Ϫⲉ ϥ̀ⲥ̀ⲙⲁⲣⲱⲟⲩⲧ ...","cop_lat":"Je efesmaroout ...","en":"For blessed be ....","ar":"لأنه مبارك ..."}},{"id":"t1685-0","text":{"cop":"Ⲭⲉⲣⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲫⲏⲉ̀ⲧⲁϥⲧⲟⲩⲛⲟⲥϥ:","cop_lat":"Shere Lazaros fee-etaftounosf:","en":"Hail to Lazarus whom He raised,","ar":"السلام للعازر الذي أقامه،"},"section":{"en":"Liturgy Gospel Response, Ⲭⲉⲣⲉ Ⲗⲁⲍⲁⲣⲟⲥ","path":"Fasts › Lazarus Saturday"}},{"id":"t1685-1","text":{"cop":"ⲙⲉⲛⲉⲛⲥⲁ ϥ̀ⲧⲟⲟⲩ ⲛ̀ⲉ̀ϩⲟⲟⲩ:","cop_lat":"menensa eftoou enehoou:","en":"after four days,","ar":"بعد أربعة أيام،"}},{"id":"t1685-2","text":{"cop":"ⲙⲁⲧⲟⲩⲛⲟⲥ ⲡⲁϩⲏⲧ Ⲡⲁϭⲟⲓⲥ Ⲓⲏⲥⲟⲩⲥ:","cop_lat":"matounos paheet Pashois Ieesous:","en":"raise my heart O my Lord Jesus,","ar":"أقم قلبي يا ربي يسوع،"}},{"id":"t1685-3","text":{"cop":"ⲫⲏⲉ̀ⲧⲁϥϧⲟⲑⲃⲉϥ ⲛ̀ϫⲉ ⲡⲓⲡⲉⲧϩⲱⲟⲩ.","cop_lat":"fee-etafkhothvef enje pipethoou.","en":"that was killed by the evil one.","ar":"الذي قتله الشرير."}},{"id":"t1685-4","text":{"cop":"Ⲧⲱⲃϩ ⲙ̀Ⲡ̀ϭⲟⲓⲥ ⲉ̀ϩ̀ⲣⲏⲓ ⲉ̀ϫⲱⲛ:","cop_lat":"Tovh emepshois e-ehree egon:","en":"Pray to the Lord on our behalf,","ar":"أطلب من الرب عنا،"}},{"id":"t1685-5","text":{"cop":"ⲱ̀ ⲡⲓⲙⲁⲛⲉ̀ⲥⲱⲟⲩ ⲛ̀ⲧⲉ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ:","cop_lat":"o pimanesoou ente Pi-ekhristos:","en":"O shepherd of Christ,","ar":"أيها الراعي الذي للمسيح،"}},{"id":"t1685-6","text":{"cop":"Ⲗⲁⲍⲁⲣⲟⲥ ⲡⲓⲉ̀ⲡⲓⲥⲕⲟⲡⲟⲥ:","cop_lat":"Lazaros pi-episkopos:","en":"Lazarus the bishop,","ar":"لعازر الأسقف،"}},{"id":"t1685-7","text":{"cop":"ⲛ̀ⲧⲉϥⲭⲁ ⲛⲉⲛⲛⲟⲃⲓ ⲛⲁⲛ ⲉ̀ⲃⲟⲗ.","cop_lat":"entefka nennovi nan evol.","en":"that He may forgive us our sins.","ar":"ليغفر لنا خطايانا."}},{"id":"t1686-0","text":{"cop":"Ⲛⲓⲙ ⲅⲁⲣ ϧⲉⲛ ⲛⲓⲛⲟⲩϯ:","cop_lat":"Nim ghar khen ninoti:","en":"For who among the gods,","ar":"مَنْ في الآلهة،"},"section":{"en":"Adam Aspasmos, Ⲛⲓⲙ ⲅⲁⲣ ϧⲉⲛ ⲛⲓⲛⲟⲩϯ","path":"Fasts › Lazarus Saturday"}},{"id":"t1686-1","text":{"cop":"ⲉⲧⲟ̀ⲛⲓ ⲙ̀ⲙⲟⲕ Ⲡ̀ϭⲟⲓⲥ:","cop_lat":"etoni emmok Epshois:","en":"is likened unto You O Lord,","ar":"يشبهك يا رب،"}},{"id":"t1686-2","text":{"cop":"ⲛ̀ⲑⲟⲕ ⲡⲉ Ⲫ̀ⲛⲟⲩϯ ⲙ̀ⲙⲏⲓ:","cop_lat":"enthok pe Efnoti emmee:","en":"You are the true God,","ar":"أنت هو الإله الحقيقي،"}},{"id":"t1686-3","text":{"cop":"ⲉⲧⲓ̀ⲣⲓ ⲛ̀ϩⲁⲛϣ̀ⲫⲏⲣⲓ.","cop_lat":"etiri enhaneshfeeri.","en":"who performs wonders.","ar":"الصانع العجائب."}},{"id":"t1686-4","text":{"cop":"Ⲕ̀ⲥ̀ⲙⲁⲣⲱⲟⲩⲧ ⲁ̀ⲗⲏⲑⲱⲥ:","cop_lat":"Ekesmaroout aleethos:","en":"Blessed are You indeed,","ar":"مبارك أنت بالحقيقة،"}},{"id":"t1686-5","text":{"cop":"ⲱ̀ Ⲡⲁϭⲟⲓⲥ Ⲓⲏⲥⲟⲩⲥ:","cop_lat":"o Pashois Ieesous:","en":"O my Lord Jesus,","ar":"يا ربي يسوع،"}},{"id":"t1686-6","text":{"cop":"ⲛⲉⲙ Ⲡⲉⲕⲓⲱⲧ ⲛ̀ⲁ̀ⲅⲁⲑⲟⲥ:","cop_lat":"nem Pekiot enaghathos:","en":"with Your good Father,","ar":"مع أبيك الصالح،"}},{"id":"t1686-7","text":{"cop":"ⲛⲉⲙ Ⲡⲓⲡ̀ⲛⲉⲩⲙⲁ Ⲉⲑⲟⲩⲁⲃ.","cop_lat":"nem Pi-epnevma Ethowab.","en":"and the Holy Spirit.","ar":"والروح القدس."}},{"id":"t1686-8","text":{"cop":"Ϩⲓⲛⲁ ⲛ̀ⲧⲉⲛϩⲱⲥ ...","cop_lat":"Hina entenhos ...","en":"That we may praise ....","ar":"لكيْ نسبحك .."}},{"id":"t1684-0","text":{"cop":"Ⲭⲉⲣⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲫⲏⲉ̀ⲧⲁϥⲧⲟⲩⲛⲟⲥϥ:","cop_lat":"Shere Lazaros fee-etaftounosf:","en":"Hail to Lazarus whom He raised,","ar":"السلام للعازر الذي أقامه،"},"section":{"en":"Praxis Response, Ⲭⲉⲣⲉ Ⲗⲁⲍⲁⲣⲟⲥ","path":"Fasts › Lazarus Saturday"}},{"id":"t1684-1","text":{"cop":"ⲙⲉⲛⲉⲛⲥⲁ ϥ̀ⲧⲟⲟⲩ ⲛ̀ⲉ̀ϩⲟⲟⲩ:","cop_lat":"menensa eftoou enehoou:","en":"after four days,","ar":"بعد أربعة أيام،"}},{"id":"t1684-2","text":{"cop":"ⲙⲁⲧⲟⲩⲛⲟⲥ ⲡⲁϩⲏⲧ Ⲡⲁϭⲟⲓⲥ Ⲓⲏⲥⲟⲩⲥ:","cop_lat":"matounos paheet Pashois Ieesous:","en":"raise my heart O my Lord Jesus,","ar":"أقم قلبي يا ربي يسوع،"}},{"id":"t1684-3","text":{"cop":"ⲫⲏⲉ̀ⲧⲁϥϧⲟⲑⲃⲉϥ ⲛ̀ϫⲉ ⲡⲓⲡⲉⲧϩⲱⲟⲩ.","cop_lat":"fee-etafkhothvef enje pipethoou.","en":"that was killed by the evil one.","ar":"الذي قتله الشرير."}},{"id":"t1684-4","text":{"cop":"Ⲕ̀ⲥ̀ⲙⲁⲣⲱⲟⲩⲧ ...","cop_lat":"Ekesmaroout ...","en":"Blessed are You ....","ar":"مبارك ..."}},{"id":"t2642-1","text":{"cop":"Ⲱ̀ ⲫⲏⲉ̀ⲧⲁϥⲧⲟⲩⲛⲟⲥϥ ⲛ̀Ⲗⲁⲍⲁⲣⲟⲥ ϧⲉⲛ ⲛⲏⲉⲑⲙⲱⲟⲩⲧ ⲙⲉⲛⲉⲛⲥⲁ ⲡⲓϥ̀ⲧⲟⲟⲩ ⲛ̀ⲉ̀ϩⲟⲟⲩ.","cop_lat":"O fee-etaftounosf enlazaros khen nee-ethmoout menensa pi-eftoou enehoou.","en":"O You who raised Lazarus from the dead after four day.","ar":"يا مَنْ أقام لعازر من الأموات بعد أربعة أيام."},"section":{"en":"The Conclusion Response","path":"Fasts › Lazarus Saturday"}},{"id":"t2642-2","text":{"cop":"Ⲥⲱϯ ⲙ̀ⲙⲟⲛ ... -","cop_lat":"Soti emmon ... -","en":"Save us ....","ar":"خلصنا..."}},{"id":"t2642-4","text":{"cop":"Ⲅⲉⲛⲟⲥ ⲛⲓⲃⲉⲛ ⲛ̀ⲛⲓⲡⲓⲥⲧⲟⲥ ϩⲱⲥ ⲉ̀Ⲡ̀ϭⲟⲓⲥ ⲛ̀ⲧⲉ ⲛⲓϫⲟⲙ:","cop_lat":"Genos niven ennipistos hos e-epshois ente nigom:","en":"The believers from every race praise the Lord of the powers,","ar":"كل جنس المؤمنين يسبحوا رب القوات،"}},{"id":"t2642-5","text":{"cop":"ⲫⲏⲉ̀ⲧⲁϥⲧⲟⲩⲛⲟⲥϥ Ⲗⲁⲍⲁⲣⲟⲥ:","cop_lat":"fee-etaftounosf Lazaros:","en":"who raised Lazarus after his death to life.","ar":"الذي أقام لعازر بعد"}},{"id":"t2642-6","text":{"cop":"ⲙⲉⲛⲉⲛⲥⲁ ⲡⲉϥⲙⲟⲩ ⲉϥⲟⲛϧ:","cop_lat":"menensa pefmou efonkh:","en":"Let us come to worship Him,","ar":"موته إلى حياة."}},{"id":"t2642-7","text":{"cop":"ⲁ̀ⲙⲱⲓⲛⲓ ⲧⲉⲛⲟⲩⲱϣⲧ ⲙ̀ⲙⲟϥ:","cop_lat":"amoini tenowosht emmof:","en":"and confess to Him,","ar":"تعالوا نسجد،"}},{"id":"t2642-8","text":{"cop":"ⲧⲉⲛⲉⲣⲟ̀ⲙⲟⲗⲟⲅⲓⲛ ⲙ̀ⲙⲟϥ:","cop_lat":"teneromologin emmof:","en":"proclaiming and saying,","ar":"ونعترف به،"}},{"id":"t2642-9","text":{"cop":"ⲉⲛⲱϣ ⲉ̀ⲃⲟⲗ ⲙ̀ⲡⲁⲓⲣⲏϯ ⲉⲛϫⲱ ⲙ̀ⲙⲟⲥ:","cop_lat":"enosh evol empaireeti engo emmos:","en":"“You are the Christ,","ar":"صارخين هكذا قائلين:"}},{"id":"t2642-10","text":{"cop":"ⲛ̀ⲑⲟⲕ ⲡⲉ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ Ⲩⲓⲟⲥ Ⲑⲉⲟⲥ:","cop_lat":"enthok pe Pi-ekhristos I-ios Theos:","en":"the Son of God,","ar":"\"أنت المسيح إبن الله،"}},{"id":"t2642-11","text":{"cop":"ⲫⲏⲉⲧϯ ⲙ̀ⲡⲓⲱⲛϧ ⲛ̀ⲛⲏⲉⲑⲛⲁϩϯ ⲉ̀ⲡⲉⲕⲣⲁⲛ ⲉ̅ⲑ̅ⲩ̅.","cop_lat":"fee-etti empionkh ennee-ethnahti epekran ethowab.","en":"the Giver of Life to those who believe in His holy name.","ar":"مُعطي الحياة لمَنْ يؤمن بإسمك القدوس."}},{"id":"t2642-12","text":{"cop":"Ⲇⲟⲝⲁ Ⲡⲁⲧⲣⲓ ⲕⲉ Ⲩ̀ⲓⲱ ⲕⲉ Ⲁ̀ⲅⲓⲱ Ⲡ̀ⲛⲉⲩⲙⲁⲧⲓ.","cop_lat":"Thoksa Patri ke I-io ke Agio Epnevmati.","en":"Glory be to the Father and the Son and the Holy Spirit.","ar":"المجد الآب والإبن والروح القدس."}},{"id":"t2642-13","text":{"cop":"Ⲉⲑⲃⲉ ⲛⲉⲕⲙⲉⲧϣⲉⲛϩⲏⲧ:","cop_lat":"Ethve nekmetshenheet:","en":"For the sake","ar":"لأجل رأفتك"}},{"id":"t2642-14","text":{"cop":"Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅ Ⲡⲉⲛⲥⲱⲧⲏⲣ ⲙⲁⲧⲟⲩⲛⲟⲥⲧⲉⲛ ϧⲉⲛ ⲧⲉⲕϫⲟⲙ:","cop_lat":"Ieesous Pi-ekhristos Pensoteer matounosten khen tekgom:","en":"of Your compassions, O Jesus Christ our Savior,","ar":"يا يسوع المسيح مخلصنا أقمنا بقوتك"}},{"id":"t2642-15","text":{"cop":"ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲫ̀ⲙⲟⲩ ⲛ̀ⲧⲉ ⲫ̀ⲛⲟⲃⲓ:","cop_lat":"evol khen efmou ente efnovi:","en":"raise us","ar":"من موت الخطية،"}},{"id":"t2642-16","text":{"cop":"ⲙ̀ⲫ̀ⲣⲏϯ ⲉ̀ⲧⲁⲕⲧⲟⲩⲛⲟⲥ Ⲗⲁⲍⲁⲣⲟⲥ:","cop_lat":"emefreeti etaktounos Lazaros:","en":"with Your power from the death","ar":"كما أقمت لعازر من"}},{"id":"t2642-17","text":{"cop":"ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲡⲓⲙ̀ϩⲁⲩ:","cop_lat":"evol khen pi-emhav:","en":"of sin,","ar":"القبر بعد"}},{"id":"t2642-18","text":{"cop":"ⲙⲉⲛⲉⲛⲥⲁ ⲡⲓϥ̀ⲧⲟⲟⲩ ⲛ̀ⲉ̀ϩⲟⲟⲩ.","cop_lat":"menensa pi-eftoou enehoou.","en":"like You raised Lazarus from the tomb after four days.","ar":"أربعة أيام."}},{"id":"t2642-19","text":{"cop":"Ⲕⲉ ⲛⲩⲛ ⲕⲉ ⲁ̀ⲓ̀ ⲕⲉ ⲓⲥ ⲧⲟⲩⲥ ⲉ̀ⲱ̀ⲛⲁⲥ ⲧⲱⲛ ⲉ̀ⲱ̀ⲛⲱⲛ:","cop_lat":"Ke nin ke a-i ke is tous e-onas ton e-onon:","en":"Now and forever and unto the age of all ages.","ar":"الآن وكل أوان وإلى دهر الدهور،"}},{"id":"t2642-20","text":{"cop":"ⲁ̀ⲙⲏⲛ.","cop_lat":"ameen.","en":"Amen.","ar":"آمين."}},{"id":"t2642-21","text":{"cop":"Ⲱ̀ⲗⲓ ⲉ̀ⲃⲟⲗ ϩⲁⲣⲟⲛ ⲙ̀ⲡⲓϩⲩⲛⲓⲙ ⲛ̀ⲧⲉ ϯⲉⲃϣⲓ ⲛ̀ⲣⲉϥⲧⲁⲕⲟ:","cop_lat":"Oli evol haron empihinim ente tievshi enreftako:","en":"Take away from us the destructive slumber of sleep,","ar":"أبعِد عنا نوم الغفلة المُهلكة،"}},{"id":"t2642-22","text":{"cop":"ⲙ̀ⲡⲉⲣⲭⲁⲛ ⲛ̀ⲥⲱⲕ Ⲡ̀ϭⲟⲓⲥ:","cop_lat":"emperkhan ensok Epshois:","en":"do not forsake us O Lord","ar":"لا تتركنا عنك يا رب،"}},{"id":"t2642-23","text":{"cop":"ϫⲉ ⲁ̀ⲛⲟⲛ ⲛⲓϩ̀ⲃⲏⲟⲩⲓ̀ ⲛ̀ⲧⲉ ⲛⲉⲕϫⲓϫ:","cop_lat":"je anon ni-ehveeoui ente nekjig:","en":"for we are the work of Your hands;","ar":"لأجل أننا أعمال يديك،"}},{"id":"t2642-24","text":{"cop":"ⲁ̀ⲛⲟⲛ ⲛⲓⲡⲓⲥⲧⲟⲥ ϧⲉⲛ ⲧⲉⲕⲙⲉⲑⲛⲟⲩϯ:","cop_lat":"anon nipistos khen tekmethnoti:","en":"we believe in Your divinity,","ar":"نحن نؤمن بلاهوتك،"}},{"id":"t2642-25","text":{"cop":"Ⲡⲓⲣⲉϥⲧⲁⲛϧⲟ ⲫⲏⲉ̀ⲧⲁϥⲱⲛϧ:","cop_lat":"Pireftankho fee-etafonkh:","en":"O Giver of Life,","ar":"أيها المحيي،"}},{"id":"t2642-26","text":{"cop":"Ⲗⲁⲍⲁⲣⲟⲥ ⲫⲏⲉ̀ⲧⲁϥⲙⲟⲩ.","cop_lat":"Lazaros fee-etafmou.","en":"who gave life to the mortal Lazarus.","ar":"واهب الحياة للعازر المائت."}},{"id":"t2642-27","text":{"cop":"Ⲕⲉ ⲛⲩⲛ ⲕⲉ ⲁ̀ⲓ̀ ...","cop_lat":"Ke nin ke a-i ...","en":"Now and forever ….","ar":"الآن وكل أوان ..."}},{"id":"t2642-28","text":{"cop":"Ⲣⲱⲟⲛ Ⲡⲉⲛϭⲟⲓⲥ Ⲓⲏ̅ⲥ̅ Ⲡⲭ̅ⲥ̅:","cop_lat":"Ro-on Penshois Ieesous Pi-ekhristos:","en":"We say,","ar":"نقول"}},{"id":"t2642-29","text":{"cop":"ⲛ̀ⲑⲟⲕ ⲡⲉ ϯⲁ̀ⲛⲁⲥⲧⲁⲥⲓⲥ:","cop_lat":"enthok pe ti-anastasis:","en":"O our Lord Jesus Christ,","ar":"يا ربنا يسوع المسيح،"}},{"id":"t2642-30","text":{"cop":"ⲛⲉⲙ ⲡⲓⲱⲛϧ ⲕⲁⲧⲁ ⲡⲉⲕⲥⲁϫⲓ:","cop_lat":"nem pionkh kata peksaji:","en":"You are the resurrection and the life as You have said to Martha,","ar":"أنت هو القيامة"}},{"id":"t2642-31","text":{"cop":"ⲉ̀Ⲙⲁⲣⲑⲁ ⲧ̀ⲥⲱⲛⲓ ⲛ̀Ⲗⲁⲍⲁⲣⲟⲥ:","cop_lat":"emartha etsoni enlazaros:","en":"Lazarus’s sister,","ar":"والحياة كقولك لمرثا أخت لعازر،"}},{"id":"t2642-32","text":{"cop":"ⲟⲩⲟϩ ⲁⲕϫⲱⲕ ⲉ̀ⲃⲟⲗ ⲙ̀ⲡⲓⲥⲁϫⲓ ⲛⲉⲙ ⲡ̀ϩⲱⲃ:","cop_lat":"o-woh akgok evol empisaji nem ephob:","en":"and You have fulfilled the word with Your action,","ar":"وأكملتَ القول بالعمل،"}},{"id":"t2642-33","text":{"cop":"ⲉⲕⲱϣ ⲉ̀ⲃⲟⲗ ϧⲉⲛ ⲟⲩⲛⲓϣϯ ⲛ̀ⲥ̀ⲙⲏ:","cop_lat":"ekosh evol khen ounishti enesmee:","en":"proclaiming with a loud voice saying,","ar":"صرخت بصوتٍ عظيم قائلاً"}},{"id":"t2642-34","text":{"cop":"ϫⲉ Ⲗⲁⲍⲁⲣⲟⲥ ⲁ̀ⲙⲟⲩ ⲉ̀ⲃⲟⲗ.","cop_lat":"je Lazaros amou evol.","en":"“Lazarus come forth.”","ar":"\"لعازر هلم خارجاً.\""}},{"id":"t2642-35","text":{"cop":"Ⲕⲉ ⲛⲩⲛ ⲕⲉ ⲁ̀ⲓ̀ ...","cop_lat":"Ke nin ke a-i ...","en":"Now and forever ….","ar":"الآن وكل أوان ..."}},{"id":"t2642-36","text":{"cop":"Ⲅⲉ ⲅⲁⲣ ⲛ̀ⲑⲟⲕ ⲁ̀ⲗⲏⲑⲟⲥ:","cop_lat":"Ge ghar enthok aleethos:","en":"For You are truly the Creator","ar":"لأنك بالحقيقة"}},{"id":"t2642-37","text":{"cop":"Ⲡⲓⲣⲉϥⲑⲁⲙⲓⲟ ⲛ̀ⲧⲉ ⲛⲓⲫⲩⲥⲓⲥ:","cop_lat":"Pirefthamio ente nifisis:","en":"of nature.","ar":"خالق الطبيعة،"}},{"id":"t2642-38","text":{"cop":"ϣⲁⲛⲁϩ̀ⲑⲏⲕ ⲇⲉ ⲉ̀ϩ̀ⲣⲏⲓ ⲉ̀ϫⲱⲛ:","cop_lat":"shana-ehtheek the e-ehree egon:","en":"Be kind to us with Your mercy","ar":"تحنن علينا برحمتك،"}},{"id":"t2642-39","text":{"cop":"ϧⲉⲛ ⲡⲉⲕⲛⲁⲓ ⲁ̀ⲣⲓⲟⲩⲓ̀ ⲛ̀ⲛⲉⲛⲙⲉⲣⲟⲥ:","cop_lat":"khen peknai arioui ennenmeros:","en":"and grant us a share","ar":"وأعطنا نصيباً مع"}},{"id":"t2642-40","text":{"cop":"ⲛⲉⲙ Ⲗⲁⲍⲁⲣⲟⲥ ⲡⲉⲕⲙⲉⲛⲣⲓⲧ:","cop_lat":"nem Lazaros pekmenrit:","en":"with Lazarus Your beloved,","ar":"لعازر حبيبك،"}},{"id":"t2642-41","text":{"cop":"ⲡⲓⲁ̀ⲇⲓⲕⲉⲟⲥ ⲉⲧⲥ̀ⲙⲁⲣⲱⲟⲩⲧ:","cop_lat":"pi-athikeos etesmaroout:","en":"the blessed and righteous one,","ar":"الصديق المبارك،"}},{"id":"t2642-42","text":{"cop":"ϧⲉⲛ ⲧ̀ⲭⲱⲣⲁ ⲛ̀ⲧⲉ ⲛⲏⲉⲧⲟⲛϧ.","cop_lat":"khen etkhora ente nee-etonkh.","en":"in the region of the living.","ar":"في كورة الأحياء."}},{"id":"t2642-43","text":{"cop":"Ⲕⲉ ⲛⲩⲛ ⲕⲉ ⲁ̀ⲓ̀ ...","cop_lat":"Ke nin ke a-i ...","en":"Now and forever ….","ar":"الآن وكل أوان ..."}},{"id":"t2642-44","text":{"cop":"Ⲓⲏⲥⲟⲩⲥ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ Ⲡⲓⲣⲉϥⲛⲟϩⲉⲙ:","cop_lat":"Ieesous Pi-ekhristos Pirefnohem:","en":"O Jesus Christ, the Savior,","ar":"يا يسوع المسيح المخلص،"}},{"id":"t2642-45","text":{"cop":"ⲛ̀ⲑⲟⲕ ⲁⲕϫⲱ ϧⲉⲛ ⲡⲉⲕⲛⲁⲓ ϫⲉ ⲫⲏⲉⲑⲛⲁϩϯ ⲉ̀ⲣⲟⲕ:","cop_lat":"enthok akgo khen peknai je fee-ethnahti erok:","en":"You speak with Your mercy to those who believe in You,","ar":"أنت تنشد برحمتك للذين يؤمنون بك،"}},{"id":"t2642-46","text":{"cop":"ⲛ̀ⲧⲉϥϭⲓⲛ̀ⲟⲩⲱⲛϧ ⲛ̀ⲉ̀ⲛⲉϩ:","cop_lat":"entefchi-enowonkh eneneh:","en":"that they may be granted eternal life.","ar":"أن ينالوا حياة أبدية."}},{"id":"t2642-47","text":{"cop":"ⲏⲡⲡⲉ ⲁ̀ⲛⲟⲛ ⲡⲉⲕⲗⲁⲟⲥ:","cop_lat":"eeppe anon peklaos:","en":"We, Your people,","ar":"ها نحن شعبك"}},{"id":"t2642-48","text":{"cop":"ⲉ̀ⲧⲉⲣⲟ̀ⲙⲟⲗⲟⲅⲓⲛ ϧⲉⲛ ⲧⲉⲕⲙⲉⲧϭⲟⲓⲥ:","cop_lat":"eteromologin khen tekmetshois:","en":"confess Your lordship.","ar":"نعترف بربوبيتك،"}},{"id":"t2642-49","text":{"cop":"ⲛⲁⲛ ⲛⲁⲛ ⲕⲁⲧⲁ ⲡⲉⲕⲛⲓϣϯ ⲛ̀ⲛⲁⲓ.","cop_lat":"nan nan kata peknishti ennai.","en":"Have mercy upon us according to Your great mercy.","ar":"إرحمنا كعظيم رحمتك."}},{"id":"t2642-50","text":{"cop":"Ⲉⲛⲱϣ ⲉ̀ⲃⲟⲗ ⲉⲛϫⲱ ⲙ̀ⲙⲟⲥ:","cop_lat":"Enosh evol engo emmos:","en":"We proclaim saying:","ar":"نصرخ قائلين:"}},{"id":"t2642-51","text":{"cop":"ϫⲉ ⲱ̀ Ⲡⲉⲛϭⲟⲓⲥ Ⲓⲏⲥⲟⲩⲥ Ⲡⲓⲭ̀ⲣⲓⲥⲧⲟⲥ:","cop_lat":"je o Penshois Ieesous Pi-ekhristos:","en":"“O our Lord Jesus Christ,","ar":"\"يا ربنا يسوع المسيح،"}},{"id":"t2642-52","text":{"cop":"ⲥ̀ⲙⲟⲩ ⲛⲓⲁ̀ⲏⲣ ⲛ̀ⲧⲉ ⲧ̀ⲫⲉ ⲛⲉⲙ ⲛⲓⲙⲱⲟⲩ ⲙ̀ⲫ̀ⲓⲁⲣⲟ ⲛⲉⲙ ⲉ̀ⲛⲓⲥⲓϯ ⲛⲉⲙ ⲛⲓⲥⲓⲙ.","cop_lat":"esmou ni-aeer ente etfe nem nimoou emefiaro nem enisiti nem nisim.","en":"bless the air of heaven, the waters of the river, and the seeds and the herbs.","ar":"بارك أهوية السماء، مياه النهر والزروع والعشب."}},{"id":"t2642-53","text":{"cop":"Ⲙⲁⲣⲉ ⲡⲉⲕⲛⲁⲓ ⲛⲉⲙ ⲧⲉⲕϩⲓⲣⲏⲛⲏ ⲟⲓ ⲛ̀ⲥⲟⲃⲧ ⲙ̀ⲡⲉⲕⲗⲁⲟⲥ.","cop_lat":"Mare peknai nem tekhireenee oi ensovt empeklaos.","en":"May Your mercy and Your peace be a fortress to Your people.”","ar":"ولتكن رحمتك وسلامك حصناً لشعبك.\""}},{"id":"t2642-54","text":{"cop":"Ⲥⲱϯ ⲙ̀ⲙⲟⲛ ...","cop_lat":"Soti emmon ...","en":"Save us ....","ar":"خلصنا..."}}]}